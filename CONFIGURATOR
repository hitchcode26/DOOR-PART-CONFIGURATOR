/**
 * Door Number Builder Suitelet — GEN-Y DOOR
 * File: GNY_DoorNumberBuilder_Suitelet.js
 * Script Type: Suitelet
 * API Version: 2.1
 *
 * Sibling of GNY_PartNumberBuilder_Suitelet.js (GEN-Y HITCH). Same shell —
 * NetSuite chrome, one INLINEHTML field, everything scoped under #gny-dnb,
 * one part-number field that doubles as the search box, rollback on failure,
 * recent-activity rail. The BUILD is what differs, and it differs a lot.
 *
 * WHAT A DOOR IS IN THIS ACCOUNT
 *   A door is not one item. It is a FAMILY of items sharing one 7-digit
 *   sequence number, all sitting at location 48 (GEN-Y DOOR):
 *
 *     DR-{series}-{number}   the finished door.  Sellable.  NO ROUTING.
 *     F-{series}-{number}    FRAME.        BOM + revision + routing.
 *     C-{series}-{number}    CORE.         BOM + revision + routing.
 *     S-{series}-{number}    SCREEN DOOR.  BOM + revision + routing. Optional.
 *
 *   The DR BOM consumes F, C and (when present) S, plus any loose hardware
 *   that isn't part of a sub-assembly. Verified against 1,149 live families;
 *   only 101 of 3,183 doors carry a screen, which is why it's a checkbox
 *   rather than always-on.
 *
 *   So ONE submit here creates up to 15 records: 4 items, 4 BOMs,
 *   4 revisions, 3 routings. If any of them fails, all of them are rolled
 *   back — a half-built door family is worse than no door family.
 *
 * DESCRIPTION CASCADE
 *   You type the description ONCE, on the door. The sub-assemblies derive:
 *     DR  ->  "4500 ENT SQ SD LH WB 36 x 74 ML 950 ..."
 *     C   ->  "CORE " + that
 *     F   ->  "FRAME " + that
 *     S   ->  "SCREEN DOOR " + that
 *   1,023 of 1,149 live families match that rule exactly; the other 126 are
 *   hand-typing drift (PSWHT vs PS WH and similar), not a different rule.
 *   The description also opens with the series number on 3,126 of 3,182
 *   doors, so the series you pick is prepended for you — see SERIES_IN_DESC.
 *
 * NUMBERING
 *   The sequence is GLOBAL, not per series. DR-4500-1002211 and
 *   DR-6000-1002207 come off the same counter. The next number is looked up
 *   live on page load and on every reset, so two people building at once see
 *   different numbers as soon as the first one saves. It stays editable —
 *   the lookup is a suggestion, and the duplicate check is what actually
 *   protects you.
 *
 * ROUTING — COST TEMPLATE DEPENDS ON THE FAMILY, NOT THE OPERATION
 *   This is the one thing a straight copy of the hitch builder gets wrong.
 *   EXT CUT is a real operation on both frames and cores, but it costs
 *   differently:
 *     FRAME / SCREEN   EXT CUT -> DR Frame Cutting     (1,233 live steps)
 *     CORE             EXT CUT -> DR Core Framing      (1,124 live steps)
 *   Same story for EXT BEND (DR Frame Bending vs DR Core Framing). So the
 *   operation catalog is keyed by family, and each grid only offers the
 *   operations that family actually runs.
 *
 *   Defaults, taken from what the shop actually does:
 *     FRAME   1 EXT CUT, 2 EXT WELD           (716 of 1,132; bend is the rest)
 *     CORE    1 EXT CUT, 2 LAMINATION, 3 ROUTING   (691; +bend variant is 439)
 *     SCREEN  1 EXT CUT                       (68 of 101; 33 add a bend)
 *   Run rate 5, setup 0 on every single door routing step in the account —
 *   6,307 of them, no exceptions. Both fields stay editable anyway.
 *
 *   NOTE the cost template "DR  Core Lamination" carries a DOUBLE SPACE in
 *   its name. Name matching collapses whitespace, or that step silently
 *   saves with no cost template.
 *
 * TEMPLATES — THE WHOLE BUILD, NOT JUST THE ITEM FIELDS
 *   A template is a complete door family that happens to be named TEMPLATE:
 *     DR-4000-TEMPLATE (30411)  BOM 11560, 6 lines (F, C, + 4 loose trims)
 *     F-4000-TEMPLATE  (30412)  BOM 11558, 3 lines, routing EXT CUT / EXT WELD
 *     C-4000-TEMPLATE  (30413)  BOM 11559, 6 lines, routing EXT CUT / LAMINATION / ROUTING
 *
 *   Picking one fills the ENTIRE form: item field inheritance as before, but
 *   also every component line with its quantity and item source, and every
 *   routing step with its work center, cost template, run rate and setup. The
 *   usual job then becomes adjusting quantities to the new door's size —
 *   which is the point. Rows stay fully editable and you can add or delete
 *   any of them.
 *
 *   TEMPLATES ARE DISCOVERED, NOT HARD-CODED. Anything matching
 *   CFG.TEMPLATE_DOOR_PATTERN ('DR-%TEMPLATE%') shows up in the picker at the
 *   top of the form, and its C-/F-/S- siblings are found by swapping the
 *   prefix. Reload with ?refresh=1 if you built one in the last hour and
 *   don't want to wait out the cache.
 *
 *   EDITING A TEMPLATE IN NETSUITE IS PICKED UP ON THE NEXT PAGE LOAD.
 *   The template fill payload and the item-field snapshot are cached for 30
 *   minutes, so for a long time the honest answer to "I changed the template
 *   and the tool didn't notice" was "reload with ?refresh=1". It no longer
 *   is. Both caches are now keyed by a freshness stamp read off the live
 *   records — see templateStamp() — so any edit to a template's items, BOM
 *   revisions, components or routing steps changes the key and the next load
 *   misses the cache and re-reads. Costs one extra query per template load.
 *   "Re-fill from template" goes further and bypasses every cache, client and
 *   server, which is the override when you don't trust the stamp.
 *
 *   AND YOU CAN MAKE THEM FROM HERE. "+ New template" builds a template
 *   family out of whatever is currently on the form — same four records per
 *   family as a real door, just named DR-{series}-TEMPLATE instead of
 *   DR-{series}-{number}. Two ways that gets used:
 *     - Set the grids up the way you want and save it as a template.
 *     - Load a door that came out well and save THAT as a template.
 *   Add a tag when a series needs more than one: DR-4500-ENT-TEMPLATE and
 *   DR-4500-BAG-TEMPLATE both live under series 4500 and both show up in the
 *   picker. The new template is selected the moment it saves.
 *
 *   Templates are ordinary door families, so they load into edit mode like
 *   anything else — type DR-4000-TEMPLATE in the number box to adjust one.
 *   They are excluded from the next-door-number counter (that only counts
 *   numeric tails), so making one never burns a door number.
 *
 *   A template need not have all four families. DR-4000-TEMPLATE has no
 *   screen, so ticking "include screen door" on it falls back to the built-in
 *   catalog default (one EXT CUT step, blank components). Save one with the
 *   screen box ticked and that stops being a fallback.
 *
 *   To change what new doors default to, edit the template family in
 *   NetSuite, not this script.
 *
 * COPYING A DOOR — A RUN OF SIZES, OR BOTH SIDES OF THE RV
 *   Doors come in sets. One RV takes ten of them at ten sizes, colour and
 *   latch identical; or a left hand and a right hand of the same door for the
 *   two sides. Building each from a template means re-picking every component
 *   ten times to change one token in the description.
 *
 *   So: load a door, press "Copy to new door". The grids stay exactly as that
 *   door has them, the number box takes the next free number, and the cursor
 *   lands in the description selected. Change 32 X 78 to 30 X 78, or RH to LH,
 *   and create. The form comes straight back with the SAME setup and the next
 *   free number, so the second one is another two edits, and the tenth is too.
 *
 *   Two things separate a copy from a build off a template:
 *     - Item fields are inherited from the SOURCE DOOR, not from a template.
 *       A sibling built for the same RV is a far closer starting point than a
 *       generic series template, which is the whole reason to copy.
 *     - The reset after each create restores the copied door rather than the
 *       picker's template, and each create updates the baseline description to
 *       the one just used — so a climbing run of sizes is one edit per door.
 *
 *   A copy run ends when you pick a template, re-fill from one, or load
 *   another door. Nothing else ends it.
 *
 *   The copy is a full build: four items, four BOMs, four revisions, three
 *   routings, same rollback. Nothing on the source door is touched, and the
 *   copy's own frame and core are re-derived from its new number rather than
 *   pointing at the source's.
 *
 * WHAT IS DELIBERATELY NOT HERE
 *   No weight, no shipping dimensions, no Order Tracking Sorter, no coated
 *   finish split — none of them are populated on any door item. Component
 *   yield is off on all 3,556 door BOMs. Use Bins is off. Doors carry
 *   custitemcut_details instead, a free-text cut list present on 2,451 of
 *   3,183 doors, which has no hitch equivalent and gets its own box.
 *
 * DEPLOY
 *   1. Upload to File Cabinet (e.g. SuiteScripts/)
 *   2. Script record -> type: Suitelet -> point to this file
 *   3. Deployment -> Status: Released, Audience: as appropriate
 *      (needs create permission on Item, BOM, BOM Revision, Mfg Routing)
 *   4. Load the page — the banner confirms the field counts read off each
 *      template and the next free door number. Reload with ?refresh=1 to
 *      drop cached dropdown data without waiting out the TTL.
 */

/**
 * @NApiVersion 2.1
 * @NScriptType Suitelet
 * @NModuleScope SameAccount
 */
define(['N/ui/serverWidget', 'N/query', 'N/search', 'N/record', 'N/log', 'N/format', 'N/cache'],
(serverWidget, query, search, record, log, format, nsCache) => {

  // ─── CONFIG ───────────────────────────────────────────────────────────────
  const CFG = {
    // ── Templates ──────────────────────────────────────────────────────
    // Templates are FOUND, not listed here. Any active assembly whose name
    // matches this pattern becomes an option in the picker, and its C-/F-/S-
    // siblings are located by swapping the DR- prefix. Build
    // DR-6000-TEMPLATE and it shows up on the next page load; no script
    // change needed. SQL LIKE syntax: % is the wildcard.
    TEMPLATE_DOOR_PATTERN: 'DR-%TEMPLATE%',

    // Selected when the page opens.
    //   ''            open on "— none —" with blank grids  (needs ALLOW_NO_TEMPLATE)
    //   '*'           whichever template sorts first
    //   'DR-6000-…'   that one by name
    // Blank is the default because opening pre-filled with one series' parts
    // is misleading when most doors are not that series — the grids look
    // authoritative and are not. Pick a template and it fills in one click.
    DEFAULT_TEMPLATE: '',

    // Whether the picker offers a "— none —" option at all. With it, you get
    // blank grids and the built-in catalog defaults instead of a template.
    ALLOW_NO_TEMPLATE: true,

    // ── Creating templates from the form ───────────────────────────────
    // "+ New template" builds a template family out of whatever is on screen.
    // Turn off if templates should only ever be built by hand in NetSuite.
    ALLOW_TEMPLATE_CREATION: true,

    // The word that makes a door family a template. Must be consistent with
    // TEMPLATE_DOOR_PATTERN above, or a template this tool creates won't be
    // discoverable by the tool that created it.
    TEMPLATE_SUFFIX: 'TEMPLATE',

    // Optional middle tag, for when one series needs more than one template
    // (DR-4500-ENT-TEMPLATE alongside DR-4500-BAG-TEMPLATE). Letters, digits
    // and dashes only — it becomes part of an item name.
    TEMPLATE_TAG_PATTERN: /^[A-Z0-9][A-Z0-9-]*$/,
    TEMPLATE_TAG_MAX: 20,

    // A template's description is a real door description with a marker on
    // the front ("TEMPLATE - 4000 ENT SQ SD RH WB 32 X 78 ML 805 ..."). Seeded
    // into the description box with the marker stripped, so the job is editing
    // the size and options rather than typing forty tokens from scratch. Only
    // ever fills an EMPTY box — it can't overwrite what you typed.
    SEED_DESCRIPTION_FROM_TEMPLATE: true,
    TEMPLATE_DESC_MARKER: /^\s*TEMPLATE\s*[-:]?\s*/i,

    // Same deal for the cut list, if the template carries one.
    SEED_CUT_DETAILS_FROM_TEMPLATE: true,

    // Used only when the picker is on "— none —", so item field inheritance
    // still has something to work from.
    FALLBACK_TEMPLATE_ITEMS: {
      DR: '30411',   // DR-4000-TEMPLATE
      F:  '30412',   // F-4000-TEMPLATE
      C:  '30413',   // C-4000-TEMPLATE
      S:  '30412'    // no S template exists yet; frame is the right stand-in
    },

    // GEN-Y DOOR. Written to both `location` and `preferredlocation` — every
    // one of the 5,588 live door items carries both, and it is the only
    // reliable "this is a door part" marker in the data (the DR-/C-/F-/S-
    // prefixes are convention, the location is a field).
    LOCATION_ID: '48',
    LOCATION_NAME: 'GEN-Y DOOR',
    SET_PREFERRED_LOCATION: true,

    // Falls back to this only if the template items don't supply it.
    SUBSIDIARY_ID: '2',        // GENY GROUP : GEN-Y HITCH

    // Screens are 101 of 3,183 doors — off by default, checkbox on the form.
    INCLUDE_SCREEN_DEFAULT: false,

    // ── Tube frame ─────────────────────────────────────────────────────
    // A welded tube sub-assembly that stiffens the CORE. 61 of them exist in
    // the account and every one was hung off the DOOR's own BOM, which put a
    // core part one level too high — the door consumed it directly instead of
    // the core it actually belongs to. New ones go on the core.
    //
    // Unlike the frame, core and screen, a tube frame's number does NOT come
    // off the door number. Engineering assigns it before the door is set up in
    // NetSuite, so it is TYPED IN rather than derived. That is also why it
    // carries no family prefix — a plain number, the convention all 61 follow
    // (1001253, 1001983, 1002120).
    INCLUDE_TUBE_DEFAULT: false,
    TUBE_NUMBER_PATTERN: /^[A-Z0-9][A-Z0-9-]*$/,
    TUBE_NUMBER_MAX: 20,

    // The tube's line on the CORE's BOM. Work order matches how the door
    // consumes its own sub-assemblies: it is what makes the tube actually get
    // built rather than expected to be sitting in stock.
    TUBE_QTY: 1,
    TUBE_SOURCE: 'WORK_ORDER',

    // Engineering sometimes creates the tube record ahead of the door. If the
    // typed number already exists, link it onto the core instead of failing —
    // and do NOT touch it, because it is somebody else's record.
    TUBE_LINK_IF_EXISTS: true,

    // How a tube frame is recognised on a core's BOM when a door is loaded for
    // editing: an assembly component whose name is a plain number. Frames,
    // cores and screens all carry a prefix, and raw stock is 5-digit 99xxx, so
    // a 6-or-more-digit bare number on a core is a tube and nothing else.
    TUBE_ON_CORE_PATTERN: /^[0-9]{6,}$/,

    // Item source for the F / C / S lines on the DOOR's own BOM.
    // The data is split: 3,560 lines are WORK_ORDER (the long-standing
    // convention) and 2,415 are STOCK (a March 2026 batch). WORK_ORDER is the
    // default here because it's the majority and because it's what makes the
    // sub-assembly actually get built. Every row's dropdown stays editable.
    DR_SUBASSEMBLY_SOURCE: 'WORK_ORDER',

    // Order the sub-assemblies land on the door's BOM. Matches the most
    // recent live batch (S, F, C). Loose hardware follows underneath.
    DR_COMPONENT_ORDER: ['S', 'F', 'C'],

    // Door BOMs are ALWAYS scoped to their one assembly — all 3,556 of them
    // have availableforallassemblies = F. This is the opposite of the hitch
    // builder's default and costs an extra load+save per BOM, but matching
    // the account's convention is worth more than the second or two.
    RESTRICT_BOM_TO_ASSEMBLY: true,
    BOM_RESTRICT_SUBLISTS: ['restricttoassemblies', 'assembly', 'bomassembly'],

    // Clear the form after a successful build so the next door can be typed
    // straight away. The next number is re-fetched as part of the reset.
    AUTO_RESET: true,

    RECENT_LIMIT: 15,

    // Revision effective date offset from today, in days. -1 = yesterday.
    // Also drives "New BOM Rev" dating in edit mode.
    EFFECTIVE_DATE_OFFSET_DAYS: -1,

    // ── Performance ────────────────────────────────────────────────────
    // BUMP CACHE_NAME WHENEVER A LIST QUERY CHANGES. The cache is PUBLIC
    // scope with an hour TTL, so a corrected query keeps serving the OLD
    // result until the TTL expires.
    USE_CACHE: true,
    CACHE_NAME: 'gny_dnb_v1',
    CACHE_TTL_LISTS: 3600,
    CACHE_TTL_TEMPLATE: 1800,

    CACHE_KEYS: ['workcenters', 'costtemplates', 'classes', 'templates'],

    // Template caches are keyed by a freshness stamp read off the live
    // records. Edit a template in NetSuite and the stamp moves, so the next
    // page load misses the cache and re-reads it instead of serving up to
    // CACHE_TTL_TEMPLATE seconds of stale components and routing. Costs one
    // extra query per template load. Set false to go back to plain TTL
    // caching, where ?refresh=1 is the only way to pick up an outside edit.
    STAMP_TEMPLATE_CACHE: true,

    // Sourcing re-derives dependent fields on save. Every field a new door
    // needs is copied explicitly off its template, so sourcing mostly redoes
    // finished work — and this tool saves up to 15 records per submit, so the
    // saving compounds. If a new door comes out missing a field that isn't on
    // the template, set this back to true.
    ENABLE_SOURCING: false,

    LOG_TIMINGS: true,

    SEARCH_MIN_CHARS: 3,
    SEARCH_ROWS: 15,

    // Doors are built almost entirely from 99xxx raw stock. Restricting the
    // component search to inventory + assembly keeps service items and
    // non-inventory charges out of the dropdown.
    SEARCH_ITEM_TYPES: ['InvtPart', 'Assembly', 'NonInvtPart', 'Kit'],

    // ── Door identity ──────────────────────────────────────────────────
    // T has no prefix on purpose — a tube frame is named by its bare number.
    FAMILY_PREFIX: { DR: 'DR-', F: 'F-', C: 'C-', S: 'S-', T: '' },

    // Prepended to the typed description for each sub-assembly. DR takes the
    // description raw.
    DESC_PREFIX: { DR: '', F: 'FRAME ', C: 'CORE ', S: 'SCREEN DOOR ', T: 'TUBE ' },

    // DR revisions are named "... BOM REV-A" (1,151 live), C/F/S are named
    // "... BOM REV A" (2,404 live). Not a typo on either side — they were
    // created by different processes and both are still in use.
    REV_NAME_SEP: { DR: ' BOM REV-', F: ' BOM REV ', C: ' BOM REV ', S: ' BOM REV ', T: ' BOM REV ' },

    // The door itself has no routing. Zero of 3,183 DR items have one — the
    // work happens on the frame and the core, and the door is the marriage.
    BUILDS_ROUTING: { DR: false, F: true, C: true, S: true, T: true },

    // Door numbers are 7 digits and currently run 10xxxxx. Zero-padded to
    // this width when the next number is suggested.
    NUMBER_WIDTH: 7,

    // The description opens with the series number on 3,126 of 3,182 doors.
    // Turn off if you'd rather type it yourself.
    SERIES_IN_DESC: true,

    // Door-only free-text cut list — Outer W/H, Inner W/H, Panel W/H,
    // Screen W/H, H-Bar. Lives on the DR item only (2,451 of 3,183 carry it;
    // 6 of 5,588 sub-assemblies do, which is drift, not a convention).
    CUT_DETAILS_FIELD: 'custitemcut_details',

    // Door line / product line. A List/Record field (CUSTOMLIST_DOOR_LINE),
    // not free text — every live value is one of the 5 rows below. Populated
    // on only 209 doors, so it is offered but never required.
    DOOR_LINE_FIELD: 'custitem_door_line',

    // Read straight from customlist_door_line. Bump this by hand if a value
    // is added or renamed in NetSuite — it isn't queried live, to avoid a
    // round trip on every page load for a 5-row list that rarely changes.
    DOOR_LINE_VALUES: [
      { id: '1', name: 'Radius Bag' },
      { id: '2', name: 'Square Bag' },
      { id: '3', name: 'Square Entry' },
      { id: '4', name: 'Specialty' },
      { id: '5', name: 'Radius Entry' }
    ],

    // Door-only Purchase Price. Confirmed by field help on the item form
    // (right-click "Purchase Price" -> Field ID: cost) — the STANDARD field,
    // not the custitemadv_purchaseprice custom field this was pointed at
    // before. That mismatch was a real bug: 'cost' was never excluded from
    // template/copy inheritance, so every new or copied door silently
    // inherited the SOURCE door's old cost value the normal way template
    // fields do, while whatever was typed into the Purchase Price box wrote
    // to the unused custom field and never showed up anywhere. Same shape as
    // CUT_DETAILS_FIELD otherwise: entered once on the door, never on the
    // sub-assemblies, and now correctly excluded from inheritance below.
    PURCHASE_PRICE_FIELD: 'cost',

    // Auto-Issue on BOM revision components. The sublist field ID varies by
    // account; candidates are tried in order and the one that sticks is
    // reused for the remaining lines.
    AUTO_ISSUE_DEFAULT: true,
    AUTO_ISSUE_FIELDS: ['autoissuecomponent', 'isautoissue', 'autoissue', 'autoissuecomp'],

    // Components can be tied to a routing step by Operation Sequence Number.
    // Drop a step whose sequence a component still points at and NetSuite
    // refuses the save. Not exposed in SuiteQL, so it's resolved off the
    // record the same way AUTO_ISSUE_FIELDS is.
    COMPONENT_OPSEQ_FIELDS: [
      'operationsequencenumber', 'componentoperationsequencenumber',
      'opsequencenumber', 'operationsequence'
    ],

    // Where the description is written. Confirmed on live door items: all
    // four carry the same text. Excluded from template inheritance so the
    // template's own text can never ride along.
    DESCRIPTION_FIELDS: ['description', 'salesdescription', 'displayname', 'purchasedescription'],

    // Never copied from a template. Everything else is — including the
    // accounts, tax schedule, units, costing method and every custitem_*.
    SKIP_FIELDS: [
      'itemid', 'displayname', 'id', 'internalid', 'externalid', 'upccode',
      'recordtype', 'isinactive', 'subsidiary',
      'createddate', 'lastmodifieddate', 'lastquantityavailablechange',
      'quantityonhand', 'quantityavailable', 'quantitybackordered',
      'quantitycommitted', 'quantityonorder', 'quantityintransit',
      'onhandvaluemli', 'totalvalue', 'averagecost', 'lastpurchaseprice',
      'costestimate', 'reorderpoint', 'preferredstocklevel',
      'buildtime', 'totalquantityonhand',
      // Door-specific: the cut list, door line and purchase price belong to
      // ONE door, not to every door cloned off the template. 'cost' is the
      // real Purchase Price field (see PURCHASE_PRICE_FIELD above) — leaving
      // it off this list is exactly what let a source door's old price
      // silently ride onto every copy regardless of what was typed.
      'custitemcut_details', 'custitem_door_line', 'cost'
    ],

    // Door work centers are entity GROUPS with grouptype 'Employee' — the
    // same quirk the hitch builder documents. Only three of them exist.
    WORK_CENTER_NAME_PATTERNS: ['DOOR -%', 'DOOR-%'],
    WORK_CENTER_EXCLUDE: [],

    // Cost templates shown in the routing dropdowns. Everything else in the
    // account is hitch or aluminum and would only be noise.
    COST_TEMPLATE_PATTERNS: ['DR %', 'DR  %', 'DOOR %'],

    // Skip the prefilled fields when tabbing, so Tab runs
    // Series -> Number -> Description -> first component.
    SKIP_TAB_ON_PREFILLED: true,

    HIDE_NS_PAGE_TITLE: true
  };

  // Which families a build touches, in creation order. Sub-assemblies first —
  // the door's BOM needs their internal IDs.
  const BUILD_ORDER = ['T', 'F', 'C', 'S', 'DR'];

  // Families whose part number IS derived from the door's series and number.
  // Every name-building, clash-checking and door-loading path uses this list.
  const ALL_FAMILIES = ['DR', 'F', 'C', 'S'];

  // Every unit that gets a card, a grid and a build. The tube frame is here
  // but NOT in ALL_FAMILIES, because its number is typed rather than derived —
  // keeping the two lists apart is what stops the tube being fed into code
  // that would try to construct its name out of the door number.
  const ALL_UNITS = ['DR', 'F', 'C', 'S', 'T'];

  const FAMILY_LABEL = {
    DR: 'Door', F: 'Frame', C: 'Core', S: 'Screen door', T: 'Tube frame'
  };

  // Door series in use, with the item class each one maps to. Taken from the
  // 3,183 live doors: the dominant class per series, ignoring the handful of
  // miskeyed outliers (one 6000-series door filed under 4000 SERIES, etc).
  // Class is matched BY NAME at runtime so Sandbox and Production internal
  // IDs can differ without breaking anything.
  const SERIES = [
    { code: '1201', cls: '12010 SERIES' },
    { code: '1302', cls: '1302 SERIES CONCESSION' },
    { code: '1325', cls: '1325 SERIES CONCESSION' },
    { code: '1500', cls: '1500 SERIES' },
    { code: '1520', cls: '1500 SERIES' },
    { code: '1550', cls: '1500 SERIES' },
    { code: '1600', cls: '1600' },
    { code: '2000', cls: '2000 SERIES' },
    { code: '2050', cls: '2000 SERIES' },
    { code: '2500', cls: '2000 SERIES' },
    { code: '2800', cls: '2000 SERIES' },
    { code: '3000', cls: '3000 SERIES' },
    { code: '3010', cls: '3000 SERIES' },
    { code: '3500', cls: '3000 SERIES' },
    { code: '3750', cls: '3000 SERIES' },
    { code: '4000', cls: '4000 SERIES' },
    { code: '4010', cls: '4000 SERIES' },
    { code: '4050', cls: '4000 SERIES' },
    { code: '4100', cls: '4000 SERIES' },
    { code: '4250', cls: '4000 SERIES' },
    { code: '4500', cls: '4000 SERIES' },
    { code: '4750', cls: '4000 SERIES' },
    { code: '5000', cls: '4000 SERIES' },
    { code: '5250', cls: '4000 SERIES' },
    { code: '6000', cls: '6000 SERIES' },
    { code: '6010', cls: '6000 SERIES' },
    { code: '6050', cls: '6000 SERIES' },
    { code: '6250', cls: '6000 SERIES' },
    { code: '7050', cls: '7250 SERIES' },
    { code: '7250', cls: '7250 SERIES' },
    { code: '8050', cls: '8000 SERIES' },
    { code: '9500', cls: '9500 SERIES ENT' }
  ];

  // The shop's door operation catalog, keyed by family. Picking an operation
  // fills sequence, work center, cost template, run rate and setup. Work
  // centers and cost templates are matched by NAME so SB and PROD internal
  // IDs can differ.
  //
  // Read straight off 6,307 live routing steps. The cost template split
  // between frame and core is real and is the whole reason this is a map
  // rather than one flat list:
  //   EXT CUT on a frame  = DR Frame Cutting   (1,132 F + 101 S)
  //   EXT CUT on a core   = DR Core Framing    (1,124 C)
  //   EXT BEND on a frame = DR Frame Bending   (416 F + 33 S)
  //   EXT BEND on a core  = DR Core Framing    (430 C)
  // Run rate 5 / setup 0 appears on every one of those 6,307 steps.
  const OPERATIONS = {
    F: [
      { op: 'EXT CUT',  seq: 1, wc: 'Door - Core Framing', ct: 'DR Frame Cutting', run: 5, setup: 0 },
      { op: 'EXT WELD', seq: 2, wc: 'Door - Core Framing', ct: 'DR Frame Welding', run: 5, setup: 0 },
      { op: 'EXT BEND', seq: 2, wc: 'Door - Core Framing', ct: 'DR Frame Bending', run: 5, setup: 0 }
    ],
    C: [
      { op: 'EXT CUT',    seq: 1, wc: 'Door - Core Framing',    ct: 'DR Core Framing',    run: 5, setup: 0 },
      { op: 'EXT BEND',   seq: 2, wc: 'Door - Core Framing',    ct: 'DR Core Framing',    run: 5, setup: 0 },
      // Double space in "DR  Core Lamination" is how the record is actually
      // named. Name matching collapses whitespace, so this still resolves.
      { op: 'LAMINATION', seq: 2, wc: 'Door - Core Lamination', ct: 'DR  Core Lamination', run: 5, setup: 0 },
      { op: 'ROUTING',    seq: 3, wc: 'Door - Core Routing',    ct: 'DR Core Routing',    run: 5, setup: 0 },
      // 10 live cores weld instead of bending. Rare, but real.
      { op: 'EXT WELD',   seq: 2, wc: 'Door - Core Framing',    ct: 'DR Frame Welding',   run: 5, setup: 0 }
    ],
    S: [
      { op: 'EXT CUT',  seq: 1, wc: 'Door - Core Framing', ct: 'DR Frame Cutting', run: 5, setup: 0 },
      { op: 'EXT BEND', seq: 2, wc: 'Door - Core Framing', ct: 'DR Frame Bending', run: 5, setup: 0 },
      { op: 'EXT WELD', seq: 2, wc: 'Door - Core Framing', ct: 'DR Frame Welding', run: 5, setup: 0 }
    ],
    // Every one of the 61 live tube routings is the same two steps with the
    // same templates the FRAME uses — EXT CUT on DR Frame Cutting, EXT WELD on
    // DR Frame Welding, both at Door - Core Framing, run 5 / setup 0. A tube
    // frame is welded extrusion, so it costs like a frame even though it is
    // consumed by the core. Bend is offered for the same reason it is on F.
    T: [
      { op: 'EXT CUT',  seq: 1, wc: 'Door - Core Framing', ct: 'DR Frame Cutting', run: 5, setup: 0 },
      { op: 'EXT WELD', seq: 2, wc: 'Door - Core Framing', ct: 'DR Frame Welding', run: 5, setup: 0 },
      { op: 'EXT BEND', seq: 2, wc: 'Door - Core Framing', ct: 'DR Frame Bending', run: 5, setup: 0 }
    ]
  };

  // Which steps a brand new family starts with. The most common live shape,
  // not a guess — rows are added and removed like any other.
  const DEFAULT_STEPS = {
    F: ['EXT CUT', 'EXT WELD'],
    C: ['EXT CUT', 'LAMINATION', 'ROUTING'],
    S: ['EXT CUT'],
    T: ['EXT CUT', 'EXT WELD']
  };

  // How many blank component rows each family opens with. Frames run about 3
  // lines, cores 6-11, screens 8-10, and the door itself usually adds no
  // loose hardware at all beyond the sub-assemblies.
  // Tubes run lean: the tube extrusion, and often a sheet of .125 aluminium.
  const DEFAULT_COMPONENT_ROWS = { DR: 1, F: 3, C: 6, S: 4, T: 2 };

  const WRAP = 'gny-dnb';
  const NS_ITEM = '/app/common/item/item.nl?id=';

  let _cacheCleared = false;

  const ITEM_SOURCES = [
    { v: 'STOCK',          l: 'Stock' },
    { v: 'WORK_ORDER',     l: 'Work Order' },
    { v: 'PHANTOM',        l: 'Phantom' },
    { v: 'PURCHASE_ORDER', l: 'Purchase Order' }
  ];

  // Item source is chosen from the component's own item type when it's picked.
  // Doors are built almost entirely from purchased stock; the only assemblies
  // that appear as components are the sub-assemblies this tool creates.
  const SOURCE_BY_ITEMTYPE = {
    'Assembly':     'WORK_ORDER',
    'InvtPart':     'STOCK',
    'NonInvtPart':  'STOCK',
    'Kit':          'STOCK',
    'Service':      'STOCK',
    'OthCharge':    'STOCK'
  };
  const SOURCE_FALLBACK = 'STOCK';

  // ─── ENTRY POINT ──────────────────────────────────────────────────────────
  const onRequest = (ctx) => {
    const { request, response } = ctx;

    if (request.method === 'POST') {
      response.setHeader({ name: 'Content-Type', value: 'application/json; charset=utf-8' });
      let result;
      try {
        const body = JSON.parse(request.body || '{}');
        const action = body.action || 'build';
        if (action === 'build')             result = buildDoor(body);
        else if (action === 'buildTemplate') result = buildDoor(
          Object.assign({}, body, { asTemplate: true })
        );
        else if (action === 'updateFields') result = updateDoor(body, false);
        else if (action === 'newBomRev')    result = updateDoor(body, true);
        else result = { ok: false, message: 'Unknown action: ' + action };
      } catch (e) {
        log.error({ title: 'POST fatal', details: e.toString() + ' | ' + (e.stack || '') });
        result = { ok: false, message: e.message || String(e) };
      }
      response.write(JSON.stringify(result));
      return;
    }

    const api = request.parameters.api || '';
    if (api) {
      response.setHeader({ name: 'Content-Type', value: 'application/json; charset=utf-8' });
      response.write(JSON.stringify(handleApi(api, request.parameters)));
      return;
    }

    if (request.parameters.refresh) clearListCaches();
    response.writePage(buildForm());
  };

  function clearListCaches() {
    _defaultsCache = {};
    _cacheCleared = true;
    if (!CFG.USE_CACHE) return [];
    const cleared = [];
    try {
      const c = nsCache.getCache({ name: CFG.CACHE_NAME, scope: nsCache.Scope.PUBLIC });
      const keys = (CFG.CACHE_KEYS || []).slice();
      // Every template's field snapshot and fill payload, including ones added
      // since this script was written — which is the whole point of the
      // refresh escape hatch.
      //
      // With STAMP_TEMPLATE_CACHE on these keys carry a stamp suffix, so the
      // unstamped names below will not match the live entries. That is fine
      // and deliberate: a stamped entry is only reachable while the records it
      // was read from are unchanged, so the moment it goes stale it is
      // unreachable anyway and expires on its own TTL. The unstamped removals
      // stay for accounts running with the stamp turned off.
      let known = [];
      try { known = listDoorTemplates(true) || []; } catch (e) { known = []; }
      for (const t of known) {
        for (const f of ALL_FAMILIES) {
          if (!t.items || !t.items[f]) continue;
          const key = 'tpl_' + t.items[f];
          if (keys.indexOf(key) === -1) keys.push(key);
        }
        const fillKey = 'tplfill_' + t.key;
        if (keys.indexOf(fillKey) === -1) keys.push(fillKey);
      }
      for (const k in (CFG.FALLBACK_TEMPLATE_ITEMS || {})) {
        const key = 'tpl_' + CFG.FALLBACK_TEMPLATE_ITEMS[k];
        if (keys.indexOf(key) === -1) keys.push(key);
      }
      for (const k of keys) {
        try { c.remove({ key: k }); cleared.push(k); }
        catch (e) { log.audit({ title: 'cache remove failed', details: k + ': ' + e.toString() }); }
      }
      log.audit({ title: 'caches cleared', details: cleared.join(', ') || '(none)' });
    } catch (e) {
      log.error({ title: 'clearListCaches', details: e.toString() });
    }
    return cleared;
  }

  // ─── FORM (NetSuite-chrome rendering) ─────────────────────────────────────
  function buildForm() {
    const form = serverWidget.createForm({ title: 'Door Number Builder' });

    let html;
    try {
      html = buildInlineHtml();
    } catch (e) {
      log.error({ title: 'buildInlineHtml fatal', details: e.toString() + ' | ' + (e.stack || '') });
      html =
        '<div id="' + WRAP + '">' +
        '<div style="font-family:system-ui;padding:24px;max-width:720px">' +
        '<h2 style="color:#a02020;margin-bottom:8px">Door Number Builder could not load</h2>' +
        '<p style="font-family:monospace;background:#fff0f0;border:1px solid #ffaaaa;' +
        'padding:12px;border-radius:5px">' + escHtml(e.message || String(e)) + '</p>' +
        '<p style="margin-top:8px">Full detail is in the script execution log.</p>' +
        '</div></div>';
    }

    const field = form.addField({
      id: 'custpage_gny_dnb_html',
      type: serverWidget.FieldType.INLINEHTML,
      label: 'Door Number Builder'
    });
    field.updateLayoutType({ layoutType: serverWidget.FieldLayoutType.OUTSIDEBELOW });
    field.updateBreakType({ breakType: serverWidget.FieldBreakType.STARTROW });
    field.defaultValue = html;

    return form;
  }

  // ─── CACHE ────────────────────────────────────────────────────────────────
  function reviveDates(v) {
    if (v && typeof v === 'object' && typeof v.__d === 'string') return new Date(v.__d);
    return v;
  }

  function cached(key, ttl, producer) {
    if (!CFG.USE_CACHE) return producer();
    try {
      const c = nsCache.getCache({ name: CFG.CACHE_NAME, scope: nsCache.Scope.PUBLIC });
      const raw = c.get({
        key: key,
        ttl: ttl,
        loader: () => {
          const v = producer();
          // Never persist emptiness. One transient query failure would
          // otherwise poison a dropdown for the whole TTL.
          if (!v || (Array.isArray(v) && !v.length)) return '';
          return JSON.stringify(v, dateReplacer);
        }
      });
      if (!raw) return producer();
      const parsed = JSON.parse(raw, (k, v) => reviveDates(v));
      if (Array.isArray(parsed) && !parsed.length) return producer();
      return parsed;
    } catch (e) {
      log.audit({ title: 'cache miss/fail for ' + key, details: e.toString() });
      return producer();
    }
  }

  // JSON.stringify calls toJSON() on Dates BEFORE the replacer sees them, so
  // an `instanceof Date` check inside the replacer never fires. Detecting the
  // shape on the original object is what actually works.
  function dateReplacer(key, value) {
    if (this && this[key] instanceof Date) return { __d: this[key].toISOString() };
    return value;
  }

  // ─── READ-ONLY API ENDPOINTS ──────────────────────────────────────────────
  function handleApi(api, params) {
    try {
      if (api === 'items')         return searchItems(params.term || '');
      if (api === 'workcenters')   return listWorkCenters();
      if (api === 'costtemplates') return listCostTemplates();
      if (api === 'classes')       return listClasses();
      if (api === 'templates')     return listDoorTemplates();
      // fresh=1 is "Re-fill from template" — skip the server cache entirely
      // and read the template's live BOM and routing.
      if (api === 'template')      return loadTemplateFill(params.term || '', params.fresh === '1');
      if (api === 'nextnumber')    return { number: nextDoorNumber() };
      if (api === 'checkitem')     return checkItemName(params.term || '');
      if (api === 'checkdoor')     return checkDoorNumber(params.term || '');
      if (api === 'loaddoor')      return loadDoorForEdit(params.term || '', params.forcopy === '1');
      if (api === 'doors')         return searchDoors(params.term || '');
      if (api === 'partcopy')      return loadPartForCopy(params.term || '');
    } catch (e) {
      log.error({ title: 'api ' + api, details: e.toString() + ' | ' + (e.stack || '') });
    }
    return [];
  }

  function sq(str) { return String(str || '').replace(/'/g, "''"); }

  // Is this exact item name already taken, and by what? Powers the tube-frame
  // number box, where an existing number means "link it" rather than "clash".
  function checkItemName(term) {
    const name = String(term || '').trim().toUpperCase();
    if (!name) return { ok: false, message: 'Enter a number.' };
    const found = checkPartNumbers([name]);
    const id = found[name];
    if (!id) return { ok: true, exists: false, name: name };
    let desc = '';
    try {
      const rs = query.runSuiteQL({
        query: `SELECT displayname, itemtype FROM item WHERE id = ${parseInt(id, 10)}`
      }).asMappedResults();
      if (rs[0]) desc = rs[0].displayname || '';
    } catch (e) { /* name is enough */ }
    return { ok: true, exists: true, id: String(id), name: name, desc: desc };
  }

  // Collapses runs of whitespace before comparing. "DR  Core Lamination" is
  // the real name of a real cost template, double space and all, and a naive
  // exact match against "DR Core Lamination" silently misses it.
  function normName(s) {
    return String(s == null ? '' : s).replace(/\s+/g, ' ').trim().toUpperCase();
  }

  // Two-pass component search. Prefix match on itemid is cheap and indexed and
  // covers how people search (they type the start of a stock number). The
  // description scan is a full wildcard and only runs if the first pass is thin.
  function searchItems(term) {
    if (!term || term.length < CFG.SEARCH_MIN_CHARS) return [];
    const safe = sq(term).toUpperCase();
    const rows = CFG.SEARCH_ROWS;
    const types = (CFG.SEARCH_ITEM_TYPES || []).map(t => "'" + sq(t) + "'").join(',');
    const typeFilter = types ? ` AND itemtype IN (${types})` : '';
    const seen = {};
    const out = [];

    function collect(sql) {
      let rs = [];
      try { rs = query.runSuiteQL({ query: sql }).asMappedResults(); }
      catch (e) { log.audit({ title: 'searchItems variant failed', details: e.toString() }); }
      for (const r of rs) {
        if (seen[r.id]) continue;
        seen[r.id] = true;
        out.push({ id: r.id, itemid: r.itemid, desc: r.displayname || '', type: r.itemtype || '' });
      }
    }

    collect(`SELECT id, itemid, displayname, itemtype
             FROM item
             WHERE isinactive = 'F' AND UPPER(itemid) LIKE '${safe}%'${typeFilter}
             ORDER BY itemid
             FETCH FIRST ${rows} ROWS ONLY`);

    if (out.length < rows) {
      collect(`SELECT id, itemid, displayname, itemtype
               FROM item
               WHERE isinactive = 'F' AND UPPER(displayname) LIKE '%${safe}%'${typeFilter}
               ORDER BY itemid
               FETCH FIRST ${rows} ROWS ONLY`);
    }

    return out.slice(0, rows);
  }

  // Powers the door search box. Only DR- items, because that's the number a
  // person thinks in — picking one loads the whole family.
  function searchDoors(term) {
    if (!term) return [];
    const safe = sq(term).toUpperCase();
    const rows = CFG.SEARCH_ROWS;
    const out = [];
    try {
      const rs = query.runSuiteQL({
        query: `SELECT id, itemid, displayname
                FROM item
                WHERE UPPER(itemid) LIKE 'DR-%${safe}%'
                ORDER BY itemid
                FETCH FIRST ${rows} ROWS ONLY`
      }).asMappedResults();
      for (const r of rs) out.push({ id: r.id, itemid: r.itemid, desc: r.displayname || '' });
    } catch (e) {
      log.audit({ title: 'searchDoors failed', details: e.toString() });
    }
    return out;
  }

  // The next free door number. GLOBAL across every series and every family —
  // DR-4500-1002211 and DR-6000-1002207 come off the same counter, so the max
  // has to be taken across all four prefixes, not just DR.
  //
  // The tail pattern is 6-or-more digits rather than exactly 7, so the legacy
  // 6-digit numbers (C-4000-001737) are counted too. They are all lower than
  // the current 10xxxxx run so it changes no answer today, but a counter that
  // silently ignores a whole numbering generation is a trap waiting for
  // whoever changes the scheme next. It also excludes templates, whose tail
  // is a word — making a template never burns a door number.
  //
  // Deliberately NOT cached. A stale suggestion means two people build onto
  // the same number, and the duplicate check turns that into a confusing
  // failure instead of a smooth one.
  function nextDoorNumber() {
    let max = 0;
    try {
      // Tube frames are named with a BARE number off this same pool — 61 of
      // them, running to 1002199 against a door maximum of 1002257. The
      // original query only counted prefixed names, so every one of them was
      // invisible to this counter and nothing but luck kept the two runs from
      // colliding. Bare numbers at the door location are counted now.
      const loc = parseInt(CFG.LOCATION_ID, 10);
      const bareClause = loc
        ? ` OR (REGEXP_LIKE(itemid, '^[0-9]{6,}$') AND location = ${loc})`
        : '';
      const rows = query.runSuiteQL({
        query: `SELECT MAX(TO_NUMBER(REGEXP_SUBSTR(itemid, '[0-9]+$'))) AS maxnum
                FROM item
                WHERE REGEXP_LIKE(itemid, '^(DR|C|F|S)-[0-9]+-[0-9]{6,}$')${bareClause}`
      }).asMappedResults();
      max = parseInt(rows[0] && rows[0].maxnum, 10) || 0;
    } catch (e) {
      log.error({ title: 'nextDoorNumber', details: e.toString() });
      return '';
    }
    if (!max) return '';
    return padNumber(max + 1);
  }

  function padNumber(n) {
    let s = String(n);
    while (s.length < CFG.NUMBER_WIDTH) s = '0' + s;
    return s;
  }

  // Builds the four part numbers a given series + number resolves to.
  function familyNumbers(series, number) {
    const out = {};
    const tail = String(series).trim() + '-' + String(number).trim();
    for (const f of ALL_FAMILIES) out[f] = CFG.FAMILY_PREFIX[f] + tail;
    return out;
  }

  // Checks several part numbers in ONE query. Four separate round trips for a
  // door family is four waits for the same answer.
  function checkPartNumbers(nums) {
    const list = nums.filter(n => n).map(n => "'" + sq(n).toUpperCase() + "'");
    if (!list.length) return {};
    const found = {};
    try {
      query.runSuiteQL({
        query: `SELECT id, itemid FROM item WHERE UPPER(itemid) IN (${list.join(',')})`
      }).asMappedResults().forEach(r => {
        found[String(r.itemid).trim().toUpperCase()] = r.id;
      });
    } catch (e) {
      log.error({ title: 'checkPartNumbers', details: e.toString() });
    }
    return found;
  }

  // Answers "is this door number free, and if not, what already exists on it?"
  // Accepts either a bare number (1002212) or a full DR- part number.
  function checkDoorNumber(term) {
    const parsed = parseDoorTerm(term);
    if (!parsed) return { ok: false, message: 'Enter a door number.' };

    // A bare number with no series can't name a part, but it can still tell
    // you whether that number is taken anywhere.
    if (!parsed.series) {
      let hit = null;
      try {
        const rows = query.runSuiteQL({
          query: `SELECT itemid FROM item
                  WHERE REGEXP_LIKE(itemid, '^DR-[0-9]+-${sq(parsed.number)}$')`
        }).asMappedResults();
        hit = rows[0] ? rows[0].itemid : null;
      } catch (e) { /* fall through to "free" */ }
      return hit
        ? { ok: true, exists: true, doorNumber: hit, number: parsed.number }
        : { ok: true, exists: false, number: parsed.number };
    }

    const nums = familyNumbers(parsed.series, parsed.number);
    const found = checkPartNumbers(ALL_FAMILIES.map(f => nums[f]));
    const existing = {};
    let any = false;
    for (const f of ALL_FAMILIES) {
      const id = found[nums[f].toUpperCase()];
      if (id) { existing[f] = id; any = true; }
    }
    return {
      ok: true,
      exists: any,
      hasDoor: !!existing.DR,
      existing: existing,
      numbers: nums,
      series: parsed.series,
      number: parsed.number,
      doorNumber: nums.DR
    };
  }

  // Accepts "1002212", "DR-4500-1002212", "4500-1002212", "C-4500-1002212",
  // and the template forms "DR-4000-TEMPLATE" / "DR-4500-ENT-TEMPLATE".
  // Returns { series, number } with series possibly blank. The tail is not
  // required to be numeric — a template is an ordinary door family whose
  // number happens to be a word, and it has to load into edit mode like one.
  function parseDoorTerm(term) {
    const t = String(term || '').trim().toUpperCase();
    if (!t) return null;
    let m = t.match(/^(?:DR|C|F|S)-([0-9]+)-([A-Z0-9][A-Z0-9-]*)$/);
    if (m) return { series: m[1], number: m[2] };
    m = t.match(/^([0-9]{3,5})-([0-9]{4,})$/);
    if (m) return { series: m[1], number: m[2] };
    m = t.match(/^([0-9]+)$/);
    if (m) return { series: '', number: m[1] };
    return null;
  }

  function tryQueries(candidates, label) {
    for (const c of candidates) {
      try {
        const rows = query.runSuiteQL({ query: c.sql }).asMappedResults();
        if (rows && rows.length) return rows.map(c.map);
      } catch (e) {
        log.audit({ title: label + ' — query variant failed', details: e.toString() });
      }
    }
    log.error({ title: label + ' — no variant returned rows', details: 'dropdown will be empty' });
    return [];
  }

  // Like tryQueries, but UNIONs every variant by internal ID instead of
  // stopping at the first that returns anything. Entries flagged `weak` carry
  // a placeholder name and are overwritten the moment any variant supplies a
  // real one for that ID.
  function mergeQueries(candidates, label) {
    const byId = {};
    const report = [];

    for (const c of candidates) {
      let rows = [];
      try {
        rows = query.runSuiteQL({ query: c.sql }).asMappedResults() || [];
      } catch (e) {
        report.push(c.tag + '=ERR');
        log.audit({ title: label + ' — variant ' + c.tag + ' failed', details: e.toString() });
        continue;
      }

      let added = 0, upgraded = 0;
      for (const r of rows) {
        let m;
        try { m = c.map(r); } catch (e) { continue; }
        if (!m || !m.id) continue;
        const k = String(m.id);
        const existing = byId[k];
        if (!existing) {
          byId[k] = { id: k, name: m.name, weak: !!c.weak };
          added++;
        } else if (existing.weak && !c.weak && m.name) {
          existing.name = m.name;
          existing.weak = false;
          upgraded++;
        }
      }
      report.push(c.tag + '=' + rows.length + (added ? ' +' + added : '') +
                  (upgraded ? ' ^' + upgraded : ''));
    }

    const out = [];
    for (const k in byId) out.push({ id: byId[k].id, name: byId[k].name });
    out.sort((a, b) => normName(a.name) < normName(b.name) ? -1 : 1);

    log.audit({
      title: label + ' — merged ' + out.length + ' rows',
      details: report.join('  ') || '(no variants ran)'
    });
    if (!out.length) {
      log.error({ title: label + ' — every variant came back empty', details: 'dropdown will be empty' });
    }
    return out;
  }

  // The three door work centers are entity GROUPS carrying grouptype
  // 'Employee', not the 'MfgWorkCenter' the SuiteQL docs imply — same trap the
  // hitch builder documents. Every angle runs and the results are merged, so
  // one working variant is enough.
  //
  //   byUsage — groups referenced by a routing step that already runs a door
  //             cost template. Sturdiest: no grouptype, no name guessing.
  //   byName  — name prefixes, for a centre not yet on any routing.
  //   byType* — grouptype filters, for accounts that do expose it.
  function listWorkCenters() {
    return cached('workcenters', CFG.CACHE_TTL_LISTS, () => {
      const patterns = (CFG.WORK_CENTER_NAME_PATTERNS || [])
        .map(p => `UPPER(groupname) LIKE '${sq(p).toUpperCase()}'`)
        .join(' OR ');

      const ctPatterns = (CFG.COST_TEMPLATE_PATTERNS || [])
        .map(p => `UPPER(name) LIKE '${sq(p).toUpperCase()}'`)
        .join(' OR ');

      const variants = [];

      if (ctPatterns) {
        variants.push({
          tag: 'byUsage',
          sql: `SELECT eg.id AS id, eg.groupname AS wcname
                FROM entitygroup eg
                WHERE eg.isinactive = 'F'
                  AND eg.id IN (SELECT s.manufacturingworkcenter
                                FROM ManufacturingRoutingRoutingStep s
                                JOIN ManufacturingCostTemplate ct
                                  ON ct.id = s.manufacturingcosttemplate
                                WHERE s.manufacturingworkcenter IS NOT NULL
                                  AND (${ctPatterns.replace(/UPPER\(name\)/g, 'UPPER(ct.name)')}))
                ORDER BY eg.groupname`,
          map: r => ({ id: r.id, name: r.wcname })
        });
      }

      if (patterns) {
        variants.push({
          tag: 'byName',
          sql: `SELECT id, groupname AS wcname
                FROM entitygroup
                WHERE isinactive = 'F' AND (${patterns})
                ORDER BY groupname`,
          map: r => ({ id: r.id, name: r.wcname })
        });
      }

      variants.push(
        {
          tag: 'byTypeWC',
          sql: `SELECT id, groupname AS wcname
                FROM entitygroup
                WHERE UPPER(grouptype) LIKE '%WORKCENTER%' AND isinactive = 'F'
                  AND UPPER(groupname) LIKE 'DOOR%'
                ORDER BY groupname`,
          map: r => ({ id: r.id, name: r.wcname })
        },
        {
          tag: 'byTypeEmp',
          sql: `SELECT id, groupname AS wcname
                FROM entitygroup
                WHERE UPPER(grouptype) LIKE '%EMPLOYEE%' AND isinactive = 'F'
                  AND UPPER(groupname) LIKE 'DOOR%'
                ORDER BY groupname`,
          map: r => ({ id: r.id, name: r.wcname })
        }
      );

      const rows = mergeQueries(variants, 'listWorkCenters');

      const skip = {};
      for (const n of (CFG.WORK_CENTER_EXCLUDE || [])) skip[normName(n)] = true;
      return rows.filter(r => !skip[normName(r.name)]);
    });
  }

  // Door cost templates only. The account's other ~130 templates are hitch and
  // aluminum work and would be nothing but noise in a door routing dropdown.
  function listCostTemplates() {
    return cached('costtemplates', CFG.CACHE_TTL_LISTS, () => {
      const patterns = (CFG.COST_TEMPLATE_PATTERNS || [])
        .map(p => `UPPER(name) LIKE '${sq(p).toUpperCase()}'`)
        .join(' OR ');

      const variants = [];
      if (patterns) {
        variants.push({
          tag: 'byName',
          sql: `SELECT id, name AS ctname
                FROM ManufacturingCostTemplate
                WHERE isinactive = 'F' AND (${patterns})
                ORDER BY name`,
          map: r => ({ id: r.id, name: r.ctname })
        });
      }
      // If the name patterns ever stop matching, an empty dropdown is worse
      // than a long one. Fall back to everything rather than nothing.
      variants.push({
        tag: 'all',
        sql: `SELECT id, name AS ctname
              FROM ManufacturingCostTemplate
              WHERE isinactive = 'F' ORDER BY name`,
        map: r => ({ id: r.id, name: r.ctname })
      });

      for (const v of variants) {
        try {
          const rows = query.runSuiteQL({ query: v.sql }).asMappedResults();
          if (rows && rows.length) return rows.map(v.map);
        } catch (e) {
          log.audit({ title: 'listCostTemplates variant ' + v.tag + ' failed', details: e.toString() });
        }
      }
      log.error({ title: 'listCostTemplates — every variant empty', details: 'dropdown will be empty' });
      return [];
    });
  }

  // Item classes. Full path (fullname) shown so nested duplicates stay apart.
  function listClasses() {
    return cached('classes', CFG.CACHE_TTL_LISTS, () => tryQueries([
      {
        sql: `SELECT id, fullname AS cname FROM classification
              WHERE isinactive = 'F' ORDER BY fullname`,
        map: r => ({ id: r.id, name: r.cname })
      }
    ], 'listClasses'));
  }

  // Resolves a work center / cost template / class NAME to an internal ID.
  // Exact first, then starts-with, then contains — all whitespace-normalised.
  function matchNameToId(list, wanted) {
    if (!wanted) return '';
    const w = normName(wanted);
    let hit = list.filter(r => normName(r.name) === w)[0];
    if (!hit) hit = list.filter(r => normName(r.name).indexOf(w) === 0)[0];
    if (!hit) hit = list.filter(r => normName(r.name).indexOf(w) !== -1)[0];
    // Classes are stored as full paths ("PARENT : 4000 SERIES"), so a
    // trailing-segment match is the one that usually lands.
    if (!hit) hit = list.filter(r => normName(r.name).split(':').pop().trim() === w)[0];
    return hit ? String(hit.id) : '';
  }

  // ─── TEMPLATES ────────────────────────────────────────────────────────────
  let _templateListCache = null;

  // Every door family named like a template, with its siblings resolved. This
  // is a discovery query on purpose: adding DR-6000-TEMPLATE to NetSuite is
  // all it takes to add a 6000-series option to the picker.
  //
  // `key` is the DR item's own name, which is what the picker sends back and
  // what the build re-resolves against — so a template can be renamed or
  // replaced without anything here holding a stale internal ID.
  function listDoorTemplates(skipCache) {
    const produce = () => {
      let rows = [];
      try {
        rows = query.runSuiteQL({
          query: `SELECT id, itemid, displayname, class
                  FROM item
                  WHERE itemtype = 'Assembly' AND isinactive = 'F'
                    AND UPPER(itemid) LIKE '${sq(CFG.TEMPLATE_DOOR_PATTERN).toUpperCase()}'
                  ORDER BY itemid`
        }).asMappedResults();
      } catch (e) {
        log.error({ title: 'listDoorTemplates', details: e.toString() });
        return [];
      }
      if (!rows.length) return [];

      // Siblings, in one query rather than one per template.
      const wanted = [];
      const siblingOf = {};
      for (const r of rows) {
        const tail = String(r.itemid).slice(CFG.FAMILY_PREFIX.DR.length);
        for (const f of ['F', 'C', 'S']) {
          const nm = CFG.FAMILY_PREFIX[f] + tail;
          wanted.push(nm);
          siblingOf[nm.toUpperCase()] = { key: r.itemid, family: f };
        }
      }
      const found = checkPartNumbers(wanted);

      const out = [];
      for (const r of rows) {
        const items = { DR: String(r.id) };
        const tail = String(r.itemid).slice(CFG.FAMILY_PREFIX.DR.length);
        for (const f of ['F', 'C', 'S']) {
          const id = found[(CFG.FAMILY_PREFIX[f] + tail).toUpperCase()];
          if (id) items[f] = String(id);
        }
        // A template named DR-4000-TEMPLATE implies series 4000. Anything
        // else (DR-ENT-TEMPLATE) just leaves the series for you to pick.
        const sm = String(r.itemid).match(/^DR-([0-9]{3,5})-/);
        out.push({
          key: r.itemid,
          label: r.itemid,
          series: sm ? sm[1] : '',
          classId: r.class ? String(r.class) : '',
          items: items,
          families: ALL_FAMILIES.filter(f => items[f])
        });
      }
      log.audit({
        title: 'door templates found',
        details: out.map(t => t.key + ' [' + t.families.join('/') + ']').join(', ')
      });
      return out;
    };

    if (skipCache) return produce();
    if (_templateListCache) return _templateListCache;
    _templateListCache = cached('templates', CFG.CACHE_TTL_LISTS, produce);
    return _templateListCache;
  }

  function findTemplate(key) {
    if (!key) return null;
    const k = normName(key);
    return listDoorTemplates().filter(t => normName(t.key) === k)[0] || null;
  }

  // The four item IDs behind an existing door number, in the same shape
  // findTemplate() returns. That shape is the point: it lets the build path
  // inherit item fields from a real door exactly the way it inherits them
  // from a template, and lets templateStamp() key a cache off it unchanged.
  function resolveDoorItems(term) {
    const parsed = parseDoorTerm(term);
    if (!parsed || !parsed.series) return null;
    const nums = familyNumbers(parsed.series, parsed.number);
    const found = checkPartNumbers(ALL_FAMILIES.map(f => nums[f]));
    const items = {};
    for (const f of ALL_FAMILIES) {
      const id = found[nums[f].toUpperCase()];
      if (id) items[f] = String(id);
    }
    // No door item, no copy. The sub-assemblies alone are not a door.
    if (!items.DR) return null;
    return {
      key: nums.DR,
      series: parsed.series,
      number: parsed.number,
      items: items,
      families: ALL_FAMILIES.filter(f => items[f])
    };
  }

  // Invalidates just the discovery list, so a template created a moment ago is
  // pickable now rather than in up to an hour. Cheaper and less disruptive
  // than the full ?refresh=1 sweep, which also dumps the work centers and
  // cost templates that did not change.
  function dropTemplateCache() {
    _templateListCache = null;
    if (!CFG.USE_CACHE) return;
    try {
      nsCache.getCache({ name: CFG.CACHE_NAME, scope: nsCache.Scope.PUBLIC })
        .remove({ key: 'templates' });
    } catch (e) {
      log.audit({ title: 'dropTemplateCache', details: e.toString() });
    }
  }

  // A short string that moves whenever anything loadTemplateFill reads has
  // changed. Folded into the cache key, so editing a template in NetSuite
  // invalidates it rather than waiting out CACHE_TTL_TEMPLATE. This is the
  // whole answer to "I updated the template outside the tool and the tool
  // didn't notice."
  //
  // Everything is reached BY NAME, not by internal ID, because the item -> BOM
  // link is not exposed to SuiteQL — it lives on the item's own sublist. The
  // builder names every record it creates off the part number ("{part} BOM",
  // "{part} ROUTING"), so all the names derive from the template key alone and
  // this stays ONE query rather than four record loads.
  //
  // The four parts:
  //   I  newest lastmodifieddate across the family's items       (field edits)
  //   R  newest lastmodifieddate across their BOM revisions      (component edits)
  //   N  total component line count across those revisions       (adds/deletes)
  //   S  aggregate fingerprint of the routing steps              (routing edits)
  //
  // S has to be a fingerprint because ManufacturingRouting carries NO
  // lastmodifieddate column in this account — selecting it errors outright.
  // Count plus the sums of sequence, work center, cost template, run rate,
  // setup and operation-name length moves on any real edit. The one thing it
  // cannot see is an operation renamed to a different name of the same length
  // with nothing else changed; "Re-fill from template" covers that.
  //
  // A failure here returns '' — the plain unstamped key, which is the OLD
  // behaviour. Stale, not broken. Never fail a page load over a cache tweak.
  function templateStamp(tpl) {
    if (!CFG.USE_CACHE || !CFG.STAMP_TEMPLATE_CACHE || !tpl) return '';
    const tail = String(tpl.key).slice(CFG.FAMILY_PREFIX.DR.length);
    const items = [], boms = [], routings = [];
    for (const f of ALL_FAMILIES) {
      const pn = sq(CFG.FAMILY_PREFIX[f] + tail).toUpperCase();
      items.push("'" + pn + "'");
      boms.push("'" + pn + " BOM'");
      routings.push("'" + pn + " ROUTING'");
    }
    const inItems = items.join(','), inBoms = boms.join(','), inRt = routings.join(',');
    try {
      const rows = query.runSuiteQL({
        query:
          `SELECT 'I' AS k, TO_CHAR(MAX(lastmodifieddate),'YYYYMMDDHH24MISS') AS v
             FROM item WHERE UPPER(itemid) IN (${inItems})
           UNION ALL
           SELECT 'R', TO_CHAR(MAX(r.lastmodifieddate),'YYYYMMDDHH24MISS')
             FROM bomrevision r JOIN bom b ON b.id = r.billofmaterials
            WHERE UPPER(b.name) IN (${inBoms})
           UNION ALL
           SELECT 'N', TO_CHAR(COUNT(*))
             FROM bomrevisioncomponent c
             JOIN bomrevision r2 ON r2.id = c.bomrevision
             JOIN bom b2 ON b2.id = r2.billofmaterials
            WHERE UPPER(b2.name) IN (${inBoms})
           UNION ALL
           SELECT 'S', TO_CHAR(COUNT(*))
             || '.' || TO_CHAR(SUM(s.operationsequence))
             || '.' || TO_CHAR(SUM(NVL(s.manufacturingworkcenter,0)))
             || '.' || TO_CHAR(SUM(NVL(s.manufacturingcosttemplate,0)))
             || '.' || TO_CHAR(SUM(NVL(s.runrate,0)))
             || '.' || TO_CHAR(SUM(NVL(s.setuptime,0)))
             || '.' || TO_CHAR(SUM(LENGTH(NVL(s.operationname,'x'))))
             FROM ManufacturingRoutingRoutingStep s
             JOIN ManufacturingRouting rt ON rt.id = s.manufacturingrouting
            WHERE UPPER(rt.name) IN (${inRt})`
      }).asMappedResults();

      const by = {};
      for (const r of rows) by[r.k] = (r.v == null) ? '' : String(r.v);
      // Cache keys are not a free-form string — keep it to characters that
      // are safe everywhere.
      return ['I', 'R', 'N', 'S'].map(k => by[k] || '0').join('_')
                                 .replace(/[^A-Za-z0-9._]/g, '');
    } catch (e) {
      log.audit({ title: 'templateStamp failed for ' + tpl.key, details: e.toString() });
      return '';
    }
  }

  // Everything the form needs to fill itself from a template: per family, the
  // component lines with their quantities and sources, and the routing steps
  // with their work centers and cost templates. Read off the template's live
  // BOM and routing, so editing the template in NetSuite is how you change
  // what new doors start as.
  //
  // skipCache is "Re-fill from template" — read NetSuite, ignore every cache.
  function loadTemplateFill(key, skipCache) {
    const tpl = findTemplate(key);
    if (!tpl) return { ok: false, message: 'Template "' + key + '" was not found.' };

    const produce = () => {
      const out = {
        ok: true,
        key: tpl.key,
        series: tpl.series,
        classId: tpl.classId,
        families: {},
        warnings: []
      };

      for (const f of ALL_FAMILIES) {
        const itemId = tpl.items[f];
        if (!itemId) continue;
        const unit = loadFamilyUnit(f, templateNameFor(tpl, f), itemId, out.warnings);
        if (!unit) continue;

        // Strip the TEMPLATE marker off the front so the description is a
        // usable starting point rather than something you have to edit twice.
        if (f === 'DR') {
          out.description = String(unit.description || '').replace(CFG.TEMPLATE_DESC_MARKER, '').trim();
          out.cutDetails = unit.cutDetails || '';
          if (!out.classId) out.classId = unit.classId || '';
        }

        out.families[f] = {
          itemId: itemId,
          partNumber: unit.partNumber,
          components: unit.components || [],
          steps: unit.steps || []
        };
      }

      // The door's own sub-assembly lines point at the TEMPLATE frame and
      // core. Those are placeholders for the real ones this build is about to
      // create, so they're stripped out here — the form re-derives them from
      // the new door number. Only the loose hardware carries over.
      const dr = out.families.DR;
      if (dr) {
        const subNames = {};
        for (const f of ['F', 'C', 'S']) {
          if (tpl.items[f]) subNames[normName(templateNameFor(tpl, f))] = true;
        }
        const kept = [], dropped = [];
        for (const c of dr.components) {
          if (subNames[normName(c.itemNumber)]) dropped.push(c.itemNumber);
          else kept.push(c);
        }
        dr.components = kept;
        if (dropped.length) {
          log.audit({
            title: 'template sub-assembly lines stripped',
            details: tpl.key + ': ' + dropped.join(', ') + ' — re-derived per door'
          });
        }
      }

      if (!out.families.DR) out.warnings.push(tpl.key + ' itself could not be read.');
      for (const f of ['F', 'C']) {
        if (!out.families[f]) {
          out.warnings.push('This template has no ' + FAMILY_LABEL[f].toLowerCase() +
                            ' — that grid starts empty.');
        }
      }
      return out;
    };

    // No stamp query at all on a forced re-read — it would only be used to
    // build a key nobody is going to look at.
    if (skipCache) return produce();

    const stamp = templateStamp(tpl);
    return cached('tplfill_' + tpl.key + (stamp ? '_' + stamp : ''),
                  CFG.CACHE_TTL_TEMPLATE, produce);
  }

  function templateNameFor(tpl, family) {
    const tail = String(tpl.key).slice(CFG.FAMILY_PREFIX.DR.length);
    return CFG.FAMILY_PREFIX[family] + tail;
  }

  // ─── EDIT MODE — LOAD ─────────────────────────────────────────────────────
  // Pulls the whole family: for each of DR/F/C/S that exists, its item fields,
  // BOM, current revision, components, and default routing steps.
  function loadDoorForEdit(term, forCopy) {
    const parsed = parseDoorTerm(term);
    if (!parsed) return { ok: false, message: 'Enter a door number.' };

    let series = parsed.series;
    const number = parsed.number;

    // A bare number needs its series resolved before anything else can be
    // named. The DR item is the authority on which series a number belongs to.
    if (!series) {
      try {
        const rows = query.runSuiteQL({
          query: `SELECT itemid FROM item
                  WHERE REGEXP_LIKE(itemid, '^DR-[0-9]+-${sq(number)}$')`
        }).asMappedResults();
        if (!rows.length) return { ok: false, message: 'No door found on number ' + number + '.' };
        const m = String(rows[0].itemid).match(/^DR-([0-9]+)-/);
        series = m ? m[1] : '';
      } catch (e) {
        return { ok: false, message: 'Could not resolve the series for ' + number + ': ' + e.message };
      }
    }
    if (!series) return { ok: false, message: 'Could not work out the series for ' + number + '.' };

    const nums = familyNumbers(series, number);
    const found = checkPartNumbers(ALL_FAMILIES.map(f => nums[f]));
    if (!found[nums.DR.toUpperCase()]) {
      return { ok: false, message: nums.DR + ' was not found.' };
    }

    const out = {
      ok: true,
      series: series,
      number: number,
      doorNumber: nums.DR,
      numbers: nums,
      families: {},
      warnings: []
    };

    for (const f of ALL_FAMILIES) {
      const itemId = found[nums[f].toUpperCase()];
      if (!itemId) continue;
      const loaded = loadFamilyUnit(f, nums[f], itemId, out.warnings);
      if (loaded) out.families[f] = loaded;
    }

    const dr = out.families.DR;
    if (!dr) return { ok: false, message: 'Could not read ' + nums.DR + '.' };

    // The description is typed once and cascades, so the door's own text is
    // the one to show. The sub-assembly prefixes are re-derived on save.
    out.description = dr.description || '';
    out.classId = dr.classId || '';
    out.cutDetails = dr.cutDetails || '';
    out.doorLine = dr.doorLine || '';
    out.purchasePrice = dr.purchasePrice || '';
    out.hasScreen = !!out.families.S;

    // Split the door's own BOM into the sub-assembly lines (which this tool
    // owns and re-derives) and everything else (loose hardware the person
    // edits by hand). Without this split, editing a door would show its own
    // frame and core as ordinary component rows and invite someone to delete
    // the very lines that make it a door.
    if (dr.components) {
      const subNums = {};
      for (const f of ['F', 'C', 'S']) subNums[nums[f].toUpperCase()] = f;
      const sub = [], loose = [];
      for (const c of dr.components) {
        const fam = subNums[String(c.itemNumber || '').toUpperCase()];
        if (fam) sub.push(Object.assign({ family: fam }, c));
        else loose.push(c);
      }
      dr.subLines = sub;
      dr.components = loose;
    }

    // The tube frame is NOT derivable from the door number, so it cannot be
    // looked up by name the way the frame and core are — it is found by shape
    // on the core's BOM: an assembly component whose name is a bare number.
    // Frames, cores and screens all carry a prefix and raw stock is 5-digit
    // 99xxx, so a 6-or-more-digit bare number on a core is a tube frame.
    //
    // It lands in subLines for the same reason the door's own sub-assemblies
    // do: this tool owns that line and re-derives it, and nobody should be
    // able to drop the tube out of a core by clearing a hardware row.
    const core = out.families.C;
    if (core && core.components) {
      const keptC = [], tubes = [];
      for (const c of core.components) {
        const isTube = String(c.itemType || '') === 'Assembly' &&
                       CFG.TUBE_ON_CORE_PATTERN.test(String(c.itemNumber || ''));
        if (isTube) tubes.push(c); else keptC.push(c);
      }
      if (tubes.length) {
        core.components = keptC;
        core.subLines = tubes;
        out.hasTube = true;
        out.tubeNumber = tubes[0].itemNumber;
        const tUnit = loadFamilyUnit('T', tubes[0].itemNumber, tubes[0].itemId, out.warnings);
        if (tUnit) out.families.T = tUnit;
        if (tubes.length > 1) {
          out.warnings.push('The core carries ' + tubes.length + ' tube-frame lines; only ' +
                            tubes[0].itemNumber + ' is editable here.');
        }
      }
    }

    // Doors built before the tube went on the core still carry it on the DOOR
    // BOM — which is nearly all of them. Two very different jobs here:
    //
    //   EDITING that door   leave it exactly where it is and say so. Moving a
    //                       tube between BOM levels is a change to make
    //                       deliberately, not a side effect of opening a door.
    //
    //   COPYING FROM it     pick it up AS the tube, so the new door gets one
    //                       built onto its CORE, which is where it belongs.
    //                       This is how the convention actually spreads: the
    //                       references all have it on the door, and every door
    //                       copied off them lands it on the core.
    if (!out.hasTube && dr.components) {
      const strays = dr.components.filter(c =>
        String(c.itemType || '') === 'Assembly' &&
        CFG.TUBE_ON_CORE_PATTERN.test(String(c.itemNumber || '')));
      if (strays.length) {
        if (forCopy) {
          // Taken off the door's lines so it is not ALSO copied across as
          // loose hardware — it becomes the tube family instead.
          const strayIds = {};
          for (const s of strays) strayIds[String(s.itemId)] = true;
          dr.components = dr.components.filter(c => !strayIds[String(c.itemId)]);

          out.hasTube = true;
          out.tubeNumber = strays[0].itemNumber;
          out.tubeFromDoorBom = true;
          const tUnit = loadFamilyUnit('T', strays[0].itemNumber, strays[0].itemId, out.warnings);
          if (tUnit) out.families.T = tUnit;
          out.warnings.push('Tube frame ' + strays[0].itemNumber + ' sits on ' + nums.DR +
                            '\u2019s own BOM. Copied as a tube frame, so the new door gets ' +
                            'one on its CORE, which is where it belongs.');
          if (strays.length > 1) {
            out.warnings.push(nums.DR + ' carries ' + strays.length +
                              ' tube-frame lines; only ' + strays[0].itemNumber + ' is copied.');
          }
        } else {
          out.tubeOnDoor = strays.map(c => c.itemNumber);
          out.warnings.push('Tube frame ' + out.tubeOnDoor.join(', ') +
                            ' is on the DOOR BOM, not the core. It is shown as loose hardware ' +
                            'below and is left exactly where it is — moving it is a BOM change ' +
                            'to make deliberately, not a side effect of opening the door.');
        }
      }
    }

    return out;
  }

  // One family's worth of live setup: item fields, BOM, current revision,
  // components, default routing and its steps.
  function loadFamilyUnit(fam, partNum, itemId, warnings) {
    let item;
    try {
      item = record.load({ type: record.Type.ASSEMBLY_ITEM, id: itemId, isDynamic: false });
    } catch (e) {
      warnings.push('Could not load ' + partNum + ': ' + e.message);
      return null;
    }

    const unit = {
      family: fam,
      partNumber: partNum,
      itemId: itemId,
      description: item.getValue({ fieldId: 'description' }) || '',
      classId: safeGet(item, 'class'),
      cutDetails: safeGet(item, CFG.CUT_DETAILS_FIELD),
      doorLine: safeGet(item, CFG.DOOR_LINE_FIELD),
      purchasePrice: safeGet(item, CFG.PURCHASE_PRICE_FIELD),
      components: [],
      steps: [],
      bomId: '', bomName: '', revId: '', revName: '', revEffectiveStart: null,
      routingId: '', routingName: ''
    };

    // The BOM link lives on the item's own sublist, not in SuiteQL. Prefer the
    // master-default line; fall back to line 0 if nothing is flagged.
    let bomId = '';
    try {
      const lineCount = item.getLineCount({ sublistId: 'billofmaterials' });
      for (let i = 0; i < lineCount; i++) {
        const isDefault = item.getSublistValue({ sublistId: 'billofmaterials', fieldId: 'masterdefault', line: i });
        const bId = item.getSublistValue({ sublistId: 'billofmaterials', fieldId: 'billofmaterials', line: i });
        if (isDefault) { bomId = bId; break; }
        if (!bomId) bomId = bId;
      }
    } catch (e) {
      log.audit({ title: 'loadFamilyUnit — bom sublist read failed', details: partNum + ': ' + e.toString() });
    }

    if (!bomId) {
      warnings.push(partNum + ' has no BOM attached — one will be built for it when this door is saved.');
      return unit;
    }
    unit.bomId = bomId;

    try {
      const rows = query.runSuiteQL({
        query: `SELECT id, name, usecomponentyield FROM bom WHERE id = ${parseInt(bomId, 10)}`
      }).asMappedResults();
      if (rows[0]) {
        unit.bomName = rows[0].name;
        unit.useComponentYield = rows[0].usecomponentyield === 'T' || rows[0].usecomponentyield === true;
      }
    } catch (e) {
      warnings.push('Could not read BOM ' + bomId + ' for ' + partNum + '.');
    }

    // bom.bomrevision is a comma-joined list of EVERY revision on the BOM, not
    // the current one. The current revision is the one still open (no
    // effective end date); if several are open, or none are, take the latest
    // start date.
    let revisions = [];
    try {
      revisions = query.runSuiteQL({
        query: `SELECT id, name, effectivestartdate, effectiveenddate
                FROM bomrevision
                WHERE billofmaterials = ${parseInt(bomId, 10)} AND isinactive = 'F'`
      }).asMappedResults();
    } catch (e) {
      warnings.push('Could not read revisions for ' + partNum + '.');
      return unit;
    }
    if (!revisions.length) {
      warnings.push(partNum + '\u2019s BOM has no active revisions — a new one will be built when this door is saved.');
      return unit;
    }

    const openRevs = revisions.filter(r => !r.effectiveenddate);
    const pool = openRevs.length ? openRevs.slice() : revisions.slice();
    pool.sort((a, b) => dateSortKey(b.effectivestartdate) - dateSortKey(a.effectivestartdate));
    const revRow = pool[0];
    unit.revId = revRow.id;
    unit.revName = revRow.name;
    unit.revEffectiveStart = revRow.effectivestartdate;

    if (openRevs.length > 1) {
      log.audit({
        title: 'multiple open BOM revisions on ' + partNum,
        details: openRevs.map(r => r.name + ' (' + r.id + ')').join(', ') + ' — using ' + revRow.name
      });
    }

    try {
      unit.components = query.runSuiteQL({
        query: `SELECT brc.lineid AS lineid, brc.item AS itemid, i.itemid AS itemnumber,
                       brc.displayname AS itemdesc, i.itemtype AS itemtype,
                       brc.bomquantity AS qty, brc.itemsource AS source
                FROM bomrevisioncomponent brc
                JOIN item i ON i.id = brc.item
                WHERE brc.bomrevision = ${parseInt(unit.revId, 10)}
                ORDER BY brc.lineid`
      }).asMappedResults().map(r => ({
        itemId: r.itemid,
        itemNumber: r.itemnumber,
        desc: r.itemdesc || '',
        itemType: r.itemtype || '',
        quantity: r.qty,
        itemSource: r.source || 'STOCK'
      }));
    } catch (e) {
      warnings.push('Could not read components for ' + partNum + '.');
    }

    if (CFG.BUILDS_ROUTING[fam]) {
      try {
        const rr = query.runSuiteQL({
          query: `SELECT id, name FROM ManufacturingRouting
                  WHERE billofmaterials = ${parseInt(bomId, 10)}
                    AND isdefault = 'T' AND isinactive = 'F'`
        }).asMappedResults();
        if (rr[0]) {
          unit.routingId = rr[0].id;
          unit.routingName = rr[0].name;
          unit.steps = query.runSuiteQL({
            query: `SELECT operationsequence, operationname, manufacturingworkcenter,
                           manufacturingcosttemplate, runrate, setuptime
                    FROM ManufacturingRoutingRoutingStep
                    WHERE manufacturingrouting = ${parseInt(unit.routingId, 10)}
                    ORDER BY operationsequence`
          }).asMappedResults().map(r => ({
            sequence: r.operationsequence,
            operationName: r.operationname,
            workCenterId: r.manufacturingworkcenter || '',
            costTemplateId: r.manufacturingcosttemplate || '',
            runRate: r.runrate || 0,
            setupTime: r.setuptime || 0
          }));
        }
      } catch (e) {
        log.audit({ title: 'loadFamilyUnit — routing read failed', details: partNum + ': ' + e.toString() });
      }
    }

    return unit;
  }

  // Pulls just the BOM components and routing steps off ANY existing item, by
  // part number, so a family with no BOM of its own — the exact scenario the
  // "no BOM" fix above leaves the person to fill in — can start from a
  // similar part's setup instead of building every row from scratch. The job
  // left is adjusting quantities.
  //
  // Reuses loadFamilyUnit rather than re-implementing the BOM/revision/
  // routing reads. Passing fam='F' (which has BUILDS_ROUTING true) forces the
  // routing read regardless of what family the source item actually belongs
  // to — harmless when the source has none (routing just comes back empty),
  // and exactly what's needed when it does. Nothing about the source item is
  // touched; this only reads.
  function loadPartForCopy(term) {
    const t = String(term || '').trim().toUpperCase();
    if (!t) return { ok: false, message: 'Enter a part number.' };
    const found = checkPartNumbers([t]);
    const itemId = found[t];
    if (!itemId) return { ok: false, message: t + ' was not found.' };

    const warnings = [];
    const unit = loadFamilyUnit('F', t, itemId, warnings);
    if (!unit) return { ok: false, message: 'Could not read ' + t + '.' };
    if (!unit.bomId) return { ok: false, message: t + ' has no BOM to copy from.' };

    return {
      ok: true,
      partNumber: t,
      components: unit.components || [],
      steps: unit.steps || [],
      bomName: unit.bomName || '',
      revName: unit.revName || ''
    };
  }

  function safeGet(item, fieldId) {
    if (!fieldId) return '';
    try {
      const v = item.getValue({ fieldId: fieldId });
      return (v === null || v === undefined) ? '' : v;
    } catch (e) { return ''; }
  }

  // Sorts NetSuite's MM/DD/YYYY strings without depending on locale parsing.
  // Unparseable values sort oldest so they never win "current revision" by
  // accident.
  function dateSortKey(s) {
    if (!s) return 0;
    const m = String(s).trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (m) return (+m[3]) * 10000 + (+m[1]) * 100 + (+m[2]);
    const d = new Date(s);
    return isNaN(d.getTime()) ? 0 : d.getTime();
  }

  // ─── THE BUILD ────────────────────────────────────────────────────────────
  // One family unit: BOM -> item (BOM attached inline) -> revision -> routing
  // -> optional BOM scoping. Everything created is pushed onto `created` so
  // the caller can unwind the WHOLE door, not just this family.
  function buildUnit(o) {
    const created = o.created;
    const res = { family: o.family, name: o.partNum };

    // BOM first, so it can be attached during the item's own save.
    const bomName = o.partNum + ' BOM';
    const bomId = createBom(bomName, o.subsidiaryId);
    created.push({ type: record.Type.BOM, id: bomId });
    res.bom = { id: bomId, name: bomName, restricted: false };
    if (o.timer) o.timer.mark(o.family + '.bom');

    const itemOut = {};
    const itemId = createAssemblyItem({
      family: o.family,
      partNum: o.partNum,
      description: o.description,
      defaults: o.defaults,
      subsidiaryId: o.subsidiaryId,
      classId: o.classId,
      cutDetails: o.cutDetails,
      doorLine: o.doorLine,
      purchasePrice: o.purchasePrice,
      bomId: bomId,
      out: itemOut
    });
    created.push({ type: record.Type.ASSEMBLY_ITEM, id: itemId });
    res.item = itemOut.item;
    res.item.id = itemId;
    if (o.timer) o.timer.mark(o.family + '.item');

    // BOM revision + components
    const revName = o.partNum + CFG.REV_NAME_SEP[o.family] + (o.revLetter || 'A').toUpperCase();
    const rev = record.create({ type: record.Type.BOM_REVISION, isDynamic: false });
    rev.setValue({ fieldId: 'billofmaterials', value: bomId });
    rev.setValue({ fieldId: 'name', value: revName });
    rev.setValue({ fieldId: 'effectivestartdate', value: o.effectiveDate });
    if (o.revMemo) rev.setValue({ fieldId: 'memo', value: o.revMemo });

    writeRevisionComponents(rev, o.components, o.autoIssue);

    const revId = rev.save({ enableSourcing: CFG.ENABLE_SOURCING });
    created.push({ type: record.Type.BOM_REVISION, id: revId });
    res.revision = { id: revId, name: revName, lines: o.components.length };
    if (o.timer) o.timer.mark(o.family + '.revision');

    // Routing — doors themselves never get one.
    if (CFG.BUILDS_ROUTING[o.family] && o.steps && o.steps.length) {
      const routingName = o.partNum + ' ROUTING';
      const routing = record.create({ type: record.Type.MANUFACTURING_ROUTING, isDynamic: false });
      routing.setValue({ fieldId: 'name', value: routingName });
      routing.setValue({ fieldId: 'billofmaterials', value: bomId });
      routing.setValue({ fieldId: 'isdefault', value: true });
      if (o.subsidiaryId) routing.setValue({ fieldId: 'subsidiary', value: o.subsidiaryId });
      if (o.locationId)   routing.setValue({ fieldId: 'location', value: o.locationId });

      writeRoutingSteps(routing, o.steps);

      const routingId = routing.save({ enableSourcing: CFG.ENABLE_SOURCING });
      created.push({ type: record.Type.MANUFACTURING_ROUTING, id: routingId });
      res.routing = { id: routingId, name: routingName, steps: o.steps.length };
      if (o.timer) o.timer.mark(o.family + '.routing');
    }

    if (CFG.RESTRICT_BOM_TO_ASSEMBLY) {
      res.bom.restricted = restrictBomToAssembly(bomId, itemId);
      if (o.timer) o.timer.mark(o.family + '.bomScope');
    }

    return res;
  }

  function buildDoor(p) {
    const created = [];   // { type, id } — unwound newest-first on failure
    const out = { families: {} };
    const t0 = Date.now();
    const timer = makeTimer();

    try {
      // ── Validate ───────────────────────────────────────────────────────
      const series = String(p.series || '').trim();
      if (!series) throw new Error('Pick a door series.');

      // A template is an ordinary door family with a word where the number
      // goes. Everything downstream — BOM names, revision names, routing
      // names, field inheritance, rollback — is identical.
      const asTemplate = !!p.asTemplate;
      let number, tail;

      if (asTemplate) {
        if (!CFG.ALLOW_TEMPLATE_CREATION) {
          throw new Error('Creating templates from this form is turned off (CFG.ALLOW_TEMPLATE_CREATION).');
        }
        const tag = String(p.templateTag || '').trim().toUpperCase();
        if (tag) {
          if (tag.length > CFG.TEMPLATE_TAG_MAX) {
            throw new Error('The tag is too long — keep it under ' + CFG.TEMPLATE_TAG_MAX + ' characters.');
          }
          if (!CFG.TEMPLATE_TAG_PATTERN.test(tag)) {
            throw new Error('The tag can only use letters, digits and dashes. "' + tag + '" does not.');
          }
          if (normName(tag) === normName(CFG.TEMPLATE_SUFFIX)) {
            throw new Error('The tag cannot itself be "' + CFG.TEMPLATE_SUFFIX + '".');
          }
        }
        tail = (tag ? tag + '-' : '') + CFG.TEMPLATE_SUFFIX;
        number = tail;
      } else {
        number = String(p.number || '').trim();
        if (!number) throw new Error('Door number is required.');
        if (!/^[0-9]+$/.test(number)) throw new Error('Door number must be digits only.');
        tail = number;
      }

      let description = String(p.description || '').trim();
      if (!description) throw new Error('Description is required.');
      // The description opens with the series on 3,126 of 3,182 live doors.
      // Prepend it if the person didn't, rather than nagging about it.
      if (CFG.SERIES_IN_DESC && description.indexOf(series) !== 0) {
        description = series + ' ' + description;
      }
      // Templates carry the marker on the front, which is what lets the fill
      // path strip it back off and hand you a usable starting description.
      if (asTemplate && !CFG.TEMPLATE_DESC_MARKER.test(description)) {
        description = CFG.TEMPLATE_SUFFIX + ' - ' + description;
      }

      const wantScreen = !!p.includeScreen;
      const families = ['F', 'C'].concat(wantScreen ? ['S'] : []);

      // The tube frame's number is typed, not derived — engineering assigns it
      // before the door reaches NetSuite. Validated here rather than trusted,
      // because it becomes an item name.
      const wantTube = !!p.includeTube;
      let tubeNumber = '';
      if (wantTube) {
        tubeNumber = String(p.tubeNumber || '').trim().toUpperCase();
        if (!tubeNumber) {
          throw new Error('Tube frame number is required — it is the number engineering assigned.');
        }
        if (tubeNumber.length > CFG.TUBE_NUMBER_MAX) {
          throw new Error('Tube frame number is too long — keep it under ' +
                          CFG.TUBE_NUMBER_MAX + ' characters.');
        }
        if (!CFG.TUBE_NUMBER_PATTERN.test(tubeNumber)) {
          throw new Error('The tube frame number can only use letters, digits and dashes. "' +
                          tubeNumber + '" does not.');
        }
      }

      const nums = familyNumbers(series, tail);
      const wanted = families.concat(['DR']).map(f => nums[f]);
      // The tube goes in the same lookup so it costs no extra round trip, but
      // it is NOT a clash if it comes back — see below.
      const existing = checkPartNumbers(wanted.concat(wantTube ? [tubeNumber] : []));
      const clashes = wanted.filter(n => existing[n.toUpperCase()]);
      if (clashes.length) {
        throw new Error(
          clashes.join(', ') + (clashes.length > 1 ? ' already exist.' : ' already exists.') +
          (asTemplate
            ? ' Add a tag to tell them apart, or load that template and edit it instead.'
            : ' Pick a different door number — the next free one is ' + (nextDoorNumber() || 'unknown') + '.')
        );
      }

      // An existing tube number is not a clash. Engineering creates the tube
      // record ahead of the door often enough that failing on it would be
      // wrong — it gets linked onto the core untouched instead. Nothing about
      // that record is edited, because it is not this build's to edit.
      const tubeExistingId = wantTube ? (existing[tubeNumber.toUpperCase()] || '') : '';
      if (wantTube && tubeExistingId && !CFG.TUBE_LINK_IF_EXISTS) {
        throw new Error(tubeNumber + ' already exists. Pick a different tube frame number.');
      }

      // ── Per-family payloads off the form ───────────────────────────────
      const inbound = p.families || {};

      // A tube being LINKED has no grids to validate — the record already
      // exists and this build does not touch it.
      if (wantTube && !tubeExistingId) {
        const tf = inbound.T || {};
        const tcomps = (tf.components || []).filter(c => c.itemId);
        if (!tcomps.length) {
          throw new Error(FAMILY_LABEL.T + ' needs at least one component.');
        }
        const tsteps = (tf.steps || []).filter(st => st.operationName);
        if (!tsteps.length) {
          throw new Error(FAMILY_LABEL.T + ' needs at least one routing step.');
        }
        validateSequences(tsteps, FAMILY_LABEL.T);
      }

      for (const f of families) {
        const fam = inbound[f] || {};
        const comps = (fam.components || []).filter(c => c.itemId);
        if (!comps.length) {
          throw new Error(FAMILY_LABEL[f] + ' needs at least one component.');
        }
        const steps = (fam.steps || []).filter(s => s.operationName);
        if (!steps.length) {
          throw new Error(FAMILY_LABEL[f] + ' needs at least one routing step.');
        }
        validateSequences(steps, FAMILY_LABEL[f]);
      }

      timer.mark('validate');

      // ── Shared context ─────────────────────────────────────────────────
      // Field inheritance comes from whichever template the person picked. It
      // is re-resolved here rather than trusted from the form, so a template
      // renamed or inactivated between page load and submit fails loudly
      // instead of cloning a record that no longer means what it did.
      const tpl = p.templateKey ? findTemplate(p.templateKey) : null;
      if (p.templateKey && !tpl) {
        throw new Error('Template "' + p.templateKey + '" is no longer available. ' +
                        'Reload the page and pick again.');
      }

      // Copying an existing door. Its own items are the right thing to inherit
      // from: a second door for the same RV differs from its sibling in a size
      // or a hinge hand and in nothing else, so the sibling is a far closer
      // starting point than a generic series template. Resolved server-side
      // from the number rather than trusted from the form, same as a template.
      const src = p.sourceDoor ? resolveDoorItems(p.sourceDoor) : null;
      if (p.sourceDoor && !src) {
        throw new Error('Could not find ' + p.sourceDoor + ' to copy from. ' +
                        'Load that door again and press Copy to new door.');
      }

      const templateItems = {};
      for (const f of families.concat(['DR'])) {
        templateItems[f] = (src && src.items[f]) ||
                           (tpl && tpl.items[f]) ||
                           (CFG.FALLBACK_TEMPLATE_ITEMS || {})[f] || '';
      }
      // A source or template with no screen still needs SOMETHING for the
      // screen's item fields. Its own frame is the right stand-in — every one
      // of the 102 live screens matches its frame field for field.
      if (families.indexOf('S') !== -1 && !((src && src.items.S) || (tpl && tpl.items.S))) {
        templateItems.S = templateItems.F || templateItems.S;
      }
      // Same reasoning for the tube: it is welded extrusion that costs like a
      // frame and routes like a frame, so the frame is what it should inherit
      // its accounts, units and costing method from.
      if (wantTube) {
        templateItems.T = templateItems.F || '';
      }

      // Same stamp as the fill payload, so a source or template edited in
      // NetSuite between builds does not hand the next door a stale field
      // snapshot. templateStamp derives every record name from .key, and a
      // door family is named on exactly the same pattern as a template one,
      // so a source door stamps without any special casing.
      const stampSubject = src || tpl;
      const tplStamp = stampSubject ? templateStamp(stampSubject) : '';
      const defaults = {};
      for (const f of families.concat(['DR'], wantTube ? ['T'] : [])) {
        defaults[f] = getTemplateDefaultsById(templateItems[f], tplStamp);
      }
      out.templateUsed = src ? src.key : (tpl ? tpl.key : null);
      out.copiedFrom = src ? src.key : null;
      timer.mark('template');

      let subsidiaryId = CFG.SUBSIDIARY_ID;
      for (const f of families.concat(['DR'])) {
        if (defaults[f] && defaults[f].subsidiary) { subsidiaryId = defaults[f].subsidiary; break; }
      }
      if (!subsidiaryId) {
        throw new Error('No subsidiary resolved. Check the template items or set CFG.SUBSIDIARY_ID.');
      }

      const locationId = p.locationId || CFG.LOCATION_ID;

      // Class: whatever the form sent, else the series default resolved by
      // name against this account's own class list.
      let classId = p.classId ? String(p.classId).trim() : '';
      if (!classId) {
        const seriesRow = SERIES.filter(s => s.code === series)[0];
        if (seriesRow) classId = matchNameToId(listClasses(), seriesRow.cls);
        if (!classId && seriesRow) {
          log.audit({
            title: 'series class not resolved',
            details: 'series ' + series + ' wanted class "' + seriesRow.cls +
                     '" — falling back to the template value'
          });
        }
      }

      const effectiveDate = p.effectiveDate
        ? format.parse({ value: p.effectiveDate, type: format.Type.DATE })
        : offsetDate(CFG.EFFECTIVE_DATE_OFFSET_DAYS);

      const cutDetails = String(p.cutDetails == null ? '' : p.cutDetails);
      const doorLine = p.doorLine ? String(p.doorLine).trim() : '';
      const purchasePrice = p.purchasePrice != null ? String(p.purchasePrice).trim() : '';

      // ── 1. The tube frame, before anything else ────────────────────────
      // It goes first because the CORE's BOM consumes it, and the core cannot
      // be built until the tube has an internal ID. This is the level the tube
      // belongs at: it stiffens the core, so the core is what should call for
      // it. Hanging it off the door — which is how all 61 existing ones were
      // done — made the door consume a core part directly.
      let tubeItemId = '';
      if (wantTube) {
        if (tubeExistingId) {
          tubeItemId = String(tubeExistingId);
          out.tubeLinked = true;
        } else {
          const tf = inbound.T || {};
          const tubeBuilt = buildUnit({
            timer, family: 'T', created,
            partNum: tubeNumber,
            description: CFG.DESC_PREFIX.T + description,
            defaults: defaults.T,
            subsidiaryId, locationId, classId,
            cutDetails: '',    // the cut list lives on the door only
            doorLine: doorLine,
            purchasePrice: '', // purchase price lives on the door only
            components: (tf.components || []).filter(c => c.itemId),
            steps: (tf.steps || []).filter(st => st.operationName),
            effectiveDate,
            revLetter: p.revLetter,
            revMemo: p.revMemo,
            autoIssue: p.autoIssue
          });
          tubeItemId = tubeBuilt.item.id;
          out.families.T = tubeBuilt;
          out.tubeLinked = false;
        }
        out.tubeNumber = tubeNumber;
      }

      // ── 2. Sub-assemblies — the door's BOM needs their IDs ─────────────
      const built = {};
      for (const f of families) {
        const fam = inbound[f] || {};
        let comps = (fam.components || []).filter(c => c.itemId);
        // The tube rides at the TOP of the core's BOM, ahead of the loose
        // stock, the same way the sub-assemblies lead the door's own BOM.
        if (f === 'C' && tubeItemId) {
          comps = [{
            itemId: tubeItemId,
            quantity: CFG.TUBE_QTY,
            itemSource: CFG.TUBE_SOURCE
          }].concat(comps);
        }
        built[f] = buildUnit({
          timer, family: f, created,
          partNum: nums[f],
          description: CFG.DESC_PREFIX[f] + description,
          defaults: defaults[f],
          subsidiaryId, locationId, classId,
          cutDetails: '',     // the cut list lives on the door only
          doorLine: doorLine,
          purchasePrice: '', // purchase price lives on the door only
          components: comps,
          steps: (fam.steps || []).filter(s => s.operationName),
          effectiveDate,
          revLetter: p.revLetter,
          revMemo: p.revMemo,
          autoIssue: p.autoIssue
        });
        out.families[f] = built[f];
      }

      // ── 3. The door, consuming them ────────────────────────────────────
      const drFam = inbound.DR || {};
      const subLines = [];
      for (const f of CFG.DR_COMPONENT_ORDER) {
        if (!built[f]) continue;
        subLines.push({
          itemId: built[f].item.id,
          quantity: 1,
          itemSource: CFG.DR_SUBASSEMBLY_SOURCE
        });
      }
      const drComponents = subLines.concat(
        (drFam.components || []).filter(c => c.itemId)
      );
      if (!drComponents.length) {
        throw new Error('The door has no components — nothing to build it from.');
      }

      out.families.DR = buildUnit({
        timer, family: 'DR', created,
        partNum: nums.DR,
        description: description,
        defaults: defaults.DR,
        subsidiaryId, locationId, classId,
        cutDetails: cutDetails,
        doorLine: doorLine,
        purchasePrice: purchasePrice,
        components: drComponents,
        steps: [],           // doors have no routing, by design
        effectiveDate,
        revLetter: p.revLetter,
        revMemo: p.revMemo,
        autoIssue: p.autoIssue
      });

      out.ok = true;
      out.series = series;
      out.number = number;
      out.asTemplate = asTemplate;
      out.doorNumber = nums.DR;
      out.description = description;
      out.ms = Date.now() - t0;

      // A template nobody can pick isn't a template. Drop the discovery cache
      // so the new one is visible to the next page load, and hand the client
      // enough to add it to the picker without a round trip.
      if (asTemplate) {
        dropTemplateCache();
        const items = { DR: String(out.families.DR.item.id) };
        for (const f of families) items[f] = String(out.families[f].item.id);
        out.newTemplate = {
          key: nums.DR,
          label: nums.DR,
          series: series,
          classId: classId || '',
          items: items,
          families: ALL_FAMILIES.filter(f => items[f])
        };
      }

      if (CFG.LOG_TIMINGS) {
        log.audit({
          title: (asTemplate ? 'template' : 'door') + ' build timing ' + nums.DR +
                 ' (' + out.ms + 'ms total)',
          details: timer.report() +
                   '  | sourcing=' + (CFG.ENABLE_SOURCING ? 'on' : 'off') +
                   ' bomScope=' + (CFG.RESTRICT_BOM_TO_ASSEMBLY ? 'on' : 'off') +
                   ' families=' + families.concat(['DR']).join('/')
        });
        out.timing = timer.report();
      }

      const subCount = families.length;
      const tubeNote = !wantTube ? ''
        : (out.tubeLinked
            ? ' Existing tube ' + tubeNumber + ' linked onto the core.'
            : ' Tube ' + tubeNumber + ' created on the core.');
      out.message = asTemplate
        ? 'Template ' + nums.DR + ' created — pick it from the list to build doors from it.'
        : nums.DR + ' created with ' + subCount + ' sub-assembl' +
          (subCount === 1 ? 'y' : 'ies') + '.' + tubeNote;
      return out;

    } catch (e) {
      log.error({ title: 'buildDoor failed — rolling back', details: e.toString() + ' | ' + (e.stack || '') });
      const undone = rollback(created);
      return { ok: false, message: e.message || String(e), rolledBack: undone };
    }
  }

  // One step per sequence, per routing. NetSuite refuses a duplicate and the
  // message it gives back is far less useful than this one.
  function validateSequences(steps, label) {
    const seen = {};
    for (const s of steps) {
      const seq = String(s.sequence || '').trim();
      if (!seq) throw new Error(label + ': every routing step needs an operation sequence.');
      if (seen[seq]) {
        throw new Error(
          label + ': ' + seen[seq] + ' and ' + s.operationName + ' are both on sequence ' + seq +
          '. NetSuite needs one step per sequence — change one of them.'
        );
      }
      seen[seq] = s.operationName;
    }
  }

  // Writes component lines onto a BOM_REVISION record (new or freshly loaded).
  // Shared by the build, Update Fields, and New BOM Rev, so the auto-issue
  // resolution and line-writing exist once instead of three times.
  function writeRevisionComponents(rev, components, autoIssue, ops) {
    const wantAutoIssue = autoIssue !== false;
    // ops = { field, map } captured before the lines were cleared, so each
    // component goes back onto the routing step it was already tied to.
    const opsField = (ops && ops.field) ? ops.field : null;
    const opsMap = (ops && ops.map) ? ops.map : null;
    let autoIssueField = null;
    let autoIssueFields = [];
    let autoIssueTried = false;

    components.forEach((c, i) => {
      rev.setSublistValue({ sublistId: 'component', fieldId: 'item', line: i, value: c.itemId });
      rev.setSublistValue({
        sublistId: 'component', fieldId: 'bomquantity', line: i,
        value: parseFloat(c.quantity) || 1
      });
      rev.setSublistValue({
        sublistId: 'component', fieldId: 'itemsource', line: i,
        value: c.itemSource || 'STOCK'
      });

      if (opsField && opsMap) {
        const seq = opsMap[String(c.itemId)];
        if (seq !== undefined && seq !== null && seq !== '') {
          try {
            rev.setSublistValue({ sublistId: 'component', fieldId: opsField, line: i, value: seq });
          } catch (e) {
            log.audit({ title: 'operation sequence set failed on line ' + i, details: e.toString() });
          }
        }
      }

      if (wantAutoIssue) {
        if (!autoIssueTried) {
          const r = resolveAutoIssueField(rev, i);
          autoIssueField = r.field;
          autoIssueFields = r.available || [];
          autoIssueTried = true;
        } else if (autoIssueField) {
          try {
            rev.setSublistValue({
              sublistId: 'component', fieldId: autoIssueField, line: i, value: true
            });
          } catch (e) {
            log.audit({ title: 'auto-issue set failed on line ' + i, details: e.toString() });
          }
        }
      }
    });

    return {
      autoIssue: wantAutoIssue ? (autoIssueField ? autoIssueField : 'unavailable') : false,
      componentFields: (wantAutoIssue && !autoIssueField) ? autoIssueFields : null
    };
  }

  function writeRoutingSteps(routing, steps) {
    steps.forEach((s, i) => {
      routing.setSublistValue({
        sublistId: 'routingstep', fieldId: 'operationsequence', line: i,
        value: parseInt(s.sequence, 10)
      });
      routing.setSublistValue({
        sublistId: 'routingstep', fieldId: 'operationname', line: i,
        value: s.operationName
      });
      if (s.workCenterId) {
        routing.setSublistValue({
          sublistId: 'routingstep', fieldId: 'manufacturingworkcenter', line: i,
          value: s.workCenterId
        });
      }
      if (s.costTemplateId) {
        routing.setSublistValue({
          sublistId: 'routingstep', fieldId: 'manufacturingcosttemplate', line: i,
          value: s.costTemplateId
        });
      }
      routing.setSublistValue({
        sublistId: 'routingstep', fieldId: 'runrate', line: i,
        value: parseFloat(s.runRate) || 0
      });
      routing.setSublistValue({
        sublistId: 'routingstep', fieldId: 'setuptime', line: i,
        value: parseFloat(s.setupTime) || 0
      });
    });
  }

  // Creates the assembly item. Template fields go on FIRST, then everything
  // typed on the form, so a template value can never overwrite user input.
  // The BOM is attached inline during this same save — no reload, no re-save.
  function createAssemblyItem(o) {
    const item = record.create({ type: record.Type.ASSEMBLY_ITEM, isDynamic: false });
    applyDefaults(item, o.defaults);

    item.setValue({ fieldId: 'itemid', value: o.partNum });
    const descFields = setDescriptions(item, o.description);
    if (!descFields.length) {
      throw new Error(
        'Could not write the description to any of: ' + CFG.DESCRIPTION_FIELDS.join(', ') +
        '. Check CFG.DESCRIPTION_FIELDS against your item form.'
      );
    }
    if (o.subsidiaryId) item.setValue({ fieldId: 'subsidiary', value: [o.subsidiaryId] });

    // Location is what actually marks this as a door part — every one of the
    // 5,588 live door items carries both fields set to GEN-Y DOOR.
    if (CFG.LOCATION_ID) {
      try { item.setValue({ fieldId: 'location', value: CFG.LOCATION_ID }); }
      catch (e) { log.audit({ title: 'location set failed', details: e.toString() }); }
      if (CFG.SET_PREFERRED_LOCATION) {
        try { item.setValue({ fieldId: 'preferredlocation', value: CFG.LOCATION_ID }); }
        catch (e) { log.audit({ title: 'preferredlocation set failed', details: e.toString() }); }
      }
    }

    if (o.bomId) {
      item.setSublistValue({
        sublistId: 'billofmaterials', fieldId: 'billofmaterials', line: 0, value: o.bomId
      });
      item.setSublistValue({
        sublistId: 'billofmaterials', fieldId: 'masterdefault', line: 0, value: true
      });
    }

    // Everything the person chose goes on LAST, so nothing from the template
    // can override it — same reasoning as the description.
    const applied = [];
    if (o.classId) {
      try { item.setValue({ fieldId: 'class', value: o.classId }); applied.push('class'); }
      catch (e) { log.audit({ title: 'class set failed', details: e.toString() }); }
    }
    if (o.cutDetails && CFG.CUT_DETAILS_FIELD) {
      try { item.setValue({ fieldId: CFG.CUT_DETAILS_FIELD, value: o.cutDetails }); applied.push('cut details'); }
      catch (e) { log.audit({ title: 'cut details set failed', details: e.toString() }); }
    }
    if (o.doorLine && CFG.DOOR_LINE_FIELD) {
      try { item.setValue({ fieldId: CFG.DOOR_LINE_FIELD, value: o.doorLine }); applied.push('door line'); }
      catch (e) { log.audit({ title: 'door line set failed', details: e.toString() }); }
    }
    if (o.purchasePrice && CFG.PURCHASE_PRICE_FIELD) {
      const pp = parseFloat(o.purchasePrice);
      if (!isNaN(pp)) {
        try { item.setValue({ fieldId: CFG.PURCHASE_PRICE_FIELD, value: pp }); applied.push('purchase price'); }
        catch (e) { log.audit({ title: 'purchase price set failed', details: e.toString() }); }
      }
    }

    o.out.item = { name: o.partNum, family: o.family, descriptionFields: descFields, fields: applied };
    return item.save({ ignoreMandatoryFields: false, enableSourcing: CFG.ENABLE_SOURCING });
  }

  // Created available to all assemblies so it's immediately valid to attach to
  // the new item; scoping happens after, via restrictBomToAssembly().
  // Component yield is off on all 3,556 live door BOMs, so it isn't offered.
  function createBom(name, subsidiaryId) {
    const b = record.create({ type: record.Type.BOM, isDynamic: false });
    b.setValue({ fieldId: 'name', value: name });
    b.setValue({ fieldId: 'usecomponentyield', value: false });
    b.setValue({ fieldId: 'availableforalllocations', value: true });
    b.setValue({ fieldId: 'availableforallassemblies', value: true });
    if (subsidiaryId) b.setValue({ fieldId: 'subsidiary', value: [subsidiaryId] });
    return b.save({ enableSourcing: CFG.ENABLE_SOURCING });
  }

  // Narrows the BOM to the one assembly it belongs to — the convention on
  // every door BOM in the account. Best-effort: the restriction sublist ID
  // varies, and everything is already built and linked by this point, so a
  // failure just leaves the BOM open rather than failing the build.
  function restrictBomToAssembly(bomId, assemblyItemId) {
    for (const sublistId of CFG.BOM_RESTRICT_SUBLISTS) {
      try {
        const b = record.load({ type: record.Type.BOM, id: bomId, isDynamic: false });
        b.setValue({ fieldId: 'availableforallassemblies', value: false });
        b.setSublistValue({
          sublistId: sublistId, fieldId: 'assembly', line: 0, value: assemblyItemId
        });
        b.save();
        return true;
      } catch (e) {
        log.audit({
          title: 'BOM restriction attempt failed (' + sublistId + ')',
          details: e.toString()
        });
      }
    }
    log.audit({ title: 'BOM left available to all assemblies', details: 'no restriction sublist matched' });
    return false;
  }

  function resolveAutoIssueField(rev, line) {
    let available = [];
    try {
      available = rev.getSublistFields({ sublistId: 'component' }) || [];
    } catch (e) {
      log.audit({ title: 'getSublistFields failed', details: e.toString() });
    }

    const discovered = available.filter(f => /auto.?issue/i.test(f));
    const candidates = [];
    for (const f of CFG.AUTO_ISSUE_FIELDS) if (candidates.indexOf(f) === -1) candidates.push(f);
    for (const f of discovered) if (candidates.indexOf(f) === -1) candidates.push(f);

    for (const f of candidates) {
      if (available.length && available.indexOf(f) === -1) continue;
      try {
        rev.setSublistValue({ sublistId: 'component', fieldId: f, line: line, value: true });
        const back = rev.getSublistValue({ sublistId: 'component', fieldId: f, line: line });
        if (back === true || back === 'T' || back === 'true') {
          return { field: f, available: available };
        }
      } catch (e) { /* not this one */ }
    }

    log.audit({
      title: 'auto-issue not available',
      details: 'tried ' + candidates.join(', ') + ' — components saved without it'
    });
    return { field: null, available: available };
  }

  function resolveOpSeqField(rev) {
    let available = [];
    try { available = rev.getSublistFields({ sublistId: 'component' }) || []; }
    catch (e) { log.audit({ title: 'getSublistFields failed (opseq)', details: e.toString() }); }

    const discovered = available.filter(f => /operation.*sequence|opseq/i.test(f));
    if (discovered.length) return discovered[0];

    for (const f of CFG.COMPONENT_OPSEQ_FIELDS) {
      if (available.length && available.indexOf(f) === -1) continue;
      try {
        const v = rev.getSublistValue({ sublistId: 'component', fieldId: f, line: 0 });
        if (v !== undefined) return f;
      } catch (e) { /* not this one */ }
    }
    return null;
  }

  // Reads the operation sequence off every component line, keyed by item, so
  // the links survive the clear-and-rewrite that Update Fields does. Without
  // this, rewriting components silently unlinks them from their routing steps.
  function captureComponentOps(rev) {
    const field = resolveOpSeqField(rev);
    const map = {};
    if (!field) return { field: null, map: map };
    let lines = 0;
    try { lines = rev.getLineCount({ sublistId: 'component' }); }
    catch (e) { return { field: field, map: map }; }
    for (let i = 0; i < lines; i++) {
      try {
        const itemId = rev.getSublistValue({ sublistId: 'component', fieldId: 'item', line: i });
        const seq = rev.getSublistValue({ sublistId: 'component', fieldId: field, line: i });
        const n = parseInt(seq, 10);
        if (itemId && !isNaN(n)) map[String(itemId)] = n;
      } catch (e) { /* skip this line */ }
    }
    return { field: field, map: map };
  }

  // Any captured link pointing at a sequence that no longer exists is pulled
  // to the nearest surviving step, so a rewritten component can never
  // reintroduce the reference the routing save just rejected.
  function clampOps(ops, validSeqs) {
    if (!ops || !ops.field || !validSeqs || !validSeqs.length) return ops;
    for (const k in ops.map) {
      const n = parseInt(ops.map[k], 10);
      if (isNaN(n)) { delete ops.map[k]; continue; }
      if (validSeqs.indexOf(n) === -1) ops.map[k] = nearestSeq(n, validSeqs);
    }
    return ops;
  }

  // Where a component should point once its own sequence is gone: the nearest
  // remaining step at or before it, so material still gets issued no later
  // than it used to. If every remaining step is later, take the first.
  function nearestSeq(oldSeq, validSeqs) {
    const below = validSeqs.filter(v => v <= oldSeq);
    if (below.length) return Math.max.apply(null, below);
    return Math.min.apply(null, validSeqs);
  }

  // Before a routing step is deleted, repoint every component on the BOM that
  // still references its sequence. This is what the NetSuite UI asks you to
  // confirm when it shows "Invalid Operation Sequence Number" — the script has
  // to decide it up front instead. Every ACTIVE revision on the BOM is swept,
  // not just the current one: the routing belongs to the BOM, so a stale
  // reference on any revision blocks the save.
  function remapComponentOperations(bomId, validSeqs, removedSeqs) {
    const changes = [];
    if (!bomId || !validSeqs.length || !removedSeqs.length) return changes;

    let revIds = [];
    try {
      revIds = query.runSuiteQL({
        query: `SELECT id, name FROM bomrevision
                WHERE billofmaterials = ${parseInt(bomId, 10)} AND isinactive = 'F'`
      }).asMappedResults();
    } catch (e) {
      log.error({ title: 'remapComponentOperations — revision list failed', details: e.toString() });
      return changes;
    }

    for (const row of revIds) {
      let rev;
      try {
        rev = record.load({ type: record.Type.BOM_REVISION, id: row.id, isDynamic: false });
      } catch (e) { continue; }
      const field = resolveOpSeqField(rev);
      if (!field) continue;

      let lines = 0;
      try { lines = rev.getLineCount({ sublistId: 'component' }); } catch (e) { continue; }

      let touched = false;
      for (let i = 0; i < lines; i++) {
        let cur;
        try { cur = rev.getSublistValue({ sublistId: 'component', fieldId: field, line: i }); }
        catch (e) { continue; }
        const n = parseInt(cur, 10);
        if (isNaN(n) || removedSeqs.indexOf(n) === -1) continue;

        const to = nearestSeq(n, validSeqs);
        try {
          rev.setSublistValue({ sublistId: 'component', fieldId: field, line: i, value: to });
          touched = true;
          changes.push({ revision: row.name, line: i + 1, from: n, to: to });
        } catch (e) {
          log.audit({ title: 'remap set failed on line ' + i, details: e.toString() });
        }
      }

      if (touched) {
        try { rev.save({ enableSourcing: CFG.ENABLE_SOURCING }); }
        catch (e) {
          log.error({ title: 'remap save failed on revision ' + row.id, details: e.toString() });
        }
      }
    }

    if (changes.length) {
      log.audit({
        title: 'component operation sequences remapped',
        details: changes.map(c => c.revision + ' line ' + c.line + ': ' + c.from + ' -> ' + c.to).join('; ')
      });
    }
    return changes;
  }

  // ─── EDIT MODE — SAVE ─────────────────────────────────────────────────────
  // Item fields and routing steps always save in place. BOM components either
  // overwrite the current revision (asNewRev = false) or land on a freshly
  // opened revision that replaces it (asNewRev = true): the new revision
  // starts yesterday and the one it replaces closes the day before — no
  // overlap, no gap.
  //
  // Families are handled one at a time and each one's outcome is recorded, so
  // a failure on the core doesn't leave you guessing whether the frame saved.
  function updateDoor(p, asNewRev) {
    const t0 = Date.now();
    const done = [];
    const results = {};
    // Records this action CREATED, newest-last, so a failure can unwind them.
    // The door item itself is never in here — it existed before this ran and
    // must survive a rollback untouched.
    const created = [];
    const timer = makeTimer();
    try {
      const doorNumber = String(p.doorNumber || '').trim().toUpperCase();
      let description = String(p.description || '').trim();
      if (!description) throw new Error('Description is required.');

      const inbound = p.families || {};
      // ALL_UNITS, not ALL_FAMILIES — the tube frame is a unit with an item, a
      // BOM, a revision and a routing, and it has to be saved like one.
      const present = ALL_UNITS.filter(f => inbound[f] && inbound[f].itemId);

      // Families the form wants BUILT rather than updated: a door whose frame
      // and core items never existed. Filled from a reference door's grids,
      // then created here from this door's own number. Existing items are
      // never in this list — an item that is already there is left alone and
      // only gets a BOM/routing if it is missing one (see updateFamilyUnit).
      const toCreate = ALL_UNITS.filter(f =>
        inbound[f] && !inbound[f].itemId && inbound[f].create);

      if (!present.length && !toCreate.length) {
        throw new Error('Nothing loaded. Reload the door and try again.');
      }

      // Validate everything BEFORE writing anything. A sequence clash found
      // halfway through is a half-saved door.
      for (const f of present) {
        const fam = inbound[f];
        const comps = (fam.components || []).filter(c => c.itemId);
        const subs = (fam.subLines || []).filter(c => c.itemId);
        // A family with an existing BOM being emptied out is a real mistake
        // and stays blocked. A family with NO BOM and nothing on its grid is
        // not ready to build one yet — that's fine; its item fields (door
        // line, class, cut details, purchase price) still save below, and
        // the BOM waits until components are actually added.
        if (!comps.length && !subs.length && fam.bomId) {
          throw new Error(FAMILY_LABEL[f] + ' has no components.');
        }
        if (CFG.BUILDS_ROUTING[f]) {
          const steps = (fam.steps || []).filter(s => s.operationName);
          validateSequences(steps, FAMILY_LABEL[f]);
        }
        if (asNewRev && fam.bomId) {
          const nm = String(fam.newRevName || '').trim();
          if (!nm) throw new Error(FAMILY_LABEL[f] + ' needs a name for its new revision.');
          if (normName(nm) === normName(fam.revName)) {
            throw new Error(FAMILY_LABEL[f] + ': "' + nm + '" is the current revision\u2019s name.');
          }
        }
      }

      // A family being created from scratch needs a full set of grids — it is
      // a build, not an edit, and the same rules the new-door path enforces
      // apply here for the same reasons.
      for (const f of toCreate) {
        const fam = inbound[f];
        const comps = (fam.components || []).filter(c => c.itemId);
        if (!comps.length) {
          throw new Error(FAMILY_LABEL[f] + ' needs at least one component to be built.');
        }
        if (CFG.BUILDS_ROUTING[f]) {
          const steps = (fam.steps || []).filter(s => s.operationName);
          if (!steps.length) {
            throw new Error(FAMILY_LABEL[f] + ' needs at least one routing step to be built.');
          }
          validateSequences(steps, FAMILY_LABEL[f]);
        }
        if (!String(fam.partNumber || '').trim()) {
          throw new Error('Could not work out a part number for ' + FAMILY_LABEL[f] + '.');
        }
      }
      timer.mark('validate');

      // ── Build the missing sub-assemblies ───────────────────────────────
      // Item fields are inherited from the REFERENCE door's matching family,
      // exactly the way "Copy to new door" inherits from its source — a real
      // sibling is a far closer starting point than a generic template.
      const newSubLines = {};
      let tubeItemId = '';
      if (toCreate.length) {
        const ref = p.referenceDoor ? resolveDoorItems(p.referenceDoor) : null;
        const drItemId = (inbound.DR && inbound.DR.itemId) || '';
        let subsidiaryId = CFG.SUBSIDIARY_ID;
        if (drItemId) {
          try {
            const drItem = record.load({
              type: record.Type.ASSEMBLY_ITEM, id: drItemId, isDynamic: false
            });
            const sv = drItem.getValue({ fieldId: 'subsidiary' });
            subsidiaryId = (Array.isArray(sv) ? sv[0] : sv) || subsidiaryId;
          } catch (e) { /* fall back to CFG */ }
        }

        const refStamp = ref ? templateStamp(ref) : '';

        // The tube goes first when it is being built — the CORE's BOM
        // consumes it, so the core cannot be built until it has an ID. Same
        // ordering the new-door path uses, and the same reason.
        const order = BUILD_ORDER.filter(f => toCreate.indexOf(f) !== -1);
        for (const f of order) {
          const fam = inbound[f];
          const refItemId = (ref && ref.items[f]) ||
                            (ref && ref.items.F) ||   // screen/tube cost like a frame
                            '';
          const defaults = getTemplateDefaultsById(refItemId, refStamp);

          let comps = (fam.components || []).filter(c => c.itemId);
          if (f === 'C' && tubeItemId) {
            comps = [{
              itemId: tubeItemId,
              quantity: CFG.TUBE_QTY,
              itemSource: CFG.TUBE_SOURCE
            }].concat(comps);
          }

          const built = buildUnit({
            timer, family: f, created,
            partNum: String(fam.partNumber).trim().toUpperCase(),
            description: CFG.DESC_PREFIX[f] + description,
            defaults: defaults,
            subsidiaryId: subsidiaryId,
            locationId: CFG.LOCATION_ID,
            classId: p.classId,
            cutDetails: '',     // the cut list lives on the door only
            doorLine: p.doorLine,
            purchasePrice: '',  // purchase price lives on the door only
            components: comps,
            steps: (fam.steps || []).filter(s => s.operationName),
            effectiveDate: offsetDate(CFG.EFFECTIVE_DATE_OFFSET_DAYS),
            revLetter: 'A',
            autoIssue: p.autoIssue
          });

          built.createdNew = true;
          results[f] = built;
          done.push(FAMILY_LABEL[f] + ' built (' + built.name + ')');

          if (f === 'T') tubeItemId = built.item.id;
          // The tube hangs off the CORE, never off the door.
          else newSubLines[f] = { itemId: built.item.id, partNumber: built.name };
        }
      }

      // ── Update everything that already existed ─────────────────────────
      for (const f of present) {
        const fam = inbound[f];
        // A tube just built belongs on the CORE's BOM. When the core is being
        // built too, buildUnit already got the line; when the core ALREADY
        // exists, this is the only place that puts it there — and without it a
        // tube would be created and then belong to nothing.
        if (f === 'C' && tubeItemId) {
          const coreSubs = (fam.subLines || []).filter(c => c.itemId);
          const already = coreSubs.some(c => String(c.itemId) === String(tubeItemId)) ||
                          (fam.components || []).some(c => String(c.itemId) === String(tubeItemId));
          if (!already) {
            fam.subLines = [{
              itemId: tubeItemId,
              quantity: CFG.TUBE_QTY,
              itemSource: CFG.TUBE_SOURCE
            }].concat(coreSubs);
            done.push('Tube frame added to ' + fam.partNumber + '\u2019s BOM');
          }
        }

        // Sub-assemblies just created belong on the door's own BOM. They are
        // appended to the lines the door already had, in the account's usual
        // order, so the door ends up consuming its whole family.
        if (f === 'DR' && Object.keys(newSubLines).length) {
          const existing = (fam.subLines || []).filter(c => c.itemId);
          const have = {};
          for (const c of existing) have[String(c.itemId)] = true;
          const add = [];
          for (const sub of CFG.DR_COMPONENT_ORDER) {
            const nl = newSubLines[sub];
            if (!nl || have[String(nl.itemId)]) continue;
            add.push({ itemId: nl.itemId, quantity: 1, itemSource: CFG.DR_SUBASSEMBLY_SOURCE });
          }
          fam.subLines = add.concat(existing);
        }

        const r = updateFamilyUnit(f, fam, {
          description: CFG.DESC_PREFIX[f] + description,
          classId: p.classId,
          cutDetails: (f === 'DR') ? p.cutDetails : null,
          doorLine: p.doorLine,
          purchasePrice: (f === 'DR') ? p.purchasePrice : null,
          autoIssue: p.autoIssue,
          asNewRev: asNewRev,
          done: done,
          created: created
        });
        results[f] = r;
      }

      const builtNames = toCreate.map(f => FAMILY_LABEL[f].toLowerCase());
      return {
        ok: true,
        ms: Date.now() - t0,
        doorNumber: doorNumber,
        description: description,
        families: results,
        builtFamilies: toCreate,
        message: (builtNames.length
          ? doorNumber + ' — built ' + builtNames.join(', ') + '. '
          : '') +
          (asNewRev
            ? (present.length
                ? 'New revisions opened on ' +
                  present.map(f => FAMILY_LABEL[f].toLowerCase()).join(', ') + '.'
                : '')
            : (present.length ? 'Updated in place.' : ''))
      };

    } catch (e) {
      log.error({ title: 'updateDoor failed', details: e.toString() + ' | ' + (e.stack || '') });
      // Anything this action created is unwound; the door item and everything
      // that already existed is left exactly as it was.
      const undone = rollback(created);
      return {
        ok: false, message: e.message || String(e),
        alreadySaved: done, families: results, rolledBack: undone
      };
    }
  }

  function updateFamilyUnit(f, fam, o) {
    const label = FAMILY_LABEL[f];
    const out = { family: f, partNumber: fam.partNumber };

    // ── 1. Item fields, in place ───────────────────────────────────────
    const item = record.load({ type: record.Type.ASSEMBLY_ITEM, id: fam.itemId, isDynamic: false });
    setDescriptions(item, o.description);
    if (o.classId) {
      try { item.setValue({ fieldId: 'class', value: o.classId }); } catch (e) { /* n/a */ }
    }
    if (o.cutDetails !== null && o.cutDetails !== undefined && CFG.CUT_DETAILS_FIELD) {
      try { item.setValue({ fieldId: CFG.CUT_DETAILS_FIELD, value: String(o.cutDetails) }); }
      catch (e) { /* n/a */ }
    }
    if (o.doorLine && CFG.DOOR_LINE_FIELD) {
      try { item.setValue({ fieldId: CFG.DOOR_LINE_FIELD, value: o.doorLine }); } catch (e) { /* n/a */ }
    }
    if (o.purchasePrice !== null && o.purchasePrice !== undefined && o.purchasePrice !== '' &&
        CFG.PURCHASE_PRICE_FIELD) {
      const pp = parseFloat(o.purchasePrice);
      if (!isNaN(pp)) {
        try { item.setValue({ fieldId: CFG.PURCHASE_PRICE_FIELD, value: pp }); } catch (e) { /* n/a */ }
      }
    }

    // A family loaded with no BOM at all (item exists, nothing attached) gets
    // one built now instead of being silently skipped. Before this fix, a
    // frame or core opened with no BOM would save its item fields above and
    // then hit "no revision loaded" below and stop — the missing BOM layer
    // was never created, on this save or any later one.
    //
    // Components are collected up front because whether there's anything to
    // build a BOM FROM decides which of the two paths below actually runs.
    const components = (fam.subLines || []).filter(c => c.itemId)
      .concat((fam.components || []).filter(c => c.itemId));
    const hadBom = !!fam.bomId;

    // No BOM and nothing on the grid to build one from — not ready yet. Save
    // just the item fields (door line, class, cut details, purchase price)
    // and stop here rather than forcing an empty BOM into existence. Add
    // components to this family's grid on a later save to build it for real.
    if (!hadBom && !components.length) {
      item.save({ ignoreMandatoryFields: false, enableSourcing: CFG.ENABLE_SOURCING });
      o.done.push(label + ' item fields (no BOM yet — add components to build one)');
      out.itemSaved = true;
      out.revision = { skipped: true, reason: 'no BOM and no components to build one from' };
      return out;
    }

    let builtBom = false;
    if (!hadBom) {
      const subVal = item.getValue({ fieldId: 'subsidiary' });
      const subsidiaryId = Array.isArray(subVal) ? subVal[0] : subVal;
      const bomName = fam.partNumber + ' BOM';
      const newBomId = createBom(bomName, subsidiaryId);
      if (o.created) o.created.push({ type: record.Type.BOM, id: newBomId });
      item.setSublistValue({ sublistId: 'billofmaterials', fieldId: 'billofmaterials', line: 0, value: newBomId });
      item.setSublistValue({ sublistId: 'billofmaterials', fieldId: 'masterdefault', line: 0, value: true });
      fam.bomId = newBomId;
      builtBom = true;
      out.bomCreated = { id: newBomId, name: bomName };
      o.done.push(label + ' BOM created');
    }

    item.save({ ignoreMandatoryFields: false, enableSourcing: CFG.ENABLE_SOURCING });
    o.done.push(label + ' item fields');
    out.itemSaved = true;

    if (builtBom && CFG.RESTRICT_BOM_TO_ASSEMBLY) {
      out.bomCreated.restricted = restrictBomToAssembly(fam.bomId, fam.itemId);
    }

    // ── 2. Routing steps ────────────────────────────────────────────────
    const steps = CFG.BUILDS_ROUTING[f] ? (fam.steps || []).filter(s => s.operationName) : [];
    const newSeqs = steps.map(st => parseInt(st.sequence, 10)).filter(n => !isNaN(n));

    if (!fam.routingId && CFG.BUILDS_ROUTING[f] && steps.length) {
      // No routing existed either — same situation as the missing BOM, so it
      // gets built the same way a brand-new door's routing would.
      const routingName = fam.partNumber + ' ROUTING';
      const routing = record.create({ type: record.Type.MANUFACTURING_ROUTING, isDynamic: false });
      routing.setValue({ fieldId: 'name', value: routingName });
      routing.setValue({ fieldId: 'billofmaterials', value: fam.bomId });
      routing.setValue({ fieldId: 'isdefault', value: true });
      writeRoutingSteps(routing, steps);
      const routingId = routing.save({ enableSourcing: CFG.ENABLE_SOURCING });
      if (o.created) o.created.push({ type: record.Type.MANUFACTURING_ROUTING, id: routingId });
      fam.routingId = routingId;
      out.routing = { id: routingId, steps: steps.length, created: true };
      o.done.push(label + ' routing created (' + steps.length + ' step(s))');
    } else if (fam.routingId && steps.length) {
      const routing = record.load({ type: record.Type.MANUFACTURING_ROUTING, id: fam.routingId, isDynamic: false });
      const existingLines = routing.getLineCount({ sublistId: 'routingstep' });

      // Only REMOVALS can strand a component reference; adding or editing
      // steps is harmless.
      const oldSeqs = [];
      for (let i = 0; i < existingLines; i++) {
        const v = parseInt(routing.getSublistValue({
          sublistId: 'routingstep', fieldId: 'operationsequence', line: i
        }), 10);
        if (!isNaN(v)) oldSeqs.push(v);
      }
      const removed = oldSeqs.filter(v => newSeqs.indexOf(v) === -1);
      let remapped = [];
      if (removed.length) remapped = remapComponentOperations(fam.bomId, newSeqs, removed);

      for (let i = existingLines - 1; i >= 0; i--) {
        routing.removeLine({ sublistId: 'routingstep', line: i });
      }
      writeRoutingSteps(routing, steps);
      routing.save({ enableSourcing: CFG.ENABLE_SOURCING });
      out.routing = { id: fam.routingId, steps: steps.length, remapped: remapped.length ? remapped : null };
      o.done.push(label + ' routing (' + steps.length + ' step(s))');
    }

    // ── 3. Components — new BOM/revision gets a fresh one; existing BOM
    //      follows the normal in-place / new-revision logic ─────────────
    // The door's sub-assembly lines are rebuilt from the loaded family rather
    // than from the grid, so nobody can accidentally drop the frame or core
    // out of the door by clearing a row. `components` was already computed
    // above, before the item save, since it decides whether a BOM gets built
    // at all.

    if (builtBom || !fam.revId) {
      // Either the BOM itself is brand new, or it existed with no active
      // revision — either way there is nothing to update in place, so the
      // first revision is created instead of being skipped.
      const revLetter = 'A';
      const revName = fam.partNumber + CFG.REV_NAME_SEP[f] + revLetter;
      const rev = record.create({ type: record.Type.BOM_REVISION, isDynamic: false });
      rev.setValue({ fieldId: 'billofmaterials', value: fam.bomId });
      rev.setValue({ fieldId: 'name', value: revName });
      rev.setValue({ fieldId: 'effectivestartdate', value: offsetDate(CFG.EFFECTIVE_DATE_OFFSET_DAYS) });
      writeRevisionComponents(rev, components, o.autoIssue);
      const revId = rev.save({ enableSourcing: CFG.ENABLE_SOURCING });
      if (o.created) o.created.push({ type: record.Type.BOM_REVISION, id: revId });
      out.revision = { id: revId, name: revName, lines: components.length, created: true };
      o.done.push(label + ' revision created (' + components.length + ' line(s))');
      return out;
    }

    if (!o.asNewRev) {
      const rev = record.load({ type: record.Type.BOM_REVISION, id: fam.revId, isDynamic: false });
      // Capture the operation-sequence links BEFORE clearing the lines, or
      // rewriting the components silently unlinks every one of them.
      const ops = clampOps(captureComponentOps(rev), newSeqs);
      const existingLines = rev.getLineCount({ sublistId: 'component' });
      for (let i = existingLines - 1; i >= 0; i--) {
        rev.removeLine({ sublistId: 'component', line: i });
      }
      writeRevisionComponents(rev, components, o.autoIssue, ops);
      rev.save({ enableSourcing: CFG.ENABLE_SOURCING });
      out.revision = { id: fam.revId, name: fam.revName, lines: components.length, replaced: false };
      o.done.push(label + ' components (' + components.length + ')');
      return out;
    }

    // Close the current revision first — if this fails, nothing new exists.
    const oldRev = record.load({ type: record.Type.BOM_REVISION, id: fam.revId, isDynamic: false });
    const ops = clampOps(captureComponentOps(oldRev), newSeqs);

    // Default dating: new revision starts yesterday, the one it replaces
    // closes the day before that. That breaks when the current revision
    // started yesterday or later (a door revised twice in two days), because
    // the close date would fall BEFORE its own start and NetSuite rejects it:
    //   "An Effective End Date cannot be set before an Effective Start Date."
    // So the new start is pushed forward just far enough that the close date
    // lands on, at the earliest, the old revision's own start date. Still no
    // overlap and no gap — the window just shifts.
    let newStart = midnight(offsetDate(CFG.EFFECTIVE_DATE_OFFSET_DAYS));
    let oldStart = null;
    try { oldStart = oldRev.getValue({ fieldId: 'effectivestartdate' }); } catch (e) { /* n/a */ }
    let shifted = false;
    if (oldStart instanceof Date) {
      const earliest = midnight(oldStart);
      earliest.setDate(earliest.getDate() + 1);
      if (earliest.getTime() > newStart.getTime()) { newStart = earliest; shifted = true; }
    }
    const closeDate = new Date(newStart);
    closeDate.setDate(closeDate.getDate() - 1);

    oldRev.setValue({ fieldId: 'effectiveenddate', value: closeDate });
    oldRev.save({ enableSourcing: CFG.ENABLE_SOURCING });
    out.closedRevision = { id: fam.revId, name: fam.revName, effectiveEnd: closeDate };

    const newRev = record.create({ type: record.Type.BOM_REVISION, isDynamic: false });
    newRev.setValue({ fieldId: 'billofmaterials', value: fam.bomId });
    newRev.setValue({ fieldId: 'name', value: String(fam.newRevName).trim() });
    newRev.setValue({ fieldId: 'effectivestartdate', value: newStart });
    writeRevisionComponents(newRev, components, o.autoIssue, ops);
    const newRevId = newRev.save({ enableSourcing: CFG.ENABLE_SOURCING });

    out.revision = {
      id: newRevId, name: String(fam.newRevName).trim(), lines: components.length,
      replaced: true, effectiveStart: newStart,
      note: shifted
        ? 'Dated forward — ' + fam.revName + ' only started the day before, so yesterday was not available.'
        : null
    };
    o.done.push(label + ' new revision ' + out.revision.name);
    return out;
  }

  // "... BOM REV A" -> "B", "... REV Z" -> "ZA", "... REV AA" -> "AB".
  // Anchored on the letters that follow REV so a name with no letter at all
  // doesn't match a stray V and suggest "W". Falls back to "B" — the person
  // can retype it either way, and rev letters here are not always sequential.
  function nextRevLetter(currentName) {
    const m = String(currentName || '').trim().match(/\bREV[\s-]+([A-Z]+)\s*$/i);
    if (!m) return 'B';
    const cur = m[1].toUpperCase();
    const last = cur.charCodeAt(cur.length - 1);
    if (last < 90) return cur.slice(0, -1) + String.fromCharCode(last + 1);
    return cur + 'A';
  }

  // Writes the description to every description field that exists on the item.
  // Returns the list that took it, so the caller can confirm at least one
  // landed rather than silently saving a part with the template's text.
  function setDescriptions(item, desc) {
    const text = String(desc == null ? '' : desc);
    if (!text.trim()) throw new Error('Description resolved to an empty string.');
    // A concatenation bug once wrote the literal "undefined" into a live
    // part's description. Refuse rather than persist it.
    if (/\b(undefined|null|NaN)\b/.test(text)) {
      throw new Error('Description contains "' + text.match(/\b(undefined|null|NaN)\b/)[0] +
                      '" — a value did not resolve. Nothing was created: ' + text);
    }

    const applied = [], failed = [];
    for (const f of CFG.DESCRIPTION_FIELDS) {
      try {
        item.setValue({ fieldId: f, value: text });
        const back = item.getValue({ fieldId: f });
        if (String(back) === text) applied.push(f);
        else failed.push(f + ' (did not stick)');
      } catch (e) {
        failed.push(f + ' (' + (e.message || e) + ')');
      }
    }
    if (failed.length) {
      log.audit({ title: 'description fields skipped', details: failed.join(', ') });
    }
    return applied;
  }

  // Strips the time component so date maths can't be thrown off by hours: a
  // Date built from "now" is mid-afternoon, one read off a NetSuite record is
  // midnight, and comparing the two directly misjudges which day is which.
  function midnight(d) {
    const out = new Date(d);
    out.setHours(0, 0, 0, 0);
    return out;
  }

  function offsetDate(days) {
    const d = new Date();
    d.setDate(d.getDate() + (parseInt(days, 10) || 0));
    return d;
  }

  function makeTimer() {
    const marks = [];
    let last = Date.now();
    return {
      mark(name) {
        const now = Date.now();
        marks.push(name + '=' + (now - last) + 'ms');
        last = now;
      },
      report() { return marks.join('  '); }
    };
  }

  function rollback(created) {
    const undone = [];
    for (let i = created.length - 1; i >= 0; i--) {
      try {
        record.delete({ type: created[i].type, id: created[i].id });
        undone.push(created[i].type + ' ' + created[i].id);
      } catch (e) {
        log.error({
          title: 'rollback failed',
          details: created[i].type + ' ' + created[i].id + ': ' + e.toString()
        });
        undone.push(created[i].type + ' ' + created[i].id + ' (DELETE FAILED — clean up manually)');
      }
    }
    return undone;
  }

  // ─── TEMPLATE ITEM DEFAULTS ───────────────────────────────────────────────
  let _defaultsCache = {};

  // `stamp` comes from templateStamp() and is folded into the cache key, so an
  // item field changed on the template in NetSuite is picked up on the next
  // build instead of at the end of CACHE_TTL_TEMPLATE. Blank stamp = plain
  // key = old TTL-only behaviour.
  function getTemplateDefaultsById(id, stamp) {
    if (!id) return { _fields: {}, subsidiary: '', name: '' };
    if (_defaultsCache[id]) return _defaultsCache[id];
    _defaultsCache[id] = cached('tpl_' + id + (stamp ? '_' + stamp : ''),
                                CFG.CACHE_TTL_TEMPLATE, () => readTemplateDefaults(id));
    return _defaultsCache[id];
  }

  function readTemplateDefaults(templateId) {
    const out = { _fields: {}, subsidiary: '', name: '' };
    if (!templateId) return out;

    try {
      const t = record.load({
        type: record.Type.ASSEMBLY_ITEM, id: templateId, isDynamic: false
      });

      out.name = t.getValue({ fieldId: 'itemid' }) || templateId;
      const sub = t.getValue({ fieldId: 'subsidiary' });
      out.subsidiary = Array.isArray(sub) ? sub[0] : sub;

      const skip = {};
      for (const s of CFG.SKIP_FIELDS) skip[s] = true;
      for (const s of CFG.DESCRIPTION_FIELDS) skip[s] = true;

      // Catch-all: whatever text the template carries in its description
      // fields must not ride along on ANY other field. This is what stops
      // "TEMPLATE - 4000 ENT SQ SD..." leaking through a field that isn't
      // named in DESCRIPTION_FIELDS.
      const tplDescText = [];
      for (const f of CFG.DESCRIPTION_FIELDS) {
        try {
          const v = t.getValue({ fieldId: f });
          if (v && typeof v === 'string' && v.trim()) tplDescText.push(normName(v));
        } catch (e) { /* field not on this record */ }
      }
      const bled = [];

      const fields = t.getFields() || [];
      for (const f of fields) {
        if (skip[f]) continue;
        let v;
        try { v = t.getValue({ fieldId: f }); } catch (e) { continue; }
        if (v === '' || v === null || v === undefined) continue;
        if (Array.isArray(v) && !v.length) continue;
        if (typeof v === 'string' && tplDescText.indexOf(normName(v)) !== -1) {
          bled.push(f);
          continue;
        }
        out._fields[f] = v;
      }

      if (bled.length) {
        log.audit({
          title: 'template description text blocked on extra fields',
          details: templateId + ': ' + bled.join(', ')
        });
      }

      log.audit({
        title: 'template fields loaded',
        details: Object.keys(out._fields).length + ' fields from item ' + templateId
      });
    } catch (e) {
      log.error({ title: 'readTemplateDefaults ' + templateId, details: e.toString() });
    }
    return out;
  }

  function applyDefaults(item, defaults) {
    const f = (defaults && defaults._fields) || {};
    const skipped = [];
    for (const key in f) {
      try { item.setValue({ fieldId: key, value: f[key] }); }
      catch (e) { skipped.push(key); }
    }
    if (skipped.length) {
      log.audit({ title: 'template fields not settable', details: skipped.join(', ') });
    }
  }

  // ─── INLINE HTML (scoped under #gny-dnb) ──────────────────────────────────
  function escHtml(str) {
    return String(str == null ? '' : str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function buildInlineHtml() {
    const notices = [];

    function safeList(fn, label) {
      try {
        const rows = fn();
        if (!rows.length) notices.push(label + ' list came back empty — check the execution log.');
        return rows;
      } catch (e) {
        log.error({ title: 'buildInlineHtml ' + label, details: e.toString() });
        notices.push(label + ' could not be loaded: ' + e.message);
        return [];
      }
    }

    const wcRows = safeList(listWorkCenters, 'Work center');
    const ctRows = safeList(listCostTemplates, 'Cost template');
    const clsRows = safeList(listClasses, 'Class');

    const wc = JSON.stringify(wcRows);
    const ct = JSON.stringify(ctRows);
    const cls = JSON.stringify(clsRows);
    const src = JSON.stringify(ITEM_SOURCES);

    // Every catalog operation names a work center and a cost template. If one
    // isn't in the account, picking that operation silently leaves the field
    // on "— none —". Say so on load rather than at pick time.
    const unresolved = [];
    for (const fam in OPERATIONS) {
      for (const o of OPERATIONS[fam]) {
        const missing = [];
        if (!matchNameToId(wcRows, o.wc)) missing.push('work center "' + o.wc + '"');
        if (!matchNameToId(ctRows, o.ct)) missing.push('cost template "' + o.ct + '"');
        if (missing.length) unresolved.push(fam + '/' + o.op + ' — no ' + missing.join(', '));
      }
    }
    if (unresolved.length) {
      notices.push('These catalog operations cannot fill themselves in: ' +
                   unresolved.join('; ') +
                   '. If a list looks stale, reload with ?refresh=1 on the URL.');
    }

    // Every series maps to a class. A series whose class can't be resolved
    // would quietly build a door with the template's class instead.
    const seriesOut = [];
    const badSeries = [];
    for (const s of SERIES) {
      const id = matchNameToId(clsRows, s.cls);
      if (!id) badSeries.push(s.code + ' (' + s.cls + ')');
      seriesOut.push({ code: s.code, cls: s.cls, classId: id });
    }
    if (badSeries.length) {
      notices.push('These series have no matching class in this account: ' +
                   badSeries.join(', ') + '. Pick the class by hand for those.');
    }

    let nextNum = '';
    try { nextNum = nextDoorNumber(); } catch (e) { nextNum = ''; }
    if (!nextNum) {
      notices.push('Could not work out the next free door number — type one in.');
    }

    // Templates, discovered. Everything matching the pattern becomes a picker
    // option, so this banner is also the answer to "did NetSuite see the
    // template I just built?"
    let templates = [];
    try { templates = listDoorTemplates() || []; }
    catch (e) {
      log.error({ title: 'buildInlineHtml templates', details: e.toString() });
      notices.push('Templates could not be loaded: ' + e.message);
    }
    if (!templates.length) {
      notices.push('No door templates found matching "' + CFG.TEMPLATE_DOOR_PATTERN +
                   '". The form will open empty — build a DR-…-TEMPLATE family to fix that.');
    }

    // Preselect, per CFG.DEFAULT_TEMPLATE. Blank means "— none —", which is
    // only reachable when the picker offers it; with ALLOW_NO_TEMPLATE off
    // there is no none option to land on, so the first template is the only
    // honest answer.
    let defaultTemplate = '';
    if (templates.length) {
      const want = normName(CFG.DEFAULT_TEMPLATE);
      const noneIsAllowed = !!CFG.ALLOW_NO_TEMPLATE;
      if (want === '*') {
        defaultTemplate = templates[0].key;
      } else if (want) {
        const hit = templates.filter(t => normName(t.key) === want)[0];
        if (hit) {
          defaultTemplate = hit.key;
        } else {
          defaultTemplate = noneIsAllowed ? '' : templates[0].key;
          notices.push('CFG.DEFAULT_TEMPLATE "' + CFG.DEFAULT_TEMPLATE +
                       '" was not found — opening with ' +
                       (defaultTemplate || 'a blank form') + ' instead.');
        }
      } else {
        defaultTemplate = noneIsAllowed ? '' : templates[0].key;
      }
    }

    // Fill payload for the preselected template, embedded so the form arrives
    // already filled instead of flashing empty and then populating. Stamped,
    // so an outside edit to that template shows up here on this load.
    let defaultFill = null;
    if (defaultTemplate) {
      try {
        const f = loadTemplateFill(defaultTemplate);
        if (f && f.ok) defaultFill = f;
        else if (f && f.message) notices.push(f.message);
      } catch (e) {
        log.error({ title: 'buildInlineHtml default fill', details: e.toString() });
        notices.push('Could not read ' + defaultTemplate + ': ' + e.message);
      }
    }
    if (defaultFill && defaultFill.warnings && defaultFill.warnings.length) {
      for (const w of defaultFill.warnings) notices.push(w);
    }

    // Two very different kinds of message used to share one banner. Warnings
    // are things the person needs to know before building, so they stay on top
    // and open. The setup facts — which templates exist, how many work centers
    // loaded, which location — are for whoever maintains this, and fold away
    // at the foot of the form where they cannot crowd the fields.
    let warnBanner = '';
    let setupInfo = '';
    try {
      const parts = templates.map(t =>
        '<a href="' + NS_ITEM + t.items.DR + '" target="_blank">' + escHtml(t.key) + '</a>' +
        ' [' + t.families.join('/') + ']');
      setupInfo =
        '<details class="setup"' + (_cacheCleared ? ' open' : '') + '>' +
