#${WRAP} .preview{font-family:var(--dnb-mono);font-size:10px;color:var(--dnb-muted);
  line-height:1.7;min-width:0;overflow-wrap:anywhere}
#${WRAP} .preview b{color:var(--dnb-text);font-weight:500}

#${WRAP} .result{border-radius:6px;padding:14px 16px;margin-bottom:14px;display:none}
#${WRAP} .result.open{display:block}
#${WRAP} .result.ok{background:#eef8f2;border:1px solid #8ccfae}
#${WRAP} .result.err{background:#fff0f0;border:1px solid #ffaaaa}
#${WRAP} .result.ok h3{color:var(--dnb-teal)}
#${WRAP} .result.err h3{color:var(--dnb-red)}
