${warnBanner}
<div class="dnb-layout">
<div class="dnb-main">

<div class="edit-banner" id="dnb-editBanner"></div>
<div class="result" id="dnb-result"></div>

<div class="card">
  <div class="card-head">
    <span class="card-title">1 &nbsp;Door</span>
    <span class="card-note" id="dnb-doorNote">A new number builds a door; an existing one loads it to edit or copy.</span>
  </div>
  <div class="card-body">
    <!-- One lean row. The picker decides what the grids start as, so it stays
         first, but it does not need a box of its own to say so. -->
    <div class="start-row">
      <label for="dnb-template" class="start-lbl">Start from</label>
      <select id="dnb-template" class="tabstop"></select>
      <button type="button" class="btn-sm" id="dnb-refillBtn" onclick="GNYDNB.refill()"
        title="Re-read this template from NetSuite, ignoring every cache, and replace the grids below">Re-fill</button>
      <button type="button" class="btn-sm" id="dnb-newTplBtn" onclick="GNYDNB.openNewTemplate()"
        title="Save everything on the form as a reusable template">+ New template</button>
      <span class="hint" id="dnb-templateHint">&nbsp;</span>
    </div>

    <div class="tpl-new" id="dnb-newTplPanel">
      <div class="tpl-new-head">
        Saves everything below as a reusable template — components, quantities and routing.
      </div>
      <div class="grid g3">
        <div>
          <label for="dnb-tplSeries">Series</label>
          <select id="dnb-tplSeries">${seriesOptions}</select>
        </div>
        <div>
          <label for="dnb-tplTag">Tag (optional)</label>
          <input id="dnb-tplTag" autocomplete="off" placeholder="ENT, BAG, …"
            oninput="GNYDNB.previewTemplateName()">
        </div>
        <div>
          <label for="dnb-tplName">Will be created as</label>
          <input id="dnb-tplName" readonly tabindex="-1" style="background:#eee;color:#555">
        </div>
      </div>
      <div class="hint" id="dnb-tplHint">&nbsp;</div>
      <div class="tpl-new-actions">
        <button type="button" class="btn-primary" id="dnb-saveTplBtn" onclick="GNYDNB.submitTemplate()">Create template</button>
        <button type="button" onclick="GNYDNB.closeNewTemplate()">Cancel</button>
      </div>
    </div>

    <!-- The three things every door needs, and nothing else on the main path.
         Number first: it is the entry point for BOTH flows — a new number
         builds, an old one loads for editing or copying. -->
    <div class="row-main">
      <div>
        <label for="dnb-number">Door number</label>
        <div class="ac-wrap">
          <input id="dnb-number" class="tabstop" autocomplete="off" placeholder="new or existing">
          <div class="ac-list" id="dnb-doorAc"></div>
        </div>
        <div class="hint" id="dnb-numberHint">&nbsp;</div>
      </div>
      <div>
        <label for="dnb-series">Series</label>
        <select id="dnb-series" class="tabstop">${seriesOptions}</select>
      </div>
    </div>

    <!-- Always visible now, not a click away — class, door line and purchase
         price change less often than the description but still need to be
         set before most doors, so they sit right after Number/Series and
         before Description rather than folded under a toggle. Two rows of
         three columns is as tight as this gets without losing a field. -->
    <div class="more-options">
      <div class="sub-label" style="margin-top:0">More options</div>
      <div class="grid g3">
        <div>
          <label for="dnb-class">Class</label>
          <select id="dnb-class"${skipTab}></select>
          <div class="hint" id="dnb-classHint">&nbsp;</div>
        </div>
        <div>
          <label for="dnb-doorLine">Door line <span class="dim">— door only</span></label>
          <select id="dnb-doorLine">${doorLineOptions}</select>
        </div>
        <div>
          <label for="dnb-purchasePrice">Purchase price <span class="dim">— door only</span></label>
          <input id="dnb-purchasePrice" autocomplete="off" inputmode="decimal" placeholder="0.00">
        </div>
      </div>
      <!-- Revision and effective date only mean anything for a family about
           to be built, so those two cells hide individually while editing an
           existing door (see .new-only class in the JS). Auto-issue applies
           to Update Fields and New BOM Rev too, so it shares this row but
           never hides — same for the screen-door checkbox living alongside it
           rather than taking a cell of its own. -->
      <div class="grid g3" style="margin-top:10px">
        <div class="new-only">
          <label for="dnb-rev">Revision</label>
          <select id="dnb-rev"${skipTab}></select>
        </div>
        <div class="new-only">
          <label for="dnb-date">Revision effective date</label>
          <input id="dnb-date" autocomplete="off"${skipTab}>
        </div>
        <div>
          <label>&nbsp;</label>
          <label class="inline-lbl">
            <input type="checkbox" class="chk" id="dnb-autoIssue" tabindex="-1">
            Auto-issue components
          </label>
          <label class="inline-lbl new-only" style="display:block;margin-top:6px">
            <input type="checkbox" class="chk" id="dnb-screen" onchange="GNYDNB.toggleScreen()">
            Include screen door
          </label>
        </div>
      </div>
    </div>

    <!-- Full width and WRAPPING. These run well past 130 characters — the
         4000 template's is 134 — and a one-line input turns that into a
         horizontal scroll where you cannot see the size and the hinge hand at
         the same time. A textarea shows the whole string at once.
         It is a textarea for the wrapping only: newlines are stripped on
         input, because this text goes onto four item records. -->
    <div class="desc-wrap">
      <label for="dnb-desc">Description</label>
      <textarea id="dnb-desc" class="tabstop" rows="2" spellcheck="false"
        placeholder="ENT SQ SD RH WB 32 X 78 ML 805 950 …  (the series is added to the front for you)"></textarea>
      <div class="hint" id="dnb-descHint">&nbsp;</div>
    </div>

    <!-- Edit-mode only, and deliberately RIGHT HERE rather than down with the
         create actions: you get here by typing an old number into the box
         immediately above, so the copy has to be within reach of where your
         eyes already are. -->
    <div class="edit-actions" id="dnb-editActions">
      <button type="button" class="btn-secondary" id="dnb-copyBtn" onclick="GNYDNB.startCopy()"
        title="Build a NEW door family from this one — same components and routing, next free number">Copy to new door</button>
      <span class="hint" id="dnb-copyHint">&nbsp;</span>
    </div>

    <!-- The cut list changes with every size, so it stays in view. Three rows
         is enough to see it is there and to fix a dimension; it grows if you
         drag it. -->
    <div class="cut-wrap">
      <label for="dnb-cut">Cut details <span class="dim">— door only</span></label>
      <textarea id="dnb-cut" rows="3" tabindex="-1" placeholder="(Outer W - )&#10;(Outer H - )&#10;(Inner W - )&#10;(Inner H - )&#10;(Panel W - )&#10;(Panel H - )&#10;(H-Bar - )"></textarea>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <span class="card-title">2 &nbsp;Door BOM</span>
    <span class="card-note">The sub-assemblies go on automatically. Add loose hardware that isn't part of one.</span>
  </div>
  <div class="card-body">
    <div class="fam-num" id="dnb-num-DR">&nbsp;</div>

    <!-- Same control the sub-assembly cards carry, and the one that matters
         most here: a door whose own BOM is missing has no frame/core cards on
         screen to borrow from, so without this there was nowhere to copy a
         setup in from. Only the LOOSE HARDWARE comes across — the door's own
         frame/core/screen lines are re-derived from its number, never copied
         off another door. -->
    <div class="copy-from-row" id="dnb-copyFromRow-DR">
      <label for="dnb-copyFrom-DR">Copy BOM from</label>
      <div class="copy-from-inline">
        <input id="dnb-copyFrom-DR" autocomplete="off" placeholder="a similar door number…">
        <button type="button" class="btn-sm" onclick="GNYDNB.copyFromPart('DR')">Fill</button>
      </div>
      <div class="hint" id="dnb-copyFromHint-DR">&nbsp;</div>
    </div>

    <div class="sub-lines" id="dnb-subLines"></div>

    <div class="sub-label">Loose hardware</div>
    <div class="twrap comp-wrap">
    <table>
      <thead><tr>
        <th style="width:56%">Component</th>
        <th class="r" style="width:14%">Qty</th>
        <th style="width:24%">Item source</th>
        <th style="width:6%"></th>
      </tr></thead>
      <tbody id="dnb-compBody-DR"></tbody>
    </table>
    </div>
    <button type="button" class="btn-add tabstop" onclick="GNYDNB.addComponent('DR', true)">+ Add hardware</button>

    <div class="grid g2" style="margin-top:10px;display:none" id="dnb-editRev-DR">
      <div>
        <label for="dnb-newRevName-DR">New BOM rev name</label>
        <input id="dnb-newRevName-DR" autocomplete="off">
      </div>
      <div>
        <label for="dnb-curRevName-DR">Current revision</label>
        <input id="dnb-curRevName-DR" readonly tabindex="-1" style="background:#eee;color:#555">
      </div>
    </div>
  </div>
</div>

${famCard('F', 3, 'Outer extrusion, seal, hinges. Cut then weld, or cut then bend.')}
${famCard('C', 4, 'Inner extrusion, skins, foam, adhesive, hardware. Cut, laminate, route.',
  `<label class="inline-lbl core-opt">
     <input type="checkbox" class="chk" id="dnb-tube" onchange="GNYDNB.toggleTube()">
     Include tube frame
   </label>
   <div class="sub-lines" id="dnb-subLines-C" style="display:none"></div>`)}
${famCard('T', 5, 'Tube extrusion, sometimes a sheet of .125 aluminium. Cut then weld.',
  `<div class="tube-num">
     <label for="dnb-tubeNumber">Tube frame number</label>
     <input id="dnb-tubeNumber" class="tabstop" autocomplete="off"
       placeholder="the number engineering assigned">
     <div class="hint" id="dnb-tubeHint">&nbsp;</div>
   </div>`)}
${famCard('S', 6, 'Screen frame extrusion, mesh, hardware. Usually cut only.')}

<div class="actions">
  <button type="button" class="btn-primary tabstop" id="dnb-submit" onclick="GNYDNB.submit()">Create door</button>
  <button type="button" class="btn-secondary tabstop" id="dnb-newRevBtn" style="display:none" onclick="GNYDNB.submitNewRev()">Save as new BOM revisions</button>

  <div class="preview" id="dnb-preview"></div>
</div>

${setupInfo}
</div>

<aside class="dnb-side">
  <div class="card">
    <div class="card-head">
      <span class="card-title">Recent activity</span>
      <span class="card-note" id="dnb-recentCount"></span>
    </div>
    <div class="card-body" id="dnb-recentBody">
      <div class="recent-empty">Nothing built or edited yet.</div>
    </div>
  </div>
</aside>
</div>

<script>
// All logic lives on one global namespace so it cannot collide with
// NetSuite's own page scripts.
var GNYDNB = (function(){
  var WORK_CENTERS = ${wc};
  var COST_TEMPLATES = ${ct};
  var CLASSES = ${cls};
  var ITEM_SOURCES = ${src};
  var SERIES = ${JSON.stringify(seriesOut)};
  var TEMPLATES = ${JSON.stringify(templates)};
  var DEFAULT_TEMPLATE = ${JSON.stringify(defaultTemplate)};
  var ALLOW_NO_TEMPLATE = ${CFG.ALLOW_NO_TEMPLATE ? 'true' : 'false'};
  var ALLOW_TEMPLATE_CREATION = ${CFG.ALLOW_TEMPLATE_CREATION ? 'true' : 'false'};
  var TEMPLATE_SUFFIX = ${JSON.stringify(CFG.TEMPLATE_SUFFIX)};
  var TEMPLATE_TAG_MAX = ${CFG.TEMPLATE_TAG_MAX};
  var SEED_DESC = ${CFG.SEED_DESCRIPTION_FROM_TEMPLATE ? 'true' : 'false'};
  var SEED_CUT = ${CFG.SEED_CUT_DETAILS_FROM_TEMPLATE ? 'true' : 'false'};
  // The preselected template's fill payload, embedded so the form arrives
  // already populated rather than flashing empty and filling a beat later.
  // It came off a stamped server cache, so it is current as of this page load.
  var FILL_CACHE = ${defaultFill ? '{' + JSON.stringify(defaultTemplate) + ': ' + JSON.stringify(defaultFill) + '}' : '{}'};
  var OPERATIONS = ${JSON.stringify(OPERATIONS)};
  var DEFAULT_STEPS = ${JSON.stringify(DEFAULT_STEPS)};
  var DEFAULT_COMPONENT_ROWS = ${JSON.stringify(DEFAULT_COMPONENT_ROWS)};
  var FAMILY_PREFIX = ${JSON.stringify(CFG.FAMILY_PREFIX)};
  var DESC_PREFIX = ${JSON.stringify(CFG.DESC_PREFIX)};
  var REV_NAME_SEP = ${JSON.stringify(CFG.REV_NAME_SEP)};
  var BUILDS_ROUTING = ${JSON.stringify(CFG.BUILDS_ROUTING)};
  var FAMILY_LABEL = ${JSON.stringify(FAMILY_LABEL)};
  var DR_COMPONENT_ORDER = ${JSON.stringify(CFG.DR_COMPONENT_ORDER)};
  var DR_SUBASSEMBLY_SOURCE = ${JSON.stringify(CFG.DR_SUBASSEMBLY_SOURCE)};
  var SOURCE_BY_ITEMTYPE = ${JSON.stringify(SOURCE_BY_ITEMTYPE)};
  var SOURCE_FALLBACK = ${JSON.stringify(SOURCE_FALLBACK)};
  var SERIES_IN_DESC = ${CFG.SERIES_IN_DESC ? 'true' : 'false'};
  var NEXT_NUMBER = ${JSON.stringify(nextNum)};
  var DATE_OFFSET = ${CFG.EFFECTIVE_DATE_OFFSET_DAYS};
  var AUTO_RESET = ${CFG.AUTO_RESET ? 'true' : 'false'};
  var AUTO_ISSUE_DEFAULT = ${CFG.AUTO_ISSUE_DEFAULT ? 'true' : 'false'};
  var INCLUDE_SCREEN_DEFAULT = ${CFG.INCLUDE_SCREEN_DEFAULT ? 'true' : 'false'};
  var RECENT_LIMIT = ${CFG.RECENT_LIMIT};
  var RECENT_KEY = 'gny_dnb_recent';
  var SEARCH_MIN_CHARS = ${CFG.SEARCH_MIN_CHARS};
  var NUMBER_WIDTH = ${CFG.NUMBER_WIDTH};

  var SUB_FAMILIES = ['F', 'C', 'S'];
  var ALL_FAMILIES = ['DR', 'F', 'C', 'S'];
  // Everything with a card and a grid. The tube frame is here but not in
  // ALL_FAMILIES, because its number is typed rather than derived from the
  // door — see the server-side note on the same split.
  var ALL_UNITS = ['DR', 'F', 'C', 'S', 'T'];
  var INCLUDE_TUBE_DEFAULT = ${CFG.INCLUDE_TUBE_DEFAULT ? 'true' : 'false'};
  var TUBE_QTY = ${CFG.TUBE_QTY};
  var TUBE_SOURCE = ${JSON.stringify(CFG.TUBE_SOURCE)};
  var DOOR_NOTE_NEW =
    'A new number builds a door; an existing one loads it to edit or copy.';

  var root;
  var rowCount = { DR:0, F:0, C:0, S:0, T:0 };
  var stepCount = { F:0, C:0, S:0, T:0 };
  var acTimers = {}, acData = {}, acActive = {}, acQueryCache = {};

  // ── mode ────────────────────────────────────────────────────────────────
  var mode = 'new';          // 'new' | 'edit'
  var editData = null;       // last loaddoor response
  var doorAcTimer = null, doorAcData = [], doorAcActive = -1;

  // Clicking a dropdown row must not be beaten by the blur handler firing
  // against the TYPED text. acClicking suppresses the blur path while a row is
  // being clicked; numReqSeq makes every checkdoor/loaddoor response
  // last-writer-wins, so no stale request can overwrite a newer selection.
  var acClicking = false;
  var numReqSeq = 0;

  function \$(id){ return document.getElementById(id); }

  function esc(s){
    return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function norm(s){
    return String(s == null ? '' : s).replace(/\\s+/g,' ').trim().toUpperCase();
  }

  function optionsHtml(arr, valKey, labKey, blank){
    var h = blank ? '<option value="">' + blank + '</option>' : '';
    for (var i=0;i<arr.length;i++){
      h += '<option value="' + esc(arr[i][valKey]) + '">' + esc(arr[i][labKey]) + '</option>';
    }
    return h;
  }

  function baseUrl(){
    var p = new URLSearchParams(window.location.search);
    // refresh is a one-shot page-load flag; carrying it on every XHR would
    // clear the caches over and over and make the tool slower, not faster.
    p.delete('api'); p.delete('term'); p.delete('refresh'); p.delete('fresh');
    return window.location.origin + window.location.pathname + '?' + p.toString();
  }

  function setHint(id, text, cls){
    var el = \$(id);
    if (!el) return;
    el.textContent = text || '\\u00A0';
    el.className = 'hint' + (cls ? ' ' + cls : '');
  }

  // Revision and effective date only mean anything for a family about to be
  // built, and the screen-door checkbox sits right alongside Auto-issue in
  // the same row rather than a cell of its own — so each hides individually
  // by class rather than as one wrapping container, which would take
  // Auto-issue down with it. Auto-issue applies to Update Fields and New BOM
  // Rev too, so it must never be part of this toggle.
  function setNewOnlyVisible(on){
    var els = root ? root.querySelectorAll('.new-only') : document.querySelectorAll('.new-only');
    for (var i=0;i<els.length;i++){
      els[i].style.display = on ? '' : 'none';
    }
  }

  function activeFamilies(){
    var out = ['F', 'C'];
    if (\$('dnb-screen').checked) out.push('S');
    return out;
  }

  // Units whose grids get collected and sent. The tube is separate from
  // activeFamilies because the server takes it on its own key, not as one of
  // the door-numbered families.
  function activeUnits(){
    var out = activeFamilies().concat(['DR']);
    if (\$('dnb-tube').checked) out.push('T');
    return out;
  }

  function partNumberFor(fam){
    var s = \$('dnb-series').value;
    var n = \$('dnb-number').value.trim();
    if (!s || !n) return '';
    return FAMILY_PREFIX[fam] + s + '-' + n;
  }

  // ── series / class ──────────────────────────────────────────────────────
  // Every series maps to a class, taken from what the 3,183 live doors
  // actually use. The dropdown stays editable — one-off exceptions exist.
  var classUserSet = false;

  function onSeriesChange(){
    if (!classUserSet){
      var s = \$('dnb-series').value;
      var row = null;
      for (var i=0;i<SERIES.length;i++){ if (SERIES[i].code === s){ row = SERIES[i]; break; } }
      if (row && row.classId){
        \$('dnb-class').value = row.classId;
        setHint('dnb-classHint', 'From series ' + s, '');
      } else if (row){
        setHint('dnb-classHint', 'No class matched "' + row.cls + '" — pick one.', 'bad');
      } else {
        setHint('dnb-classHint', '', '');
      }
    }
    syncDescriptionSeries();
    refreshNumbers();
    updatePreview();
  }

  function markClassManual(){
    classUserSet = true;
    setHint('dnb-classHint', 'Set by hand', '');
  }

  // The description opens with the series number on 3,126 of 3,182 live
  // doors. Swap the leading series when the series changes rather than
  // leaving the old one stranded at the front of the text.
  function syncDescriptionSeries(){
    if (!SERIES_IN_DESC || mode === 'edit') return;
    var s = \$('dnb-series').value;
    if (!s) return;
    var d = \$('dnb-desc').value;
    var m = d.match(/^([0-9]{3,5})\\s+/);
    if (m){
      \$('dnb-desc').value = s + ' ' + d.slice(m[0].length);
    } else if (d.trim()){
      \$('dnb-desc').value = s + ' ' + d.trim();
    }
    updatePreview();
  }

  // ── numbers ─────────────────────────────────────────────────────────────
  function refreshNumbers(){
    var subs = activeFamilies();
    var all = ['DR'].concat(subs);
    for (var i=0;i<ALL_FAMILIES.length;i++){
      var f = ALL_FAMILIES[i];
      var el = \$('dnb-num-' + f);
      if (!el) continue;
      if (all.indexOf(f) === -1){ el.innerHTML = '&nbsp;'; continue; }
      var pn = partNumberFor(f);
      if (mode === 'edit' && editData && editData.families[f]){
        var u = editData.families[f];
        el.innerHTML = '<a href="/app/common/item/item.nl?id=' + u.itemId + '" target="_blank">' +
          esc(u.partNumber) + '</a> &middot; ' + esc(u.bomName || 'no BOM') +
          (u.revName ? ' &middot; ' + esc(u.revName) : '');
      } else {
        el.innerHTML = pn
          ? esc(pn) + ' &middot; ' + esc(pn + ' BOM') + ' &middot; ' +
            esc(pn + REV_NAME_SEP[f] + \$('dnb-rev').value) +
            (BUILDS_ROUTING[f] ? ' &middot; ' + esc(pn + ' ROUTING') : '')
          : '&nbsp;';
      }
    }

    // The tube is named by what was typed, not by the door number, so its line
    // is built from the box rather than derived like the others.
    var tEl = \$('dnb-num-T');
    if (tEl){
      if (!\$('dnb-tube').checked){
        tEl.innerHTML = '&nbsp;';
      } else if (mode === 'edit' && editData && editData.families.T){
        var tu = editData.families.T;
        tEl.innerHTML = '<a href="/app/common/item/item.nl?id=' + tu.itemId + '" target="_blank">' +
          esc(tu.partNumber) + '</a> &middot; ' + esc(tu.bomName || 'no BOM') +
          (tu.revName ? ' &middot; ' + esc(tu.revName) : '');
      } else {
        var tn = \$('dnb-tubeNumber') ? \$('dnb-tubeNumber').value.trim() : '';
        tEl.innerHTML = tn
          ? esc(tn) + ' &middot; ' + esc(tn + ' BOM') + ' &middot; ' +
            esc(tn + REV_NAME_SEP.T + \$('dnb-rev').value) + ' &middot; ' + esc(tn + ' ROUTING')
          : '<span class="dim">Enter the tube frame number.</span>';
      }
    }

    renderSubLines();
    renderCoreSubLines();
  }

  // The tube's line on the CORE's BOM, shown read-only for the same reason the
  // door's sub-assembly lines are: this tool owns that line, and nobody should
  // be able to drop the tube out of a core by clearing a hardware row.
  function renderCoreSubLines(){
    var box = \$('dnb-subLines-C');
    if (!box) return;

    if (mode === 'edit' && editData){
      var lines = (editData.families.C && editData.families.C.subLines) || [];
      if (!lines.length){ box.style.display = 'none'; return; }
      var h = '';
      for (var i=0;i<lines.length;i++){
        h += '<div class="sub-line">' +
             '<span>' + esc(lines[i].itemNumber) + '</span>' +
             '<span class="sl-qty">x' + esc(lines[i].quantity) + '</span>' +
             '<span class="sl-src">' + esc(lines[i].itemSource) + '</span>' +
             '<span class="sl-src">tube frame</span>' +
             '</div>';
      }
      box.innerHTML = h;
      box.style.display = '';
      return;
    }

    if (!\$('dnb-tube').checked){ box.style.display = 'none'; return; }
    var tn = \$('dnb-tubeNumber') ? \$('dnb-tubeNumber').value.trim() : '';
    box.innerHTML = '<div class="sub-line">' +
      '<span>' + (tn ? esc(tn) : '&lt;tube frame&gt;') + '</span>' +
      '<span class="sl-qty">x' + esc(TUBE_QTY) + '</span>' +
      '<span class="sl-src">' + esc(TUBE_SOURCE) + '</span>' +
      '<span class="sl-src">tube frame</span>' +
      '</div>';
    box.style.display = '';
  }

  // The door's own BOM lines for its sub-assemblies. Rendered read-only so
  // nobody can drop the frame out of a door by clearing a grid row.
  function renderSubLines(){
    var box = \$('dnb-subLines');
    if (!box) return;
    var h = '';

    if (mode === 'edit' && editData){
      var lines = (editData.families.DR && editData.families.DR.subLines) || [];
      if (!lines.length){
        box.innerHTML = '<div class="sub-line dim">This door has no sub-assembly lines on its BOM.</div>';
        return;
      }
      for (var i=0;i<lines.length;i++){
        var l = lines[i];
        h += '<div class="sub-line">' +
             '<span>' + esc(l.itemNumber) + '</span>' +
             '<span class="sl-qty">x' + esc(l.quantity) + '</span>' +
             '<span class="sl-src">' + esc(l.itemSource) + '</span>' +
             '</div>';
      }
      box.innerHTML = h;
      return;
    }

    var subs = activeFamilies();
    for (var k=0;k<DR_COMPONENT_ORDER.length;k++){
      var f = DR_COMPONENT_ORDER[k];
      if (subs.indexOf(f) === -1) continue;
      var pn = partNumberFor(f);
      h += '<div class="sub-line">' +
           '<span>' + (pn ? esc(pn) : '&lt;' + esc(FAMILY_LABEL[f].toLowerCase()) + '&gt;') + '</span>' +
           '<span class="sl-qty">x1</span>' +
           '<span class="sl-src">' + esc(DR_SUBASSEMBLY_SOURCE) + '</span>' +
           '</div>';
    }
    box.innerHTML = h || '<div class="sub-line dim">No sub-assemblies selected.</div>';
  }

  function onNumberInput(){
    var el = \$('dnb-number');
    el.value = el.value.toUpperCase();
    doorAcInput();
    if (mode === 'edit' && editData){
      setHint('dnb-numberHint', 'Press Enter or tab out to load this number.', '');
      return;
    }
    setHint('dnb-numberHint', '', '');
    el.classList.remove('bad');
    refreshNumbers();
    updatePreview();
  }

  // Blur is the catch-all trigger: an existing number loads, a free one keeps
  // building. It must NOT run while a dropdown row is being clicked — the row
  // the person picked, not the text they typed, is the intent.
  function checkNumber(){
    if (acClicking) return;
    var val = \$('dnb-number').value.trim();
    if (!val) return;
    if (mode === 'edit' && editData && val === String(editData.number || '')) return;

    var seq = ++numReqSeq;
    var xhr = new XMLHttpRequest();
    xhr.open('GET', baseUrl() + '&api=checkdoor&term=' + encodeURIComponent(val), true);
    xhr.onload = function(){
      if (seq !== numReqSeq) return;
      try {
        var t = xhr.responseText, s = t.indexOf('{'), e = t.lastIndexOf('}');
        if (s === -1) return;
        var r = JSON.parse(t.slice(s, e+1));
        if (!r.ok) return;
        if (r.exists){
          setHint('dnb-numberHint', 'Already built (' + esc(r.doorNumber || val) + ') — loading…', '');
          loadDoor(val);
        } else {
          \$('dnb-number').classList.remove('bad');
          if (mode === 'edit') exitEditMode(val);
          setHint('dnb-numberHint', 'Available', 'good');
        }
      } catch(err){}
    };
    xhr.send();
  }

  // ── door search dropdown ────────────────────────────────────────────────
  function doorAcInput(){
    clearTimeout(doorAcTimer);
    var val = \$('dnb-number').value.trim();
    if (val.length < SEARCH_MIN_CHARS){ doorAcClose(); return; }
    doorAcTimer = setTimeout(function(){ doorAcFetch(val); }, 200);
  }

  function doorAcFetch(term){
    var xhr = new XMLHttpRequest();
    xhr.open('GET', baseUrl() + '&api=doors&term=' + encodeURIComponent(term), true);
    xhr.onload = function(){
      try {
        var t = xhr.responseText, s = t.indexOf('['), e = t.lastIndexOf(']');
        if (s === -1){ doorAcClose(); return; }
        doorAcData = JSON.parse(t.slice(s, e+1));
        doorAcRender();
      } catch(err){ doorAcClose(); }
    };
    xhr.onerror = function(){ doorAcClose(); };
    xhr.send();
  }

  function doorAcRender(){
    var list = \$('dnb-doorAc');
    if (!doorAcData.length){ doorAcClose(); return; }
    var h = '';
    for (var k=0;k<doorAcData.length;k++){
      h += '<div class="ac-item" onclick="GNYDNB.doorAcPick(' + k + ')">' +
           '<span class="ac-id">' + esc(doorAcData[k].itemid) + '</span>' +
           '<span class="ac-desc">' + esc(doorAcData[k].desc) + '</span></div>';
    }
    list.innerHTML = h;
    list.classList.add('open');
    doorAcActive = -1;
  }

  function doorAcKey(e){
    var list = \$('dnb-doorAc');
    if (!list.classList.contains('open')) return false;
    var items = list.querySelectorAll('.ac-item');
    if (e.key === 'ArrowDown'){
      doorAcActive = Math.min(doorAcActive+1, items.length-1); doorAcHi(items); e.preventDefault(); return true;
    } else if (e.key === 'ArrowUp'){
      doorAcActive = Math.max(doorAcActive-1, 0); doorAcHi(items); e.preventDefault(); return true;
    } else if (e.key === 'Enter'){
      if (doorAcActive >= 0){ doorAcPick(doorAcActive); e.preventDefault(); return true; }
    } else if (e.key === 'Escape'){
      doorAcClose(); return true;
    }
    return false;
  }

  function doorAcHi(items){
    for (var k=0;k<items.length;k++) items[k].classList.toggle('active', k === doorAcActive);
    if (doorAcActive >= 0) items[doorAcActive].scrollIntoView({ block:'nearest' });
  }

  function doorAcPick(k){
    var d = doorAcData[k];
    if (!d) return;
    doorAcClose();
    loadDoor(d.itemid);
  }

  function doorAcClose(){
    var l = \$('dnb-doorAc');
    if (l) l.classList.remove('open');
  }

  // ── load an existing door ───────────────────────────────────────────────
  function loadDoor(term){
    var t = String(term || \$('dnb-number').value || '').trim();
    if (!t){ setHint('dnb-numberHint', 'Enter a door number.', 'bad'); return; }
    var seq = ++numReqSeq;
    doorAcClose();
    setHint('dnb-numberHint', 'Loading…', '');

    function fail(msg){ if (seq === numReqSeq) setHint('dnb-numberHint', msg, 'bad'); }

    var xhr = new XMLHttpRequest();
    xhr.open('GET', baseUrl() + '&api=loaddoor&term=' + encodeURIComponent(t), true);
    xhr.onload = function(){
      if (seq !== numReqSeq) return;
      try {
        var s = xhr.responseText.indexOf('{'), e = xhr.responseText.lastIndexOf('}');
        var r = JSON.parse(xhr.responseText.slice(s, e+1));
        if (!r.ok){ fail(r.message || 'Not found.'); return; }
        applyEditData(r);
      } catch(err){
        fail('Unexpected response — check the execution log.');
      }
    };
    xhr.onerror = function(){ fail('Request failed.'); };
    xhr.send();
  }

  // Mirrors the server's nextRevLetter() so the suggested name is visible
  // before saving. Only a suggestion — rev letters here are not always
  // sequential, so the field stays editable.
  function suggestNextRevName(fam, partNum, currentRevName){
    var m = String(currentRevName || '').trim().match(/\\bREV[\\s-]+([A-Z]+)\\s*\$/i);
    var next = 'B';
    if (m){
      var cur = m[1].toUpperCase();
      var last = cur.charCodeAt(cur.length - 1);
      next = (last < 90) ? (cur.slice(0, -1) + String.fromCharCode(last + 1)) : (cur + 'A');
    }
    return partNum + REV_NAME_SEP[fam] + next;
  }

  function applyEditData(r){
    // Opening a different door ends any copy run — the grids are about to be
    // replaced by that door's, so the thing being copied no longer exists.
    stopCopy();
    mode = 'edit';
    editData = r;
    // A freshly loaded door starts from what NetSuite actually has — any
    // pending "build these families" state from a previous reference fill is
    // no longer about this door.
    toCreateFamilies = {};
    referenceDoor = '';
    var cf = root.querySelectorAll('[id^="dnb-copyFrom-"]');
    for (var ci=0;ci<cf.length;ci++) cf[ci].value = '';

    \$('dnb-series').value = r.series;
    \$('dnb-number').value = r.number;
    \$('dnb-number').classList.remove('bad');
    setHint('dnb-numberHint', 'Loaded — edit below, or type another number to switch.', 'good');
    \$('dnb-desc').value = r.description;
    \$('dnb-class').value = r.classId || '';
    \$('dnb-cut').value = r.cutDetails || '';
    \$('dnb-doorLine').value = r.doorLine || '';
    \$('dnb-purchasePrice').value = r.purchasePrice || '';
    \$('dnb-screen').checked = !!r.hasScreen;
    \$('dnb-tube').checked = !!r.hasTube;
    \$('dnb-tubeNumber').value = r.tubeNumber || '';
    setHint('dnb-tubeHint', r.hasTube
      ? 'Loaded from the core of ' + r.doorNumber + '.'
      : '', r.hasTube ? 'good' : '');
    tubeSetGridsEnabled(true);
    setNewOnlyVisible(false);
    // Templates describe what a NEW door starts as. Applying one to a door
    // that already exists would silently replace its real BOM with a
    // template's, so the picker is locked out until you leave edit mode.
    setTemplatePickerEnabled(false, 'Locked while editing ' + r.doorNumber +
      ' — "+ New template" still works if you want to save this setup.');
    \$('dnb-doorNote').textContent = 'Editing ' + r.doorNumber + ' — ' +
      ALL_UNITS.filter(function(f){ return r.families[f]; })
        .map(function(f){ return FAMILY_LABEL[f].toLowerCase(); }).join(', ') + ' loaded.';

    // Only show the cards for families this door actually has. A door with no
    // screen should not present an empty screen grid that saves nothing.
    for (var i=0;i<SUB_FAMILIES.length;i++){
      var f = SUB_FAMILIES[i];
      var card = \$('dnb-card-' + f);
      if (card) card.style.display = r.families[f] ? '' : 'none';
    }
    var tCard = \$('dnb-card-T');
    if (tCard) tCard.style.display = r.families.T ? '' : 'none';

    for (var k=0;k<ALL_UNITS.length;k++){
      var fam = ALL_UNITS[k];
      var u = r.families[fam];
      \$('dnb-compBody-' + fam).innerHTML = ''; rowCount[fam] = 0;
      if (BUILDS_ROUTING[fam]){
        \$('dnb-stepBody-' + fam).innerHTML = ''; stepCount[fam] = 0;
      }
      var revRow = \$('dnb-editRev-' + fam);
      if (revRow) revRow.style.display = u ? '' : 'none';
      if (!u) continue;

      (u.components || []).forEach(function(c){
        var i = addComponent(fam, false);
        \$('dnb-comp-item-' + fam + i).value = c.itemNumber + '  —  ' + c.desc;
        \$('dnb-comp-id-' + fam + i).value = c.itemId;
        \$('dnb-comp-qty-' + fam + i).value = c.quantity;
        \$('dnb-comp-src-' + fam + i).value = c.itemSource;
        var row = \$('dnb-comp-' + fam + i);
        if (row){ row.dataset.itemType = c.itemType || ''; row.dataset.srcManual = '1'; }
      });
      if (!(u.components || []).length) addComponent(fam, false);

      if (BUILDS_ROUTING[fam]){
        (u.steps || []).forEach(function(s){
          var i = addStep(fam, false);
          \$('dnb-step-seq-' + fam + i).value = s.sequence;
          // The same operation name exists on more than one catalog entry
          // (EXT CUT is both a frame and a core operation), so the cost
          // template is what settles which entry a loaded step came from.
          // The name-only hit is the fallback for steps whose template was
          // never set or no longer resolves.
          var opIdx = -1, nameHit = -1;
          var cat = OPERATIONS[fam] || [];
          for (var q=0;q<cat.length;q++){
            if (norm(cat[q].op) !== norm(s.operationName)) continue;
            if (nameHit === -1) nameHit = q;
            if (s.costTemplateId &&
                String(matchByName(COST_TEMPLATES, cat[q].ct)) === String(s.costTemplateId)){
              opIdx = q; break;
            }
          }
          if (opIdx === -1) opIdx = nameHit;
          if (opIdx >= 0){
            \$('dnb-step-op-' + fam + i).value = opIdx;
          } else {
            \$('dnb-step-op-' + fam + i).value = 'custom';
            onOpChange(fam, i);
            \$('dnb-step-optxt-' + fam + i).value = s.operationName;
          }
          \$('dnb-step-wc-' + fam + i).value = s.workCenterId || '';
          \$('dnb-step-ct-' + fam + i).value = s.costTemplateId || '';
          \$('dnb-step-run-' + fam + i).value = s.runRate;
          \$('dnb-step-setup-' + fam + i).value = s.setupTime;
        });
        if (!(u.steps || []).length) addStep(fam, false);
      }

      \$('dnb-curRevName-' + fam).value = u.revName || '';
      \$('dnb-newRevName-' + fam).value = u.revName
        ? suggestNextRevName(fam, u.partNumber, u.revName) : '';
    }

    \$('dnb-submit').textContent = 'Update fields';
    \$('dnb-submit').onclick = submitUpdate;
    \$('dnb-newRevBtn').style.display = '';
    \$('dnb-editActions').classList.add('open');
    setHint('dnb-copyHint', 'Copy builds a new door family from ' + r.doorNumber +
      ' on the next free number. Nothing here is touched.', '');

    var warn = (r.warnings && r.warnings.length)
      ? ' \\u00B7 ' + r.warnings.join(' \\u00B7 ') : '';
    \$('dnb-editBanner').textContent =
      'Update Fields saves item fields, routing and the CURRENT revisions in place. ' +
      'Save As New BOM Revs closes each current revision and opens a new one dated yesterday. ' +
      'Routing is not versioned by revision in this account, so it always saves in place. ' +
      'A frame or core loaded with no BOM at all gets one built the next time you save.' + warn;
    \$('dnb-editBanner').classList.add('open');

    refreshNumbers();
    refreshCopyBoxes();
    updatePreview();
  }

  // The number of a loaded door was changed to one that does NOT exist, so
  // this is a new door now. The grids are deliberately LEFT ALONE — loading a
  // door and retyping the number is how you clone one.
  function exitEditMode(keepNumber){
    mode = 'new';
    editData = null;
    \$('dnb-editBanner').classList.remove('open');
    \$('dnb-doorNote').textContent = DOOR_NOTE_NEW;
    setNewOnlyVisible(true);
    \$('dnb-submit').textContent = 'Create door';
    \$('dnb-submit').onclick = submit;
    \$('dnb-newRevBtn').style.display = 'none';
    \$('dnb-editActions').classList.remove('open');
    setTemplatePickerEnabled(true, '');
    for (var i=0;i<ALL_UNITS.length;i++){
      var revRow = \$('dnb-editRev-' + ALL_UNITS[i]);
      if (revRow) revRow.style.display = 'none';
    }
    toggleScreen();
    if (keepNumber) \$('dnb-number').value = keepNumber;
    refreshNumbers();
    refreshCopyBoxes();
    updatePreview();
  }

  // Ticking a family's box on a door that does not have that family is a
  // request to BUILD it — the same thing a reference copy asks for, and it has
  // to set the same flag. Without this the family gets filled in on screen,
  // looks ready to go, and is then silently dropped at save time because
  // nothing ever marked it for creation.
  function markFamilyForCreate(fam, on){
    if (mode !== 'edit' || !editData) return;
    if (on && !editData.families[fam]) toCreateFamilies[fam] = true;
    else delete toCreateFamilies[fam];
    updateCreateNotice();
  }

  function toggleScreen(){
    var on = \$('dnb-screen').checked;
    var card = \$('dnb-card-S');
    if (card) card.style.display = on ? '' : 'none';
    if (on && !rowCount.S){
      // From the template if it has a screen, otherwise the catalog default.
      // DR-4000-TEMPLATE has no S sibling today, so this is the fallback path
      // until an S-4000-TEMPLATE exists.
      fillFamily('S', (templateFill && templateFill.families) ? templateFill.families.S : null);
    }
    markFamilyForCreate('S', on);
    refreshNumbers();
    updatePreview();
  }

  // The tube frame hangs off the CORE, not the door — that is the whole point
  // of it. Ticking the box opens its card and puts a placeholder line at the
  // top of the core's BOM box so the level is visible before anything is built.
  function toggleTube(){
    var on = \$('dnb-tube').checked;
    var card = \$('dnb-card-T');
    if (card) card.style.display = on ? '' : 'none';
    if (on && !rowCount.T){
      fillFamily('T', (templateFill && templateFill.families) ? templateFill.families.T : null);
    }
    if (!on) setHint('dnb-tubeHint', '', '');
    markFamilyForCreate('T', on);
    refreshNumbers();
    updatePreview();
  }

  // Engineering assigns the tube number ahead of the door, so the number may
  // already be a live item. Existing means LINK it onto the core untouched;
  // free means this build creates it. Either is fine — the box just has to say
  // which, because they are very different outcomes.
  var tubeReqSeq = 0;
  function checkTubeNumber(){
    var el = \$('dnb-tubeNumber');
    if (!el) return;
    el.value = el.value.toUpperCase();
    var val = el.value.trim();
    refreshNumbers();
    updatePreview();
    updateCreateNotice();
    if (!val){ setHint('dnb-tubeHint', '', ''); tubeSetGridsEnabled(true); return; }

    var seq = ++tubeReqSeq;
    clearTimeout(acTimers.__tube);
    acTimers.__tube = setTimeout(function(){
      var xhr = new XMLHttpRequest();
      xhr.open('GET', baseUrl() + '&api=checkitem&term=' + encodeURIComponent(val), true);
      xhr.onload = function(){
        if (seq !== tubeReqSeq) return;
        try {
          var t = xhr.responseText, a = t.indexOf('{'), b = t.lastIndexOf('}');
          var res = JSON.parse(t.slice(a, b+1));
          if (!res.ok) return;
          if (res.exists){
            setHint('dnb-tubeHint', 'Exists already — it will be linked onto the core, ' +
              'untouched. ' + (res.desc || ''), 'good');
            tubeSetGridsEnabled(false);
          } else {
            setHint('dnb-tubeHint', 'Free — will be created from the grid below.', '');
            tubeSetGridsEnabled(true);
          }
        } catch(err){}
      };
      xhr.send();
    }, 250);
  }

  // A tube that already exists is not this build's to edit, so its grids go
  // quiet rather than inviting changes that would never be saved.
  function tubeSetGridsEnabled(on){
    var card = \$('dnb-card-T');
    if (!card) return;
    var inputs = card.querySelectorAll('#dnb-compBody-T input, #dnb-compBody-T select, ' +
      '#dnb-stepBody-T input, #dnb-stepBody-T select, #dnb-card-T .btn-add');
    for (var i=0;i<inputs.length;i++) inputs[i].disabled = !on;
    card.style.opacity = on ? '' : '.55';
  }

  // ── components ──────────────────────────────────────────────────────────
  function addComponent(fam, focusNew){
    var i = rowCount[fam]++;
    var key = fam + i;
    var tr = document.createElement('tr');
    tr.id = 'dnb-comp-' + key;
    tr.innerHTML =
      '<td><div class="ac-wrap">' +
        '<input id="dnb-comp-item-' + key + '" class="tabstop" placeholder="Search part…" autocomplete="off" ' +
          'oninput="GNYDNB.acInput(\\'' + key + '\\')" onkeydown="GNYDNB.acKey(event,\\'' + key + '\\')">' +
        '<input type="hidden" id="dnb-comp-id-' + key + '">' +
        '<div class="ac-list" id="dnb-ac-' + key + '"></div>' +
      '</div></td>' +
      '<td><input class="num tabstop" id="dnb-comp-qty-' + key + '" value="1" onfocus="this.select()"></td>' +
      '<td><select id="dnb-comp-src-' + key + '" tabindex="-1" ' +
        'onchange="GNYDNB.markSourceManual(\\'' + key + '\\')">' +
        optionsHtml(ITEM_SOURCES,'v','l',null) + '</select></td>' +
      '<td><button type="button" class="btn-x" tabindex="-1" ' +
        'onclick="GNYDNB.removeRow(\\'dnb-comp-' + key + '\\')" ' +
        'title="Remove component" aria-label="Remove component">&times;</button></td>';
    \$('dnb-compBody-' + fam).appendChild(tr);

    if (focusNew){
      var el = \$('dnb-comp-item-' + key);
      if (el) el.focus();
    }
    return i;
  }

  function removeRow(id){
    var el = \$(id);
    if (el) el.parentNode.removeChild(el);
  }

  // ── component autocomplete ──────────────────────────────────────────────
  function acInput(key){
    clearTimeout(acTimers[key]);
    \$('dnb-comp-id-' + key).value = '';
    var val = \$('dnb-comp-item-' + key).value.trim();
    if (val.length < SEARCH_MIN_CHARS){ closeAc(key); return; }

    var ck = val.toUpperCase();
    if (acQueryCache[ck]){          // instant — no round trip
      acData[key] = acQueryCache[ck];
      acRender(key);
      return;
    }
    acTimers[key] = setTimeout(function(){ acFetch(key, val); }, 200);
  }

  function acFetch(key, term){
    var ck = term.toUpperCase();
    var xhr = new XMLHttpRequest();
    xhr.open('GET', baseUrl() + '&api=items&term=' + encodeURIComponent(term), true);
    xhr.onload = function(){
      try {
        var t = xhr.responseText, s = t.indexOf('['), e = t.lastIndexOf(']');
        if (s === -1){ closeAc(key); return; }
        acData[key] = JSON.parse(t.slice(s, e+1));
        acQueryCache[ck] = acData[key];
        acRender(key);
      } catch(err){ closeAc(key); }
    };
    xhr.onerror = function(){ closeAc(key); };
    xhr.send();
  }

  function acRender(key){
    var list = \$('dnb-ac-' + key), d = acData[key] || [];
    if (!d.length){ closeAc(key); return; }
    var h = '';
    for (var k=0;k<d.length;k++){
      h += '<div class="ac-item" onclick="GNYDNB.acPick(\\'' + key + '\\',' + k + ')">' +
           '<span class="ac-id">' + esc(d[k].itemid) + '</span>' +
           '<span class="ac-desc">' + esc(d[k].desc) + '</span></div>';
    }
    list.innerHTML = h;
    list.classList.add('open');
    acActive[key] = -1;
  }

  function acKey(e, key){
    var list = \$('dnb-ac-' + key);
    if (!list.classList.contains('open')) return;
    var items = list.querySelectorAll('.ac-item');
    // Reading acActive[key] with || -1 would treat index 0 as falsy, so
    // ArrowDown snaps back to the first row on every press after the first.
    // Read the index explicitly instead.
    var cur = (typeof acActive[key] === 'number') ? acActive[key] : -1;
    if (e.key === 'ArrowDown'){
      acActive[key] = Math.min(cur+1, items.length-1); acHi(key, items); e.preventDefault();
    } else if (e.key === 'ArrowUp'){
      acActive[key] = Math.max(cur-1, 0); acHi(key, items); e.preventDefault();
    } else if (e.key === 'Enter'){
      if (acActive[key] >= 0){ acPick(key, acActive[key]); e.preventDefault(); }
    } else if (e.key === 'Escape'){
      closeAc(key);
    }
  }

  function acHi(key, items){
    for (var k=0;k<items.length;k++) items[k].classList.toggle('active', k === acActive[key]);
    if (acActive[key] >= 0) items[acActive[key]].scrollIntoView({ block:'nearest' });
  }

  function acPick(key, k){
    var d = (acData[key]||[])[k];
    if (!d) return;
    \$('dnb-comp-item-' + key).value = d.itemid + '  —  ' + d.desc;
    \$('dnb-comp-id-' + key).value = d.id;

    var row = \$('dnb-comp-' + key);
    if (row) row.dataset.itemType = d.type || '';

    if (!row || row.dataset.srcManual !== '1'){
      var sel = \$('dnb-comp-src-' + key);
      sel.value = SOURCE_BY_ITEMTYPE[d.type] || SOURCE_FALLBACK;
      sel.title = 'Set from item type: ' + (d.type || 'unknown');
    }

    closeAc(key);
    // Land on quantity — the only thing left to type on this row.
    var qty = \$('dnb-comp-qty-' + key);
    if (qty){ qty.focus(); qty.select(); }
  }

  function markSourceManual(key){
    var row = \$('dnb-comp-' + key);
    if (row) row.dataset.srcManual = '1';
    var sel = \$('dnb-comp-src-' + key);
    if (sel) sel.title = 'Set manually';
  }

  function closeAc(key){
    var l = \$('dnb-ac-' + key);
    if (l) l.classList.remove('open');
  }

  function closeAllAc(){
    var l = root.querySelectorAll('.ac-list');
    for (var i=0;i<l.length;i++) l[i].classList.remove('open');
  }

  // ── routing steps ───────────────────────────────────────────────────────
  // Matches a catalog name against what the account actually has: exact
  // first, then starts-with, then contains, all whitespace-normalised. That
  // normalisation is what makes "DR  Core Lamination" (double space, and yes
  // that is its real name) resolve.
  function matchByName(list, wanted){
    if (!wanted) return '';
    var w = norm(wanted), i, n;
    for (i=0;i<list.length;i++){ if (norm(list[i].name) === w) return list[i].id; }
    for (i=0;i<list.length;i++){ if (norm(list[i].name).indexOf(w) === 0) return list[i].id; }
    for (i=0;i<list.length;i++){ if (norm(list[i].name).indexOf(w) !== -1) return list[i].id; }
    return '';
  }

  function opOptionsHtml(fam){
    var cat = OPERATIONS[fam] || [];
    var h = '<option value="">— select —</option>';
    for (var i=0;i<cat.length;i++){
      h += '<option value="' + i + '">' + esc(cat[i].op) + '</option>';
    }
    h += '<option value="custom">— other —</option>';
    return h;
  }

  // Fills sequence, work center, cost template, run rate and setup from the
  // family's own catalog — which is the whole point of keying operations by
  // family. EXT CUT on a core costs differently from EXT CUT on a frame.
  function onOpChange(fam, i){
    var key = fam + i;
    var sel = \$('dnb-step-op-' + key);
    var txt = \$('dnb-step-optxt-' + key);
    var val = sel.value;

    if (val === 'custom'){
      sel.style.display = 'none';
      txt.style.display = '';
      txt.value = '';
      txt.focus();
      return;
    }

    txt.style.display = 'none';
    txt.value = '';
    if (val === '') return;

    var o = (OPERATIONS[fam] || [])[parseInt(val, 10)];
    if (!o) return;

    \$('dnb-step-seq-' + key).value = o.seq;
    \$('dnb-step-run-' + key).value = o.run;
    \$('dnb-step-setup-' + key).value = o.setup;

    var wcId = matchByName(WORK_CENTERS, o.wc);
    var ctId = matchByName(COST_TEMPLATES, o.ct);
    \$('dnb-step-wc-' + key).value = wcId;
    \$('dnb-step-ct-' + key).value = ctId;

    // Flag anything the account couldn't resolve rather than saving it blank.
    \$('dnb-step-wc-' + key).classList.toggle('bad', !wcId);
    \$('dnb-step-ct-' + key).classList.toggle('bad', !ctId);
    \$('dnb-step-wc-' + key).title = wcId ? '' : 'No work center named "' + o.wc + '" — pick one.';
    \$('dnb-step-ct-' + key).title = ctId ? '' : 'No cost template named "' + o.ct + '" — pick one.';
  }

  function opRevert(fam, i){
    var key = fam + i;
    var sel = \$('dnb-step-op-' + key), txt = \$('dnb-step-optxt-' + key);
    txt.style.display = 'none';
    txt.value = '';
    sel.style.display = '';
    sel.value = '';
  }

  function stepOperationName(fam, i){
    var key = fam + i;
    var sel = \$('dnb-step-op-' + key), txt = \$('dnb-step-optxt-' + key);
    if (sel.value === 'custom') return txt.value.trim().toUpperCase();
    if (sel.value === '') return '';
    var o = (OPERATIONS[fam] || [])[parseInt(sel.value, 10)];
    return o ? o.op : '';
  }

  function addStep(fam, focusNew){
    var i = stepCount[fam]++;
    var key = fam + i;
    var tr = document.createElement('tr');
    tr.id = 'dnb-step-' + key;
    tr.innerHTML =
      '<td><input class="num" id="dnb-step-seq-' + key + '" value="" tabindex="-1"></td>' +
      '<td>' +
        '<select id="dnb-step-op-' + key + '" class="tabstop" onchange="GNYDNB.onOpChange(\\'' + fam + '\\',' + i + ')">' +
          opOptionsHtml(fam) + '</select>' +
        '<input id="dnb-step-optxt-' + key + '" style="display:none" placeholder="Operation name" ' +
          'autocomplete="off" onblur="if(!this.value.trim())GNYDNB.opRevert(\\'' + fam + '\\',' + i + ')">' +
      '</td>' +
      '<td><select id="dnb-step-wc-' + key + '" tabindex="-1">' +
        optionsHtml(WORK_CENTERS,'id','name','— none —') + '</select></td>' +
      '<td><select id="dnb-step-ct-' + key + '" tabindex="-1">' +
        optionsHtml(COST_TEMPLATES,'id','name','— none —') + '</select></td>' +
      '<td><input class="num" id="dnb-step-run-' + key + '" value="5" tabindex="-1"></td>' +
      '<td><input class="num" id="dnb-step-setup-' + key + '" value="0" tabindex="-1"></td>' +
      '<td><button type="button" class="btn-x" tabindex="-1" ' +
        'onclick="GNYDNB.removeRow(\\'dnb-step-' + key + '\\')" ' +
        'title="Remove step" aria-label="Remove step">&times;</button></td>';
    \$('dnb-stepBody-' + fam).appendChild(tr);

    if (focusNew){
      var el = \$('dnb-step-op-' + key);
      if (el) el.focus();
    }
    return i;
  }

  // ── templates ───────────────────────────────────────────────────────────
  // The picker decides what every grid below it starts as. Templates are
  // discovered server-side, so building DR-6000-TEMPLATE in NetSuite is all
  // it takes to add an option here.
  var templateFill = null;    // fill payload for the currently selected template

  // The door currently being copied, held in the SAME shape as a template fill
  // payload so applyTemplate and fillFamily consume it without knowing the
  // difference. Non-null means every create builds a new family off this door
  // rather than off the picker's template, and the form comes back as this
  // door after each one — which is what turns a run of ten sizes, or a
  // left/right pair for both sides of the RV, into one pass.
  var cloneSource = null;

  // Snapshots the loaded door into that shape. editData already carries
  // components with their item numbers and descriptions, and steps with their
  // work centers and cost templates, because loadFamilyUnit reads the same
  // fields loadTemplateFill does. So this is a reshape, not a second trip.
  //
  // DR components here are the LOOSE HARDWARE only — loadDoorForEdit already
  // split the frame/core/screen lines off into subLines. That is exactly what
  // is wanted: the copy's own sub-assemblies get re-derived from its new
  // number, the same way a template's placeholder ones are stripped.
  function cloneFillFromEdit(){
    if (!editData) return null;
    var out = {
      ok: true,
      key: editData.doorNumber,
      series: editData.series,
      classId: editData.classId || '',
      // Templates load into edit mode like any other door family, so copying
      // one into a real door is a fair move — but its description carries the
      // TEMPLATE marker on the front and that must not ride onto a door
      // anybody ships. Same strip the server does on the template fill path.
      description: String(editData.description || '')
                     .replace(/^\\s*TEMPLATE\\s*[-:]?\\s*/i, '').trim(),
      cutDetails: editData.cutDetails || '',
      doorLine: editData.doorLine || '',
      purchasePrice: editData.purchasePrice || '',
      hasScreen: !!editData.families.S,
      // The tube's GRIDS carry over, its NUMBER never does. Engineering issues
      // one number per tube and every door gets its own, so reusing the source
      // door's number would quietly point two doors at one tube — exactly the
      // sharing that made 1001253 turn up on two doors.
      hasTube: !!editData.families.T,
      families: {},
      warnings: []
    };
    for (var i=0;i<ALL_UNITS.length;i++){
      var f = ALL_UNITS[i], u = editData.families[f];
      if (!u) continue;
      out.families[f] = {
        itemId: u.itemId,
        partNumber: u.partNumber,
        components: (u.components || []).slice(),
        steps: (u.steps || []).slice()
      };
    }
    return out;
  }

  function startCopy(){
    if (mode !== 'edit' || !editData){
      showError('Load a door first — Copy works on the door currently open.');
      return;
    }
    var snap = cloneFillFromEdit();
    if (!snap || !snap.families.DR){
      showError('That door could not be read well enough to copy.');
      return;
    }

    // exitEditMode leaves the grids alone on purpose, but it also resets the
    // note and the picker, so everything cosmetic is set after it, not before.
    cloneSource = snap;
    exitEditMode('');

    \$('dnb-screen').checked = !!snap.hasScreen;
    toggleScreen();
    \$('dnb-tube').checked = !!snap.hasTube;
    toggleTube();
    classUserSet = false;
    applyTemplate(snap, false);   // description, class, cut details, every grid

    \$('dnb-number').value = '';
    setHint('dnb-numberHint', '', '');
    // Blanked on purpose — a copy needs its OWN tube number from engineering.
    \$('dnb-tubeNumber').value = '';
    tubeSetGridsEnabled(true);
    if (snap.hasTube){
      setHint('dnb-tubeHint', 'Enter this door\\u2019s own tube number — ' +
        'the copied one belongs to ' + snap.key + '.', 'bad');
    }
    fetchNextNumber();

    setHint('dnb-templateHint',
      'Copying ' + snap.key + ' — pick a template to stop.', 'good');
    updateCopyBanner();
    // The description is the only thing that usually changes between copies,
    // so land on it selected and ready to retype.
    \$('dnb-desc').focus();
    \$('dnb-desc').select();
  }

  // Picking a template, re-filling from one, or loading another door ends a
  // copy run. Nothing else does, so a create rolls straight into the next size.
  function stopCopy(){
    if (!cloneSource) return;
    cloneSource = null;
    \$('dnb-editBanner').classList.remove('open');
    \$('dnb-doorNote').textContent = DOOR_NOTE_NEW;
  }

  function updateCopyBanner(){
    if (!cloneSource || mode !== 'new') return;
    \$('dnb-doorNote').textContent = 'Copying ' + cloneSource.key +
      ' — same components and routing, new number.';
    \$('dnb-editBanner').textContent =
      'Copying ' + cloneSource.key + '. Every create builds a NEW door family from these ' +
      'grids, then hands back the next free number with the same setup still loaded, so a run ' +
      'of sizes or a left/right pair goes back to back. Item fields are inherited from ' +
      cloneSource.key + ' rather than from a template. Change the size or the hinge hand in ' +
      'the description before each one. Pick a template to stop copying.';
    \$('dnb-editBanner').classList.add('open');
  }

  // What the LAST template put into the series, description and cut boxes.
  // Switching templates has to overwrite its own leftovers without eating
  // anything a person typed, and "is the box empty?" cannot tell those two
  // apart — on page load the boot template fills all three, so an emptiness
  // test says "occupied, leave it" and the next template you pick silently
  // keeps the old one's description and series. Remembering what was seeded
  // is what distinguishes them.
  var seededDesc = null;
  var seededCut = null;
  var seededSeries = null;

  // A field is still the template's to overwrite when it is empty, or when it
  // holds exactly what the last template put there. The moment someone edits
  // it, it becomes theirs and only an explicit Re-fill takes it back.
  function templateOwned(el, seeded){
    if (!el) return false;
    var v = String(el.value == null ? '' : el.value).trim();
    return !v || (seeded !== null && v === String(seeded).trim());
  }

  function templateOptionsHtml(){
    var h = ALLOW_NO_TEMPLATE ? '<option value="">— none (blank form) —</option>' : '';
    for (var i=0;i<TEMPLATES.length;i++){
      h += '<option value="' + esc(TEMPLATES[i].key) + '">' + esc(TEMPLATES[i].label) +
           '  [' + TEMPLATES[i].families.join('/') + ']</option>';
    }
    return h;
  }

  function setTemplatePickerEnabled(on, msg){
    \$('dnb-template').disabled = !on;
    \$('dnb-refillBtn').disabled = !on;
    // "+ New template" stays live in edit mode on purpose — turning a door
    // that came out well into a template is one of the two reasons the button
    // exists. It reads the grids, which in edit mode hold that door's setup.
    \$('dnb-newTplBtn').disabled = !ALLOW_TEMPLATE_CREATION;
    if (!on) closeNewTemplate();
    setHint('dnb-templateHint', msg || '', on ? '' : 'bad');
  }

  function selectedTemplate(){
    var k = \$('dnb-template').value;
    if (!k) return null;
    for (var i=0;i<TEMPLATES.length;i++){ if (TEMPLATES[i].key === k) return TEMPLATES[i]; }
    return null;
  }

  // True once anything has been typed into a grid, so re-filling can ask
  // first instead of silently throwing away work.
  function gridsAreDirty(){
    for (var i=0;i<ALL_UNITS.length;i++){
      var fam = ALL_UNITS[i];
      for (var r=0;r<rowCount[fam];r++){
        var el = \$('dnb-comp-item-' + fam + r);
        if (el && el.value.trim()) return true;
      }
    }
    return false;
  }

  function onTemplateChange(){
    stopCopy();
    var t = selectedTemplate();
    if (!t){
      templateFill = null;
      setHint('dnb-templateHint', 'Blank form — grids start empty.', '');
      seedAllFamilies();
      return;
    }
    fetchTemplate(t.key, function(fill){
      templateFill = fill;
      applyTemplate(fill, true);
    });
  }

  // Explicit "Re-fill" — the escape hatch for when you've edited the grids
  // and want to start over without losing the number or description. It is
  // ALSO the override for a template edited in NetSuite: it forces a live
  // re-read, past the page's FILL_CACHE and past the server cache.
  function refill(){
    if (mode === 'edit'){
      setHint('dnb-templateHint', 'Templates do not apply while editing an existing door.', 'bad');
      return;
    }
    if (gridsAreDirty() &&
        !window.confirm('Re-fill from the template? Component and routing rows will be replaced.')){
      return;
    }
    stopCopy();
    var t = selectedTemplate();
    if (!t){ seedAllFamilies(); return; }
    fetchTemplate(t.key, function(fill){
      templateFill = fill;
      applyTemplate(fill, false);   // false = overwrite description/cut too
    }, true);                        // true = ignore every cache, re-read NetSuite
  }

  // force = skip the in-page cache AND tell the server to skip its own, so
  // what lands in the grids is what is in NetSuite right now.
  function fetchTemplate(key, done, force){
    if (!force && FILL_CACHE[key]){ done(FILL_CACHE[key]); return; }
    if (force) delete FILL_CACHE[key];
    setHint('dnb-templateHint', (force ? 'Re-reading ' : 'Loading ') + key + '…', '');
    var xhr = new XMLHttpRequest();
    xhr.open('GET', baseUrl() + '&api=template&term=' + encodeURIComponent(key) +
             (force ? '&fresh=1' : ''), true);
    xhr.onload = function(){
      try {
        var t = xhr.responseText, s = t.indexOf('{'), e = t.lastIndexOf('}');
        var r = JSON.parse(t.slice(s, e+1));
        if (!r.ok){ setHint('dnb-templateHint', r.message || 'Could not load template.', 'bad'); return; }
        FILL_CACHE[key] = r;
        done(r);
      } catch(err){
        setHint('dnb-templateHint', 'Unexpected response loading the template.', 'bad');
      }
    };
    xhr.onerror = function(){ setHint('dnb-templateHint', 'Request failed.', 'bad'); };
    xhr.send();
  }

  // Fills every grid from the template: components with their quantities and
  // sources, routing steps with their work centers and cost templates. The
  // job left is adjusting quantities to the new door's size.
  //
  // gentle = true when the fill was triggered by switching templates rather
  // than by an explicit Re-fill. It leaves an already-typed description and
  // cut list alone, because losing what you typed to a stray dropdown change
  // is worse than a stale starting description.
  function applyTemplate(fill, gentle){
    if (!fill){ seedAllFamilies(); return; }

    // Series first — syncDescriptionSeries() below prepends whatever is in
    // this box to the description, so it has to already be the new one.
    if (fill.series && (!gentle || templateOwned(\$('dnb-series'), seededSeries))){
      if (\$('dnb-series').value !== fill.series){
        \$('dnb-series').value = fill.series;
        onSeriesChange();
      }
      seededSeries = fill.series;
    }
    // The template's own class beats the one the series implies — it is the
    // more specific answer, and onSeriesChange has just written the other.
    if (fill.classId && !classUserSet){
      \$('dnb-class').value = fill.classId;
      setHint('dnb-classHint', 'From ' + fill.key, '');
    }
    if (SEED_DESC && fill.description &&
        (!gentle || templateOwned(\$('dnb-desc'), seededDesc))){
      \$('dnb-desc').value = fill.description;
      syncDescriptionSeries();
      // Recorded AFTER the sync, because that is what is actually in the box.
      seededDesc = \$('dnb-desc').value;
    }
    if (SEED_CUT && fill.cutDetails &&
        (!gentle || templateOwned(\$('dnb-cut'), seededCut))){
      \$('dnb-cut').value = fill.cutDetails;
      seededCut = \$('dnb-cut').value;
    }
    // Door line and purchase price are never seeded from a TEMPLATE (they are
    // per-door values, not part of a reusable setup — loadTemplateFill never
    // sets these keys). Copying a real door is different: cloneFillFromEdit
    // does set them, and !gentle there means they carry straight over as a
    // starting point for the next size, same as the cut list does.
    if (fill.doorLine !== undefined && !gentle){
      \$('dnb-doorLine').value = fill.doorLine || '';
    }
    if (fill.purchasePrice !== undefined && !gentle){
      \$('dnb-purchasePrice').value = fill.purchasePrice || '';
    }

    for (var i=0;i<ALL_UNITS.length;i++){
      var fam = ALL_UNITS[i];
      if (fam === 'S' && !\$('dnb-screen').checked){ clearFamilyGrids(fam); continue; }
      if (fam === 'T' && !\$('dnb-tube').checked){ clearFamilyGrids(fam); continue; }
      fillFamily(fam, fill.families ? fill.families[fam] : null);
    }

    var counts = [];
    for (var k=0;k<ALL_UNITS.length;k++){
      var f = ALL_UNITS[k];
      if (f === 'S' && !\$('dnb-screen').checked) continue;
      if (f === 'T' && !\$('dnb-tube').checked) continue;
      counts.push(FAMILY_LABEL[f].toLowerCase() + ' ' + rowCount[f] +
                  (BUILDS_ROUTING[f] ? '/' + stepCount[f] : ''));
    }
    setHint('dnb-templateHint',
      'Filled from ' + fill.key + ' — ' + counts.join(', ') + '. Adjust quantities.', 'good');

    refreshNumbers();
    updatePreview();
  }

  // Families filled from a reference door that do NOT exist for this door yet
  // and so must be BUILT on save rather than updated. Cleared whenever a door
  // is loaded or the form resets.
  var toCreateFamilies = {};
  var referenceDoor = '';

  // Pulls a reference door's ENTIRE family setup into the form: the door's own
  // loose hardware, plus the frame, core, screen and tube grids. Families this
  // door already has are refilled in place; families it lacks are marked to be
  // BUILT on save, from this door's own number. That is the whole point — a
  // door whose sub-assemblies were never set up gets a working family off a
  // similar door, and the only job left is adjusting quantities.
  function fillFromReferenceDoor(term){
    setHint('dnb-copyFromHint-DR', 'Loading ' + term.toUpperCase() + '…', '');
    var xhr = new XMLHttpRequest();
    xhr.open('GET', baseUrl() + '&api=loaddoor&forcopy=1&term=' + encodeURIComponent(term), true);
    xhr.onload = function(){
      var r;
      try {
        var t = xhr.responseText, s = t.indexOf('{'), e = t.lastIndexOf('}');
        r = JSON.parse(t.slice(s, e+1));
      } catch(err){
        setHint('dnb-copyFromHint-DR', 'Unexpected response.', 'bad'); return;
      }
      if (!r.ok){ setHint('dnb-copyFromHint-DR', r.message || 'Not found.', 'bad'); return; }
      if (normUp(r.doorNumber) === normUp(editData.doorNumber)){
        setHint('dnb-copyFromHint-DR', 'That is this door. Pick a different one.', 'bad'); return;
      }

      referenceDoor = r.doorNumber;
      toCreateFamilies = {};

      // Mirror the reference: if it carries a screen or a tube, this door gets
      // one too. Its own checkboxes follow, so the cards come into view.
      \$('dnb-screen').checked = !!r.families.S;
      \$('dnb-tube').checked = !!r.families.T;

      var builtList = [], filledList = [];

      for (var i=0;i<ALL_UNITS.length;i++){
        var fam = ALL_UNITS[i];
        var ru = r.families[fam];
        var card = \$('dnb-card-' + fam);

        if (!ru){
          // Reference hasn't got this family either — leave this door's alone.
          if (card && fam !== 'DR') card.style.display = editData.families[fam] ? '' : 'none';
          continue;
        }

        // The DOOR's own frame/core/screen lines are derived per door, never
        // copied — only its loose hardware comes across.
        var comps = (ru.components || []).slice();
        fillFamily(fam, { components: comps, steps: ru.steps || [] });

        if (card) card.style.display = '';

        if (editData.families[fam]) filledList.push(FAMILY_LABEL[fam].toLowerCase());
        else { toCreateFamilies[fam] = true; builtList.push(FAMILY_LABEL[fam].toLowerCase()); }
      }

      // A tube's number is assigned by engineering per door and is never
      // shared, so the reference's is deliberately not carried over. This
      // applies whether or not the core already exists — the tube is built
      // fresh and put onto this door's core either way.
      if (\$('dnb-tube').checked && !editData.families.T){
        \$('dnb-tubeNumber').value = '';
        setHint('dnb-tubeHint', 'Enter this door\\u2019s own tube number — the reference\\u2019s ' +
          'belongs to ' + r.doorNumber + '.', 'bad');
      }

      refreshNumbers();
      updatePreview();
      updateCreateNotice();

      var msg = 'From ' + r.doorNumber + ' — ';
      if (builtList.length) msg += 'will BUILD ' + builtList.join(', ') + '; ';
      if (filledList.length) msg += 'refilled ' + filledList.join(', ') + '; ';
      msg += 'adjust quantities, then Update fields.';
      setHint('dnb-copyFromHint-DR', msg, 'good');
    };
    xhr.onerror = function(){ setHint('dnb-copyFromHint-DR', 'Request failed.', 'bad'); };
    xhr.send();
  }

  function normUp(s){ return String(s == null ? '' : s).trim().toUpperCase(); }

  // The copy box exists to fill a family that has nothing to fill it with. A
  // family that already has a BOM does not need it, and offering it there
  // invites replacing a real BOM with another part's by accident — so it only
  // shows where there is genuinely no BOM yet. In new-door mode nothing has a
  // BOM, so every box shows.
  function refreshCopyBoxes(){
    for (var i=0;i<ALL_UNITS.length;i++){
      var f = ALL_UNITS[i];
      var row = \$('dnb-copyFromRow-' + f);
      if (!row) continue;
      var hasBom = false;
      if (mode === 'edit' && editData && editData.families[f]){
        hasBom = !!editData.families[f].bomId;
      }
      row.style.display = hasBom ? 'none' : '';
    }
  }

  // Says plainly, before anything is saved, which families this save will
  // CREATE — that is a much bigger action than editing fields and should never
  // be a surprise.
  function updateCreateNotice(){
    var fams = [];
    for (var k in toCreateFamilies){ if (toCreateFamilies[k]) fams.push(k); }
    if (!fams.length || mode !== 'edit') return;
    var names = fams.map(function(f){
      return (f === 'T')
        ? (\$('dnb-tubeNumber').value.trim() || 'tube frame')
        : partNumberFor(f);
    });
    \$('dnb-editBanner').textContent =
      'Update fields will BUILD ' + names.join(', ') + ' for ' + editData.doorNumber +
      ' — new item, BOM, revision' +
      (fams.filter(function(f){ return BUILDS_ROUTING[f]; }).length ? ' and routing' : '') +
      ' for each, from the grids below, and put them on the door\\u2019s BOM' +
      (toCreateFamilies.T
        ? ' — except the tube frame, which goes on the CORE\\u2019s BOM, which is where it ' +
          'belongs and where new ones go from now on'
        : '') +
      '. Item fields are inherited from ' + referenceDoor + '. If any of it fails, everything ' +
      'this creates is rolled back and ' + editData.doorNumber + ' is left as it is.';
    \$('dnb-editBanner').classList.add('open');
  }

  // Pulls just the BOM components and routing steps off an existing part and
  // drops them into this family's grids — for a family with no BOM of its
  // own (the tube/frame/core scenario the "no BOM" fix leaves you to fill
  // in), or any family worth re-basing off a similar part instead of typing
  // every row by hand. The job left is adjusting quantities.
  function copyFromPart(fam){
    var el = \$('dnb-copyFrom-' + fam);
    var term = el ? el.value.trim() : '';
    if (!term){ setHint('dnb-copyFromHint-' + fam, 'Enter a part number.', 'bad'); return; }

    // On the DOOR card while editing, this means "set this door up like that
    // one" — the whole family, not just loose hardware.
    if (fam === 'DR' && mode === 'edit' && editData){
      if (gridsAreDirty() &&
          !window.confirm('Fill every grid from ' + term.toUpperCase() +
            '? Components and routing below will be replaced.')){
        return;
      }
      fillFromReferenceDoor(term);
      return;
    }

    if ((rowCount[fam] || (BUILDS_ROUTING[fam] && stepCount[fam])) &&
        !window.confirm('Replace the current ' +
          (BUILDS_ROUTING[fam] ? 'components and routing' : 'loose hardware') + ' for ' +
          FAMILY_LABEL[fam].toLowerCase() + ' with ' + term.toUpperCase() +
          '\\u2019s? Quantities will need adjusting after.')){
      return;
    }

    setHint('dnb-copyFromHint-' + fam, 'Loading ' + term.toUpperCase() + '…', '');
    var xhr = new XMLHttpRequest();
    xhr.open('GET', baseUrl() + '&api=partcopy&term=' + encodeURIComponent(term), true);
    xhr.onload = function(){
      try {
        var t = xhr.responseText, s = t.indexOf('{'), e = t.lastIndexOf('}');
        var r = JSON.parse(t.slice(s, e+1));
        if (!r.ok){ setHint('dnb-copyFromHint-' + fam, r.message || 'Not found.', 'bad'); return; }

        var comps = r.components || [];
        var droppedSubs = 0;
        // The DOOR's own frame/core/screen lines are derived from ITS number
        // and written by the build, so copying another door's would point this
        // one at that door's sub-assemblies. Only loose hardware carries over.
        // Same shape-test the server uses: a family prefix, or a bare 6+ digit
        // number (a tube frame).
        if (fam === 'DR'){
          var before = comps.length;
          comps = comps.filter(function(c){
            var n = String(c.itemNumber || '').toUpperCase();
            return !/^(DR|F|C|S)-[0-9]+-/.test(n) && !/^[0-9]{6,}\$/.test(n);
          });
          droppedSubs = before - comps.length;
        }

        fillFamily(fam, { components: comps, steps: r.steps });
        refreshNumbers();
        updatePreview();
        setHint('dnb-copyFromHint-' + fam,
          'Filled from ' + r.partNumber + ' — adjust quantities.' +
          (droppedSubs ? ' ' + droppedSubs + ' sub-assembly line(s) skipped — ' +
            'this door\\u2019s own are derived from its number.' : ''), 'good');
      } catch(err){
        setHint('dnb-copyFromHint-' + fam, 'Unexpected response.', 'bad');
      }
    };
    xhr.onerror = function(){ setHint('dnb-copyFromHint-' + fam, 'Request failed.', 'bad'); };
    xhr.send();
  }

  // One family's grids from the template's own BOM and routing. A family the
  // template doesn't have (no screen on DR-4000-TEMPLATE) falls back to the
  // built-in catalog default rather than opening empty.
  function fillFamily(fam, unit){
    clearFamilyGrids(fam);

    if (!unit){ seedFamily(fam); return; }

    (unit.components || []).forEach(function(c){
      var i = addComponent(fam, false);
      \$('dnb-comp-item-' + fam + i).value = c.itemNumber + '  —  ' + c.desc;
      \$('dnb-comp-id-' + fam + i).value = c.itemId;
      \$('dnb-comp-qty-' + fam + i).value = c.quantity;
      \$('dnb-comp-src-' + fam + i).value = c.itemSource;
      var row = \$('dnb-comp-' + fam + i);
      // Marked manual so the item-type rule can't quietly re-source a line
      // the template already decided.
      if (row){ row.dataset.itemType = c.itemType || ''; row.dataset.srcManual = '1'; }
    });
    // Always leave one blank row so adding a component needs no extra click.
    addComponent(fam, false);

    if (!BUILDS_ROUTING[fam]) return;

    (unit.steps || []).forEach(function(s){
      var i = addStep(fam, false);
      \$('dnb-step-seq-' + fam + i).value = s.sequence;
      // Match the loaded step back onto the catalog by name AND cost
      // template — EXT CUT exists on both frames and cores with different
      // templates, so the name alone cannot say which entry this is.
      var opIdx = -1, nameHit = -1;
      var cat = OPERATIONS[fam] || [];
      for (var q=0;q<cat.length;q++){
        if (norm(cat[q].op) !== norm(s.operationName)) continue;
        if (nameHit === -1) nameHit = q;
        if (s.costTemplateId &&
            String(matchByName(COST_TEMPLATES, cat[q].ct)) === String(s.costTemplateId)){
          opIdx = q; break;
        }
      }
      if (opIdx === -1) opIdx = nameHit;
      if (opIdx >= 0){
        \$('dnb-step-op-' + fam + i).value = opIdx;
      } else {
        // An operation the catalog doesn't know still has to survive the
        // round trip, so it comes back as a custom step rather than blank.
        \$('dnb-step-op-' + fam + i).value = 'custom';
        onOpChange(fam, i);
        \$('dnb-step-optxt-' + fam + i).value = s.operationName;
      }
      // The template's own values win over the catalog defaults onOpChange
      // just wrote — the template is the more specific answer.
      \$('dnb-step-wc-' + fam + i).value = s.workCenterId || '';
      \$('dnb-step-ct-' + fam + i).value = s.costTemplateId || '';
      \$('dnb-step-run-' + fam + i).value = s.runRate;
      \$('dnb-step-setup-' + fam + i).value = s.setupTime;
    });

    if (!(unit.steps || []).length) seedSteps(fam);
  }

  function clearFamilyGrids(fam){
    \$('dnb-compBody-' + fam).innerHTML = ''; rowCount[fam] = 0;
    if (BUILDS_ROUTING[fam]){
      \$('dnb-stepBody-' + fam).innerHTML = ''; stepCount[fam] = 0;
    }
  }

  // No template for this family: blank component rows plus the routing the
  // shop most often runs, from the built-in catalog.
  function seedFamily(fam){
    clearFamilyGrids(fam);
    var n = DEFAULT_COMPONENT_ROWS[fam] || 1;
    for (var i=0;i<n;i++) addComponent(fam, false);
    seedSteps(fam);
  }

  function seedSteps(fam){
    if (!BUILDS_ROUTING[fam]) return;
    \$('dnb-stepBody-' + fam).innerHTML = ''; stepCount[fam] = 0;
    var wanted = DEFAULT_STEPS[fam] || [];
    var cat = OPERATIONS[fam] || [];
    for (var k=0;k<wanted.length;k++){
      var idx = -1;
      for (var q=0;q<cat.length;q++){ if (cat[q].op === wanted[k]){ idx = q; break; } }
      var row = addStep(fam, false);
      if (idx >= 0){
        \$('dnb-step-op-' + fam + row).value = idx;
        onOpChange(fam, row);
      }
    }
    if (!wanted.length) addStep(fam, false);
  }

  function seedAllFamilies(){
    seedFamily('DR');
    seedFamily('F');
    seedFamily('C');
    if (\$('dnb-screen').checked) seedFamily('S');
    else clearFamilyGrids('S');
    refreshNumbers();
    updatePreview();
  }

  // ── preview ─────────────────────────────────────────────────────────────
  // Grows the description box to whatever is in it, so a long one is fully
  // visible without a scroll and a short one does not leave a hole. Called
  // from updatePreview, which runs after every path that writes the box —
  // typing, template fill, door load, copy, reset.
  function autoGrowDesc(){
    var el = \$('dnb-desc');
    if (!el) return;
    el.style.height = 'auto';
    el.style.height = Math.max(el.scrollHeight, 34) + 'px';
  }

  // One line next to the Create button. The per-family part numbers, BOM and
  // revision names are already printed at the top of each family card, so a
  // second list of them up here was saying the same thing twice.
  function updatePreview(){
    autoGrowDesc();
    var line = \$('dnb-preview');
    if (!line) return;

    if (mode === 'edit' && editData){
      line.innerHTML = 'Editing <b>' + esc(editData.doorNumber) + '</b>';
      return;
    }

    var s = \$('dnb-series').value, n = \$('dnb-number').value.trim();
    if (!s || !n){ line.innerHTML = ''; return; }

    var all = activeUnits();
    var records = 0;
    for (var i=0;i<all.length;i++) records += 3 + (BUILDS_ROUTING[all[i]] ? 1 : 0);
    line.innerHTML = 'Creates <b>' + esc(partNumberFor('DR')) + '</b> &middot; ' +
                     records + ' records across ' + all.length + ' items';
  }

  // ── payload ─────────────────────────────────────────────────────────────
  // Collects one family's grids. Returns null (after showing the error) if
  // something typed never resolved to a real item.
  function collectFamily(fam){
    var out = { components: [], steps: [] };
    var i;
    for (i=0;i<rowCount[fam];i++){
      var key = fam + i;
      if (!\$('dnb-comp-' + key)) continue;
      var itemId = \$('dnb-comp-id-' + key).value;
      var typed = \$('dnb-comp-item-' + key).value.trim();
      if (!itemId){
        if (typed){
          showError(FAMILY_LABEL[fam] + ': pick "' + typed +
                    '" from the search list so it resolves to a real part.');
          return null;
        }
        continue;
      }
      out.components.push({
        itemId: itemId,
        quantity: \$('dnb-comp-qty-' + key).value,
        itemSource: \$('dnb-comp-src-' + key).value
      });
    }

    if (BUILDS_ROUTING[fam]){
      for (i=0;i<stepCount[fam];i++){
        var sk = fam + i;
        if (!\$('dnb-step-' + sk)) continue;
        var op = stepOperationName(fam, i);
        if (!op) continue;
        var seqVal = \$('dnb-step-seq-' + sk).value.trim();
        if (!seqVal){
          showError(FAMILY_LABEL[fam] + ': ' + op + ' has no sequence number.');
          return null;
        }
        out.steps.push({
          sequence: seqVal,
          operationName: op,
          workCenterId: \$('dnb-step-wc-' + sk).value,
          costTemplateId: \$('dnb-step-ct-' + sk).value,
          runRate: \$('dnb-step-run-' + sk).value,
          setupTime: \$('dnb-step-setup-' + sk).value
        });
      }
    }
    return out;
  }

  function postJson(payload, onDone){
    var xhr = new XMLHttpRequest();
    xhr.open('POST', baseUrl(), true);
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.onload = function(){
      try {
        var t = xhr.responseText, s = t.indexOf('{'), e = t.lastIndexOf('}');
        onDone(JSON.parse(t.slice(s, e+1)));
      } catch(err){
        onDone({ ok: false, message: 'Unexpected response from NetSuite. Check the script execution log.' });
      }
    };
    xhr.onerror = function(){
      onDone({ ok: false, message: 'Request failed. Check your connection and the script execution log.' });
    };
    xhr.send(JSON.stringify(payload));
  }

  // ── creating a template ─────────────────────────────────────────────────
  // A template is built by the same code path as a door — same four records
  // per family, same rollback — just named DR-{series}-TEMPLATE instead of
  // DR-{series}-{number}. So whatever is on the form right now is what gets
  // saved, whether you set it up by hand or loaded a door you liked.
  function openNewTemplate(){
    if (!ALLOW_TEMPLATE_CREATION) return;
    \$('dnb-tplSeries').value = \$('dnb-series').value || '';
    \$('dnb-tplTag').value = '';
    previewTemplateName();
    \$('dnb-newTplPanel').classList.add('open');
    \$('dnb-tplSeries').focus();
  }

  function closeNewTemplate(){
    \$('dnb-newTplPanel').classList.remove('open');
    setHint('dnb-tplHint', '', '');
  }

  function templateNamePreview(){
    var s = \$('dnb-tplSeries').value;
    var tag = \$('dnb-tplTag').value.trim().toUpperCase();
    if (!s) return '';
    return 'DR-' + s + '-' + (tag ? tag + '-' : '') + TEMPLATE_SUFFIX;
  }

  function previewTemplateName(){
    var tag = \$('dnb-tplTag').value.toUpperCase();
    \$('dnb-tplTag').value = tag;
    var name = templateNamePreview();
    \$('dnb-tplName').value = name || '';

    // Say up front if the name is taken, rather than after the round trip.
    var clash = false;
    for (var i=0;i<TEMPLATES.length;i++){
      if (norm(TEMPLATES[i].key) === norm(name)){ clash = true; break; }
    }
    if (!name) setHint('dnb-tplHint', 'Pick a series.', '');
    else if (clash) setHint('dnb-tplHint', name + ' already exists — add a tag, or load it and edit it instead.', 'bad');
    else if (tag && !/^[A-Z0-9][A-Z0-9-]*\$/.test(tag)) setHint('dnb-tplHint', 'Tags can only use letters, digits and dashes.', 'bad');
    else if (tag.length > TEMPLATE_TAG_MAX) setHint('dnb-tplHint', 'Tag is too long.', 'bad');
    else setHint('dnb-tplHint', 'Creates ' + name + ' plus its frame, core' +
      (\$('dnb-screen').checked ? ' and screen' : '') + '.', 'good');
    return !clash && !!name;
  }

  function submitTemplate(){
    if (!previewTemplateName()) return;
    var desc = \$('dnb-desc').value.trim();
    if (!desc){
      setHint('dnb-tplHint', 'Give it a description first — it becomes the starting text for every door built from it.', 'bad');
      \$('dnb-desc').focus();
      return;
    }

    var payload = {
      action: 'buildTemplate',
      series: \$('dnb-tplSeries').value,
      templateTag: \$('dnb-tplTag').value.trim(),
      description: desc,
      classId: \$('dnb-class').value,
      cutDetails: \$('dnb-cut').value,
      doorLine: \$('dnb-doorLine').value.trim(),
      purchasePrice: \$('dnb-purchasePrice').value.trim(),
      includeScreen: \$('dnb-screen').checked,
      includeTube: \$('dnb-tube').checked,
      tubeNumber: \$('dnb-tubeNumber').value.trim(),
      autoIssue: \$('dnb-autoIssue').checked,
      revLetter: 'A',
      families: {}
    };

    var fams = activeUnits();
    for (var i=0;i<fams.length;i++){
      var got = collectFamily(fams[i]);
      if (!got) return;
      payload.families[fams[i]] = got;
    }

    var btn = \$('dnb-saveTplBtn');
    btn.disabled = true; btn.textContent = 'Creating…';

    postJson(payload, function(r){
      btn.disabled = false; btn.textContent = 'Create template';
      if (!r.ok){ showError(r.message, r.rolledBack); return; }

      // Into the picker and selected, without a page reload. The grids
      // already hold exactly what the template holds, so the fill payload is
      // built here rather than fetched back.
      if (r.newTemplate){
        TEMPLATES.push(r.newTemplate);
        TEMPLATES.sort(function(a,b){ return norm(a.key) < norm(b.key) ? -1 : 1; });
        \$('dnb-template').innerHTML = templateOptionsHtml();
        \$('dnb-template').value = r.newTemplate.key;
        delete FILL_CACHE[r.newTemplate.key];
      }
      closeNewTemplate();
      showSuccess(r);
      // showSuccess resets the form, so re-select and re-fill from the
      // template that was just created. The loop is: save a template, land
      // back on it, type a door number, build doors from it.
      if (r.newTemplate) onTemplateChange();
    });
  }

  // ── submit: new door ────────────────────────────────────────────────────
  function submit(){
    var series = \$('dnb-series').value;
    var number = \$('dnb-number').value.trim();
    var desc = \$('dnb-desc').value.trim();
    if (!series){ showError('Pick a door series.'); return; }
    if (!number){ showError('Enter a door number.'); return; }
    if (!desc){ showError('Enter a description.'); return; }

    var payload = {
      action: 'build',
      // The server re-resolves both of these rather than trusting item IDs
      // from the form, so a template renamed — or a source door deleted —
      // since page load fails loudly instead of cloning something else.
      // A copy inherits item fields from its source door, so the template key
      // is deliberately dropped for the duration of a copy run.
      templateKey: cloneSource ? '' : (\$('dnb-template').value || ''),
      sourceDoor: cloneSource ? cloneSource.key : '',
      series: series,
      number: number,
      description: desc,
      classId: \$('dnb-class').value,
      cutDetails: \$('dnb-cut').value,
      doorLine: \$('dnb-doorLine').value.trim(),
      purchasePrice: \$('dnb-purchasePrice').value.trim(),
      includeScreen: \$('dnb-screen').checked,
      includeTube: \$('dnb-tube').checked,
      tubeNumber: \$('dnb-tubeNumber').value.trim(),
      autoIssue: \$('dnb-autoIssue').checked,
      revLetter: \$('dnb-rev').value,
      effectiveDate: \$('dnb-date').value.trim(),
      families: {}
    };

    if (payload.includeTube && !payload.tubeNumber){
      showError('Enter the tube frame number — it is the number engineering assigned.');
      \$('dnb-tubeNumber').focus();
      return;
    }

    var fams = activeUnits();
    for (var i=0;i<fams.length;i++){
      var got = collectFamily(fams[i]);
      if (!got) return;
      payload.families[fams[i]] = got;
    }

    var btn = \$('dnb-submit');
    btn.disabled = true;
    btn.textContent = 'Creating…';

    postJson(payload, function(r){
      btn.disabled = false;
      btn.textContent = 'Create door';
      if (r.ok) showSuccess(r); else showError(r.message, r.rolledBack);
    });
  }

  // ── submit: edit mode ───────────────────────────────────────────────────
  function buildEditPayload(action){
    if (!editData) return null;
    var desc = \$('dnb-desc').value.trim();
    if (!desc){ showError('Enter a description.'); return null; }

    var payload = {
      action: action,
      doorNumber: editData.doorNumber,
      description: desc,
      classId: \$('dnb-class').value,
      cutDetails: \$('dnb-cut').value,
      doorLine: \$('dnb-doorLine').value.trim(),
      purchasePrice: \$('dnb-purchasePrice').value.trim(),
      autoIssue: \$('dnb-autoIssue').checked,
      // Where the item fields for any family being BUILT are inherited from.
      referenceDoor: referenceDoor || '',
      families: {}
    };

    for (var i=0;i<ALL_UNITS.length;i++){
      var f = ALL_UNITS[i];
      var u = editData.families[f];

      // Families this door does not have yet, filled from a reference door
      // and flagged to be built on save. They carry no itemId — that is what
      // tells the server to create rather than update — but they do carry the
      // part number this door's own number derives, because the server names
      // every record it builds off it.
      if (!u){
        if (!toCreateFamilies[f]){
          // A card that is on screen with components typed into it, but not
          // marked for creation, means something got out of step. Say so
          // rather than dropping the work silently the way this used to.
          var visible = (f === 'S') ? \$('dnb-screen').checked
                      : (f === 'T') ? \$('dnb-tube').checked : false;
          if (visible && rowCount[f]){
            var anyTyped = false;
            for (var vr=0; vr<rowCount[f]; vr++){
              var vel = \$('dnb-comp-id-' + f + vr);
              if (vel && vel.value){ anyTyped = true; break; }
            }
            if (anyTyped){
              showError(FAMILY_LABEL[f] + ' is filled in but was not marked to be built. ' +
                        'Untick and re-tick its box, then save again.');
              return null;
            }
          }
          continue;
        }
        var newPart = (f === 'T')
          ? \$('dnb-tubeNumber').value.trim().toUpperCase()
          : partNumberFor(f);
        if (!newPart){
          showError(f === 'T'
            ? 'Enter the tube frame number before saving — engineering assigns it.'
            : 'Could not work out the part number for ' + FAMILY_LABEL[f].toLowerCase() + '.');
          return null;
        }
        var mk = collectFamily(f);
        if (!mk) return null;
        payload.families[f] = {
          create: true,
          partNumber: newPart,
          components: mk.components,
          steps: mk.steps
        };
        continue;
      }

      var got = collectFamily(f);
      if (!got) return null;
      payload.families[f] = {
        partNumber: u.partNumber,
        itemId: u.itemId,
        bomId: u.bomId,
        revId: u.revId,
        revName: u.revName,
        routingId: u.routingId,
        newRevName: \$('dnb-newRevName-' + f).value.trim(),
        // The door's sub-assembly lines are sent back as loaded, never from
        // the grid, so they cannot be lost by editing hardware rows.
        subLines: u.subLines || [],
        components: got.components,
        steps: got.steps
      };
    }
    return payload;
  }

  function submitUpdate(){
    var payload = buildEditPayload('updateFields');
    if (!payload) return;
    var btn = \$('dnb-submit'), revBtn = \$('dnb-newRevBtn');
    btn.disabled = true; btn.textContent = 'Saving…'; revBtn.disabled = true;
    postJson(payload, function(r){
      btn.disabled = false; btn.textContent = 'Update fields'; revBtn.disabled = false;
      if (r.ok) showEditSuccess(r); else showError(r.message, null, r.alreadySaved);
    });
  }

  function submitNewRev(){
    var payload = buildEditPayload('newBomRev');
    if (!payload) return;
    for (var f in payload.families){
      if (!payload.families[f].newRevName){
        showError(FAMILY_LABEL[f] + ' needs a name for its new revision.');
        \$('dnb-newRevName-' + f).focus();
        return;
      }
    }
    var btn = \$('dnb-submit'), revBtn = \$('dnb-newRevBtn');
    btn.disabled = true; revBtn.disabled = true; revBtn.textContent = 'Saving…';
    postJson(payload, function(r){
      btn.disabled = false; revBtn.disabled = false; revBtn.textContent = 'Save as new BOM revisions';
      if (r.ok) showEditSuccess(r); else showError(r.message, null, r.alreadySaved);
    });
  }

  // ── results ─────────────────────────────────────────────────────────────
  function showSuccess(r){
    addRecent(r);

    // Each copy becomes the baseline for the next one, so going 30 -> 32 -> 34
    // is one edit each time rather than re-deriving from the original door.
    if (cloneSource && r.copiedFrom && r.description){
      cloneSource.description = r.description;
    }

    var box = \$('dnb-result');
    var h = '<h3>' + esc(r.message) +
      (r.ms ? ' <span class="dim" style="font-weight:400">' + (r.ms/1000).toFixed(1) + 's</span>' : '') +
      '</h3><ul>';
    for (var i=0;i<ALL_UNITS.length;i++){
      var f = ALL_UNITS[i], u = r.families[f];
      if (!u) continue;
      h += '<li><a href="/app/common/item/item.nl?id=' + u.item.id + '" target="_blank">' +
           esc(u.name) + '</a> &middot; ' +
           '<a href="/app/manufacturing/billofmaterials.nl?id=' + u.bom.id + '" target="_blank">BOM</a> &middot; ' +
           '<a href="/app/manufacturing/billofmaterialsrevision.nl?id=' + u.revision.id +
           '" target="_blank">' + esc(u.revision.name) + '</a> (' + u.revision.lines + ' line(s))' +
           (u.routing
             ? ' &middot; <a href="/app/accounting/manufacturing/mfgrouting.nl?id=' + u.routing.id +
               '" target="_blank">routing</a> (' + u.routing.steps + ' step(s))'
             : '') +
           '</li>';
    }
    h += '</ul>';
    if (r.templateUsed){
      h += '<div class="dim" style="font-family:var(--dnb-mono);font-size:10px">' +
           'Item fields inherited from ' + esc(r.templateUsed) + '</div>';
    }
    if (r.timing){
      h += '<div class="dim" style="font-family:var(--dnb-mono);font-size:10px;margin-top:4px">' +
           esc(r.timing) + '</div>';
    }
    if (!AUTO_RESET){
      h += '<div style="margin-top:10px"><button type="button" onclick="GNYDNB.clearForm()">' +
           'Build another door</button></div>';
    }
    box.innerHTML = h;
    box.className = 'result ok open';

    if (AUTO_RESET) clearForm();
    box.scrollIntoView({ block:'nearest' });
  }

  function showEditSuccess(r){
    // Runs FIRST — editData and the description field are both wiped by the
    // reset at the end of this function.
    addRecentEdit(r);

    var box = \$('dnb-result');
    var h = '<h3>' + esc(r.message) +
      (r.ms ? ' <span class="dim" style="font-weight:400">' + (r.ms/1000).toFixed(1) + 's</span>' : '') +
      '</h3><ul>';
    for (var i=0;i<ALL_UNITS.length;i++){
      var f = ALL_UNITS[i], u = r.families[f];
      if (!u) continue;
      h += '<li>' + esc(u.partNumber || u.name);
      if (u.createdNew){
        h += ' &middot; <b>BUILT</b>';
        if (u.item) h += ' <a href="/app/common/item/item.nl?id=' + u.item.id +
                         '" target="_blank">item</a>';
        if (u.bom) h += ' &middot; <a href="/app/manufacturing/billofmaterials.nl?id=' +
                        u.bom.id + '" target="_blank">BOM</a>';
        if (u.revision) h += ' &middot; ' + esc(u.revision.name) +
                             ' (' + u.revision.lines + ' line(s))';
        if (u.routing) h += ' &middot; <a href="/app/accounting/manufacturing/mfgrouting.nl?id=' +
                            u.routing.id + '" target="_blank">routing</a> (' +
                            u.routing.steps + ' step(s))';
        h += '</li>';
        continue;
      }
      if (u.bomCreated){
        h += ' &middot; <a href="/app/manufacturing/billofmaterials.nl?id=' + u.bomCreated.id +
             '" target="_blank">new BOM</a>';
      }
      if (u.closedRevision){
        h += ' &middot; closed ' + esc(u.closedRevision.name) +
             ' (end ' + esc(new Date(u.closedRevision.effectiveEnd).toLocaleDateString()) + ')';
      }
      if (u.revision && !u.revision.skipped){
        var revWord = u.revision.created ? 'created ' : (u.revision.replaced ? 'opened ' : 'updated ');
        h += ' &middot; ' + revWord + esc(u.revision.name) +
             ' (' + u.revision.lines + ' line(s))';
        if (u.revision.note) h += ' <span class="dim">' + esc(u.revision.note) + '</span>';
      }
      if (u.routing){
        h += ' &middot; routing ' + (u.routing.created ? 'created, ' : '') + u.routing.steps + ' step(s)';
        if (u.routing.remapped && u.routing.remapped.length){
          var moves = u.routing.remapped.map(function(m){
            return m.revision + ' line ' + m.line + ': op ' + m.from + ' \\u2192 ' + m.to;
          });
          h += ' <span class="dim">— components repointed off deleted steps: ' +
               esc(moves.join(', ')) + '</span>';
        }
      }
      h += '</li>';
    }
    h += '</ul>';
    box.innerHTML = h;
    box.className = 'result ok open';
    box.scrollIntoView({ block:'nearest' });

    // Reset to an empty form so the next door can be typed straight away. The
    // result box above stays on screen as the record of what saved.
    exitEditMode('');
    clearForm();
  }

  function showError(msg, rolledBack, alreadySaved){
    var box = \$('dnb-result');
    var partial = alreadySaved && alreadySaved.length;
    var h = '<h3>' + (partial ? 'Partly saved' : 'Nothing was saved') + '</h3><ul><li>' + esc(msg) + '</li>';
    if (partial){
      h += '<li class="dim" style="margin-top:6px">Already saved before this failed: ' +
           esc(alreadySaved.join(', ')) + '.</li>';
    }
    if (rolledBack && rolledBack.length){
      h += '<li class="dim" style="margin-top:6px">Rolled back: ' + esc(rolledBack.join(', ')) + '</li>';
    }
    h += '</ul>';
    box.innerHTML = h;
    box.className = 'result err open';
    box.scrollIntoView({ block:'nearest' });
  }

  // ── recent activity ─────────────────────────────────────────────────────
  function loadRecent(){
    try {
      var raw = window.sessionStorage.getItem(RECENT_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch(e){ return []; }
  }

  function saveRecent(list){
    try { window.sessionStorage.setItem(RECENT_KEY, JSON.stringify(list)); } catch(e){}
  }

  function stamp(){
    var d = new Date();
    var hh = d.getHours(), mm = String(d.getMinutes()).padStart(2,'0');
    var ampm = hh >= 12 ? 'pm' : 'am';
    hh = hh % 12; if (hh === 0) hh = 12;
    return hh + ':' + mm + ampm;
  }

  function addRecent(r){
    var list = loadRecent();
    var dr = r.families.DR;
    var parts = [];
    for (var i=0;i<ALL_UNITS.length;i++){
      var f = ALL_UNITS[i], u = r.families[f];
      if (!u || f === 'DR') continue;
      parts.push({ label: f, itemId: u.item.id, part: u.name });
    }
    list.unshift({
      // A template is worth telling apart from a door at a glance — it is the
      // thing other doors get built from, not a door anyone will ship.
      kind: r.asTemplate ? 'template' : (r.copiedFrom ? 'copied' : 'built'),
      part: dr.name,
      itemId: dr.item.id,
      desc: r.description || '',
      bomId: dr.bom.id,
      revId: dr.revision.id,
      lines: dr.revision.lines,
      subs: parts,
      time: stamp()
    });
    if (list.length > RECENT_LIMIT) list = list.slice(0, RECENT_LIMIT);
    saveRecent(list);
    renderRecent(true);
  }

  // Edit saves land in the same rail as builds, so the session's whole trail
  // of work is in one place with the same links out to the records.
  function addRecentEdit(r){
    if (!editData) return;
    var list = loadRecent();
    var dr = r.families.DR || {};
    var rev = dr.revision || {};
    var parts = [];
    for (var i=0;i<ALL_UNITS.length;i++){
      var f = ALL_UNITS[i], u = editData.families[f];
      if (!u || f === 'DR') continue;
      parts.push({ label: f, itemId: u.itemId, part: u.partNumber });
    }
    list.unshift({
      // A new revision is a different thing from an in-place field update —
      // "NEW REV" vs "UPDATED" is the distinction worth seeing at a glance.
      kind: rev.replaced ? 'revised' : 'updated',
      part: editData.doorNumber,
      itemId: editData.families.DR.itemId,
      desc: r.description || '',
      bomId: editData.families.DR.bomId,
      revId: rev.id || editData.families.DR.revId,
      lines: rev.lines || 0,
      subs: parts,
      time: stamp()
    });
    if (list.length > RECENT_LIMIT) list = list.slice(0, RECENT_LIMIT);
    saveRecent(list);
    renderRecent(true);
  }

  function renderRecent(markFirst){
    var list = loadRecent();
    var body = \$('dnb-recentBody');
    var count = \$('dnb-recentCount');
    if (!body) return;

    count.textContent = list.length ? list.length + ' this session' : '';

    if (!list.length){
      body.innerHTML = '<div class="recent-empty">Nothing built or edited yet.</div>';
      return;
    }

    var h = '';
    for (var i=0;i<list.length;i++){
      var r = list[i];
      var kind = r.kind || 'built';
      var tag = kind === 'revised' ? 'NEW REV'
              : kind === 'updated' ? 'UPDATED'
              : kind === 'template' ? 'TEMPLATE'
              : kind === 'copied' ? 'COPY' : 'BUILT';
      // A copy CREATES records, so it belongs on the build side of the rail's
      // colour split, not the edit side.
      h += '<div class="recent' + ((kind === 'built' || kind === 'copied') ? '' : ' edited') +
             (markFirst && i === 0 ? ' fresh' : '') + '">' +
             '<div class="recent-top">' +
               '<span class="recent-part"><a href="/app/common/item/item.nl?id=' + r.itemId +
                 '" target="_blank">' + esc(r.part) + '</a></span>' +
               '<span class="recent-meta">' +
                 '<span class="recent-tag t-' + kind + '">' + tag + '</span>' +
                 '<span class="recent-time">' + esc(r.time) + '</span>' +
               '</span>' +
             '</div>' +
             (r.desc ? '<div class="recent-desc" title="' + esc(r.desc) + '">' + esc(r.desc) + '</div>' : '') +
             '<div class="recent-links">' +
               '<a href="/app/manufacturing/billofmaterials.nl?id=' + r.bomId + '" target="_blank">BOM</a>' +
               '<a href="/app/manufacturing/billofmaterialsrevision.nl?id=' + r.revId +
                 '" target="_blank">REV &middot; ' + r.lines + '</a>' +
               (r.subs || []).map(function(s){
                 return '<a href="/app/common/item/item.nl?id=' + s.itemId +
                        '" target="_blank" title="' + esc(s.part) + '">' + esc(s.label) + '</a>';
               }).join('') +
             '</div>' +
           '</div>';
    }
    h += '<button type="button" class="recent-clear" tabindex="-1" onclick="GNYDNB.clearRecent()">Clear list</button>';
    body.innerHTML = h;
  }

  function clearRecent(){
    saveRecent([]);
    renderRecent(false);
  }

  // ── reset ───────────────────────────────────────────────────────────────
  function setDefaultDate(){
    var d = new Date();
    d.setDate(d.getDate() + DATE_OFFSET);
    \$('dnb-date').value = (d.getMonth()+1) + '/' + d.getDate() + '/' + d.getFullYear();
  }

  // Re-fetches the next free number instead of just incrementing the last
  // one. Someone else may have built a door in the meantime, and a stale
  // suggestion turns into a confusing duplicate failure at submit time.
  function fetchNextNumber(){
    var xhr = new XMLHttpRequest();
    xhr.open('GET', baseUrl() + '&api=nextnumber', true);
    xhr.onload = function(){
      try {
        var t = xhr.responseText, s = t.indexOf('{'), e = t.lastIndexOf('}');
        var r = JSON.parse(t.slice(s, e+1));
        if (r.number && mode === 'new' && !\$('dnb-number').value){
          \$('dnb-number').value = r.number;
          setHint('dnb-numberHint', 'Next free number', 'good');
          refreshNumbers();
          updatePreview();
        }
      } catch(err){}
    };
    xhr.send();
  }

  // Clears in place so the next door can be typed straight away. Deliberately
  // not a page reload — that would wipe the recent list.
  function clearForm(){
    mode = 'new';
    editData = null;
    toCreateFamilies = {};
    referenceDoor = '';
    numReqSeq++;   // abandon any checkdoor/loaddoor still in flight
    \$('dnb-editBanner').classList.remove('open');
    \$('dnb-doorNote').textContent = DOOR_NOTE_NEW;
    setNewOnlyVisible(true);
    setTemplatePickerEnabled(true, '');

    \$('dnb-number').value = '';
    \$('dnb-number').classList.remove('bad');
    setHint('dnb-numberHint', '', '');
    doorAcClose();
    \$('dnb-desc').value = '';
    \$('dnb-cut').value = '';
    // Cleared unless a copy run is what's driving this reset — see below,
    // where cloneSource's own values are re-applied straight after.
    \$('dnb-doorLine').value = '';
    \$('dnb-purchasePrice').value = '';
    \$('dnb-rev').value = 'A';
    \$('dnb-autoIssue').checked = AUTO_ISSUE_DEFAULT;
    // Mid-copy the source door decides whether there is a screen, not the
    // account default — otherwise every copy of a screened door loses it.
    \$('dnb-screen').checked = cloneSource ? !!cloneSource.hasScreen : INCLUDE_SCREEN_DEFAULT;
    \$('dnb-tube').checked = cloneSource ? !!cloneSource.hasTube : INCLUDE_TUBE_DEFAULT;
    // Always blank: the next door in a copy run needs its own tube number.
    \$('dnb-tubeNumber').value = '';
    setHint('dnb-tubeHint', (cloneSource && cloneSource.hasTube)
      ? 'Enter this door\\u2019s own tube number.' : '', '');
    tubeSetGridsEnabled(true);
    classUserSet = false;
    onSeriesChange();
    setDefaultDate();

    acData = {}; acActive = {};
    for (var k in acTimers) clearTimeout(acTimers[k]);
    acTimers = {};

    for (var i=0;i<ALL_UNITS.length;i++){
      var f = ALL_UNITS[i];
      var revRow = \$('dnb-editRev-' + f);
      if (revRow) revRow.style.display = 'none';
      var card = \$('dnb-card-' + f);
      if (!card) continue;
      if (f === 'S') card.style.display = \$('dnb-screen').checked ? '' : 'none';
      else if (f === 'T') card.style.display = \$('dnb-tube').checked ? '' : 'none';
      else card.style.display = '';
    }

    // A copy run outranks the picker. The whole point is a set of near
    // identical doors, so the next form has to come back as the door being
    // copied, not as whatever template happens to be selected behind it.
    if (cloneSource) applyTemplate(cloneSource, false);
    else if (templateFill) applyTemplate(templateFill, false);
    else seedAllFamilies();

    \$('dnb-submit').textContent = 'Create door';
    \$('dnb-submit').onclick = submit;
    \$('dnb-newRevBtn').style.display = 'none';
    \$('dnb-editActions').classList.remove('open');

    fetchNextNumber();
    refreshNumbers();
    refreshCopyBoxes();
    updatePreview();
    // Mid-copy the series and the grids are already right and the description
    // is the one thing that changes, so land there instead of at the top.
    if (cloneSource){
      updateCopyBanner();
      \$('dnb-desc').focus();
      \$('dnb-desc').select();
    } else {
      \$('dnb-series').focus();
    }
  }

  function reset(){ window.location.href = baseUrl(); }

  // ── init ────────────────────────────────────────────────────────────────
  function init(){
    root = \$('${WRAP}');
    if (!root) return;

    var letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', rh = '';
    for (var i=0;i<letters.length;i++){
      rh += '<option value="' + letters[i] + '">REV ' + letters[i] + '</option>';
    }
    \$('dnb-rev').innerHTML = rh;
    \$('dnb-class').innerHTML = optionsHtml(CLASSES,'id','name','— none —');
    \$('dnb-autoIssue').checked = AUTO_ISSUE_DEFAULT;
    \$('dnb-screen').checked = INCLUDE_SCREEN_DEFAULT;
    \$('dnb-tube').checked = INCLUDE_TUBE_DEFAULT;
    \$('dnb-submit').onclick = submit;
    setDefaultDate();

    \$('dnb-template').innerHTML = templateOptionsHtml();
    // No default means the picker sits on "— none —", which is option zero,
    // so there is nothing to assign.
    if (DEFAULT_TEMPLATE) \$('dnb-template').value = DEFAULT_TEMPLATE;
    else setHint('dnb-templateHint',
      'Blank form — pick a template to fill the grids.', '');
    if (!ALLOW_TEMPLATE_CREATION) \$('dnb-newTplBtn').style.display = 'none';
    if (INCLUDE_SCREEN_DEFAULT) \$('dnb-card-S').style.display = '';
    if (INCLUDE_TUBE_DEFAULT) \$('dnb-card-T').style.display = '';

    // The preselected template's payload rode down with the page, so the form
    // arrives filled rather than empty-then-populated.
    var boot = FILL_CACHE[\$('dnb-template').value];
    if (boot){ templateFill = boot; applyTemplate(boot, false); }
    else seedAllFamilies();

    if (NEXT_NUMBER){
      \$('dnb-number').value = NEXT_NUMBER;
      setHint('dnb-numberHint', 'Next free number', 'good');
    }

    renderRecent(false);
    refreshNumbers();
    refreshCopyBoxes();
    updatePreview();

    \$('dnb-template').addEventListener('change', onTemplateChange);
    \$('dnb-tplSeries').addEventListener('change', previewTemplateName);
    \$('dnb-series').addEventListener('change', onSeriesChange);
    \$('dnb-class').addEventListener('change', markClassManual);
    \$('dnb-rev').addEventListener('change', function(){ refreshNumbers(); updatePreview(); });
    \$('dnb-number').addEventListener('input', onNumberInput);
    \$('dnb-number').addEventListener('blur', checkNumber);
    \$('dnb-tubeNumber').addEventListener('input', checkTubeNumber);
    \$('dnb-desc').addEventListener('input', function(){
      // A textarea accepts Enter and pasted line breaks. This text is written
      // to four item records, so a newline must never survive the box.
      if (/[\\r\\n]/.test(this.value)){
        var pos = this.selectionStart;
        this.value = this.value.replace(/[\\r\\n]+/g, ' ');
        try { this.selectionStart = this.selectionEnd = Math.min(pos, this.value.length); }
        catch (e) { /* not focused */ }
      }
      autoGrowDesc();
      updatePreview();
    });

    // Arrow keys work the search dropdown whenever it is open. Enter loads a
    // door that exists; on a free number it advances to Description.
    \$('dnb-number').addEventListener('keydown', function(e){
      if (doorAcKey(e)) return;
      if (e.key !== 'Enter') return;
      e.preventDefault();
      if (mode === 'edit' || \$('dnb-doorAc').classList.contains('open')) loadDoor();
      else \$('dnb-desc').focus();
    });
    \$('dnb-desc').addEventListener('keydown', function(e){
      if (e.key === 'Enter'){
        e.preventDefault();
        var first = \$('dnb-comp-item-F0');
        if (first) first.focus();
      }
    });

    // Scoped to the wrapper — does not intercept clicks elsewhere in NetSuite.
    root.addEventListener('click', function(e){
      if (!e.target.closest('.ac-wrap')) closeAllAc();
    });

    // Mousedown inside a dropdown must not blur the field. preventDefault on
    // an .ac-item keeps focus on the input, so the click resolves against the
    // row actually under the cursor instead of racing the blur handler.
    // Scrollbar drags (target is the list, not an item) still work — they only
    // set the flag, which is enough to keep checkNumber out of the way.
    // Capture phase so it runs before NetSuite's own page scripts.
    root.addEventListener('mousedown', function(e){
      if (!e.target.closest('.ac-list')) return;
      acClicking = true;
      if (e.target.closest('.ac-item')) e.preventDefault();
    }, true);
    document.addEventListener('mouseup', function(){ acClicking = false; });

    // Manual Tab handling. Tabbing through a plain input normally selects
    // nothing, so the next keystroke lands after the existing "1" instead of
    // replacing it. Owning Tab ourselves means we focus AND select in the same
    // keystroke, with no gap for NetSuite's own page scripts to intervene.
    root.addEventListener('keydown', function(e){
      if (e.key !== 'Tab') return;

      var stops = Array.prototype.slice.call(root.querySelectorAll('.tabstop'))
        .filter(function(el){ return el.offsetParent !== null; });  // skip hidden rows
      var cur = stops.indexOf(document.activeElement);
      if (cur === -1) return;   // focus isn't on one of our stops

      var next = cur + (e.shiftKey ? -1 : 1);
      if (next < 0 || next >= stops.length) return;   // fall off our list

      e.preventDefault();
      e.stopPropagation();
      var el = stops[next];
      el.focus();
      if (typeof el.select === 'function' && el.tagName === 'INPUT' &&
          el.type !== 'hidden' && el.type !== 'checkbox') {
        el.select();
      }
    }, true);
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  return {
    addComponent: addComponent,
    addStep: addStep,
    removeRow: removeRow,
    acInput: acInput,
    acKey: acKey,
    acPick: acPick,
    markSourceManual: markSourceManual,
    onOpChange: onOpChange,
    opRevert: opRevert,
    doorAcPick: doorAcPick,
    loadDoor: loadDoor,
    startCopy: startCopy,
    refill: refill,
    copyFromPart: copyFromPart,
    openNewTemplate: openNewTemplate,
    closeNewTemplate: closeNewTemplate,
    previewTemplateName: previewTemplateName,
    submitTemplate: submitTemplate,
    toggleScreen: toggleScreen,
    toggleTube: toggleTube,
    clearForm: clearForm,
    clearRecent: clearRecent,
    submit: submit,
    submitNewRev: submitNewRev,
    reset: reset
  };
})();
</script>
</div>`;
  }

